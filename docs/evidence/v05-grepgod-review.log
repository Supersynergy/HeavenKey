... 178 function checkAPIChain(result,trustedIssuer) {
... 179   assert.equal(result.id,Buffer.from(referenceId(result.grant),"hex").toString("base64url"));
... 180   assert.equal(referenceId(result.grant),referenceId(result.chain.at(-1)));
