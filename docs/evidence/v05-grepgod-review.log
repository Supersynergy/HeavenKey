... 166 async function delegatedAssertion(a,grant,invocation=delegatedInvocation(grant)) {
... 167   const start=await post(a,"/api/auth/start",{name:a.name,delegation_invocation:invocation});assert.equal(start.status,200,JSON.stringify(start.body));
... 168   return {request_id:start.body.request_id,credential:await authentication(a,start.body.options),delegation_invocation:invocation};
... 169 }
... 170 async function uiDelegate(a,parent,recipient,ttl,budget) {
... 171   await a.page.locator("#refresh").click();
... 172   const form=a.page.locator(`.delegation[data-id="${parent.id}"] form`);await form.locator('[name="guest"]').fill(recipient);await form.locator('[name="ttl"]').fill(String(ttl));await form.locator('[name="budget"]').fill(String(budget));
... 173   const response=a.page.waitForResponse(r=>r.url().endsWith("/api/delegations/delegate"));await form.locator("button").click();
... 174   await a.page.locator("#management-dialog").waitFor({state:"visible"});const target=await a.page.locator("#management-target").innerText();
... 175   for(const expected of [`Empfänger: ${recipient}`,`Gültigkeit: ${ttl} Sekunden`,`Erlaubte Weitergaben: ${budget}`]) assert.ok(target.includes(expected));
... 176   await confirmUI(a,"Zugang weitergeben",parent.id);const r=await response;assert.equal(r.status(),200);return r.json();
