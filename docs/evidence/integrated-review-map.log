440 def check_port_consistency(root: Path, report: Report) -> None:
441     """Alle Upstream-/Bind-Referenzen muessen Port 18240 nutzen."""
442     found: dict[str, set[int]] = {}
443
444     def add(rel: str, port: int) -> None:
445         found.setdefault(rel, set()).add(port)
446
447     for rel in DEPLOY_FILES:
448         path = root / rel
449         if not path.exists():
450             continue
451         body = strip_comments(path.read_text(encoding="utf-8"))
452         # Upstream-Ziele (kein 'listen': das ist der oeffentliche TLS-Port).
453         for m in re.finditer(
454             r"(?:reverse_proxy|proxy_pass\s+http://|server\s+)"
455             r"(?:https?://)?(?:127\.0\.0\.1|localhost|\w+):(\d+)",
456             body,
457         ):
458             add(rel, int(m.group(1)))
459         for m in re.finditer(r"--port\s+(\d+)", body):
460             add(rel, int(m.group(1)))
461
462     doc = root / DOC_FILE
463     doc_ok = doc.exists() and str(API_UPSTREAM_PORT) in doc.read_text(
464         encoding="utf-8", errors="replace"
465     )
466     report.add(
467         "doc-mentions-port",
468         DOC_FILE,
469         doc_ok,
470         f"docs/OPERATIONS.md nennt Port {API_UPSTREAM_PORT}",
471     )
472
473     bad = {
474         rel: sorted(ports)
475         for rel, ports in found.items()
476         if ports != {API_UPSTREAM_PORT}
477     }
478     report.add(
479         "port-consistency",
480         "deploy/",
481         not bad,
482         f"alle Upstream-Referenzen auf Port {API_UPSTREAM_PORT}"
483         + (f" (abweichend: {bad})" if bad else ""),
484     )
485
