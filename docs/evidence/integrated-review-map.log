apps/extension/settings.js --- JavaScript
 1 export const destinations = new Set(["overview", "keys", "access", "recovery", "agents", "vault", "help"]);
 2 export function target(settings) {
 3   if (!destinations.has(settings.destination)) throw new Error("Unbekanntes Ziel.");
 4   let origin;
 5   if (settings.mode === "local") {
 6     if (!/^\d+$/.test(String(settings.port))) throw new Error("Port muss eine ganze Zahl sein.");
 7     const port = Number(settings.port);
 8     if (!Number.isInteger(port) || port < 1 || port > 65535) throw new Error("Port muss zwischen 1 und 65535 liegen.");
 9     origin = `http://localhost:${port}`;
10   } else if (settings.mode === "https") {
11     let parsed;
12     try { parsed = new URL(settings.endpoint); } catch { throw new Error("Bitte eine vollständige HTTPS-Adresse eingeben."); }
13     if (parsed.protocol !== "https:" || parsed.username || parsed.password || parsed.search || parsed.hash || parsed.pathname !== "/") throw new Error("Nur die HTTPS-Basisadresse ohne Pfad, Anmeldung oder Parameter eingeben.");
14     origin = parsed.origin;
15   } else throw new Error("Unbekannte Verbindung.");
16   return `${origin}/${settings.destination === "overview" ? "" : `#${settings.destination}`}`;
17 }
