  1 /** Software-authenticator integration checks. This does not replace browser/hardware acceptance. */
  2 import assert from "node:assert/strict";
  3 import { generateKeyPairSync, createHash, randomBytes, sign } from "node:crypto";
  4 import { spawn } from "node:child_process";
  5 import { mkdtemp, readFile, writeFile, mkdir, rm } from "node:fs/promises";
  6 import { join, resolve } from "node:path";
  7 import { tmpdir } from "node:os";
  8 import { Encoder } from "cbor-x";
  9 const cbor = new Encoder({ useRecords: false, mapsAsObjects: true });
 10 const encode = x => Buffer.from(x).toString("base64url");
 11 const hash = x => createHash("sha256").update(x).digest();
 12 const directory = await mkdtemp(join(tmpdir(), "heavenkey-protocol-"));
 13 const data = join(directory, "data"), protection = join(directory, "protection.key");
 14 await writeFile(protection, randomBytes(32), { mode: 0o600 });
 15 const origin = "http://localhost:18243", cases = []; let server;
 16 async function test(name, fn) { await fn(); cases.push({ name, pass: true }); console.log(`PASS ${name}`); }
 17 async function stop() {
 18   if (!server || server.exitCode !== null) return;
 19   const exited = new Promise(resolve => server.once("exit", resolve)); server.kill("SIGINT");
 20   const timer = setTimeout(() => server.kill("SIGKILL"), 3000);
 21   await exited; clearTimeout(timer);
 22 }
 23 async function start() {
 24   server = spawn(resolve(process.env.HEAVENKEY_BINARY || "target/debug/uac-api"), ["--port", "18243", "--data-dir", data], { env: { ...process.env, UAC_STORE_KEY: "0a".repeat(32), HEAVENKEY_KEY_FILE: protection, HEAVENKEY_ORIGIN: origin, HEAVENKEY_RP_ID: "localhost" }, stdio: ["ignore", "pipe", "pipe"] });
 25   let log = ""; server.stdout.on("data", x => log += x); server.stderr.on("data", x => log += x);
 26   for (let n = 0; n < 100; n++) {
 27     if (server.exitCode !== null) throw new Error(`Server failed: ${log}`);
 28     try { if ((await fetch(origin + "/health", { signal: AbortSignal.timeout(300) })).ok) return; } catch {}
 29     await new Promise(resolve => setTimeout(resolve, 50));
 30   } throw new Error("Server startup timeout");
 31 }
 32 async function request(path, body, session, requestOrigin = origin) {
 33   const response = await fetch(origin + path, { method: body === undefined ? "GET" : "POST", headers: { "Content-Type": "application/json", Origin: requestOrigin, ...(session ? { Authorization: `Bearer ${session}` } : {}) }, ...(body === undefined ? {} : { body: JSON.stringify(body) }), signal: AbortSignal.timeout(10000) });
 34   const value = await response.json(); return { status: response.status, value };
 35 }
 36 class Authenticator {
 37   constructor() { this.id = randomBytes(32); this.counter = 0; Object.assign(this, generateKeyPairSync("ec", { namedCurve: "prime256v1" })); }
 38   registration(options, clientOrigin = origin) {
 39     this.userHandle = options.user.id;
 40     const jwk = this.publicKey.export({ format: "jwk" });
 41     const cose = cbor.encode(new Map([[1, 2], [3, -7], [-1, 1], [-2, Buffer.from(jwk.x, "base64url")], [-3, Buffer.from(jwk.y, "base64url")]]));
 42     const length = Buffer.alloc(2); length.writeUInt16BE(this.id.length);
 43     const authData = Buffer.concat([hash(options.rp.id), Buffer.from([0x45]), Buffer.alloc(4), Buffer.alloc(16), length, this.id, cose]);
 44     return { id: encode(this.id), rawId: encode(this.id), type: "public-key", authenticatorAttachment: "platform", response: { clientDataJSON: encode(JSON.stringify({ type: "webauthn.create", challenge: options.challenge, origin: clientOrigin, crossOrigin: false })), attestationObject: encode(cbor.encode({ fmt: "none", attStmt: {}, authData })), transports: ["internal"] }, clientExtensionResults: {} };
 45   }
 46   assertion(options, clientOrigin = origin) {
 47     const counter = Buffer.alloc(4); counter.writeUInt32BE(++this.counter);
 48     const authData = Buffer.concat([hash(options.rpId), Buffer.from([0x05]), counter]);
 49     const client = Buffer.from(JSON.stringify({ type: "webauthn.get", challenge: options.challenge, origin: clientOrigin, crossOrigin: false }));
 50     return { id: encode(this.id), rawId: encode(this.id), type: "public-key", authenticatorAttachment: "platform", response: { clientDataJSON: encode(client), authenticatorData: encode(authData), signature: encode(sign("sha256", Buffer.concat([authData, hash(client)]), this.privateKey)), userHandle: this.userHandle }, clientExtensionResults: {} };
 51   }
 52 }
 53 async function register(name, authenticator, bootstrap_token) {
 54   const start = await request("/api/register/start", { name, bootstrap_token }); assert.equal(start.status, 200);
 55   const result = await request("/api/register/finish", { request_id: start.value.request_id, credential: authenticator.registration(start.value.options.publicKey) }); assert.equal(result.status, 200);
 56 }
 57 async function login(name, authenticator) {
 58   const start = await request("/api/auth/start", { name }); assert.equal(start.status, 200);
 59   const result = await request("/api/auth/finish", { request_id: start.value.request_id, credential: authenticator.assertion(start.value.options.publicKey) }); assert.equal(result.status, 200); return result.value;
 60 }
 61 async function approval(name, authenticator, session, management) {
 62   const start = await request("/api/auth/start", { name, management }, session); assert.equal(start.status, 200);
 63   const result = await request("/api/auth/finish", { request_id: start.value.request_id, credential: authenticator.assertion(start.value.options.publicKey), management }, session); assert.equal(result.status, 200); return result.value.approval_id;
 64 }
