494 fn add_context(doc: &mut Value, fixtures: &Fixtures) {
495     // Resolve names to concrete context data so consumers need no fixtures logic.
496     let grant_map: serde_json::Map<String, Value> = fixtures
497         .grants
498         .iter()
499         .map(|(n, g)| (n.clone(), serde_json::to_value(g).unwrap()))
500         .collect();
501     for case in doc["cases"].as_array_mut().unwrap() {
502         if let Some(names) = case.get("revoked_from").and_then(Value::as_array) {
503             let ids: Vec<Value> = names
504                 .iter()
505                 .map(|name| {
506                     let grant: Signed<Grant> =
507                         serde_json::from_value(grant_map[name.as_str().unwrap()].clone()).unwrap();
508                     json!(signed_id(&grant))
509                 })
510                 .collect();
511             case.as_object_mut().unwrap().remove("revoked_from");
512             case["revoked"] = json!(ids);
513         }
514         case["context"] = json!({
515             "resource": RESOURCE,
516             "action": "Read",
517             "arguments_hash": hex(&ARGS),
518             "nonce": hex(&NONCE),
519         });
520     }
521 }
