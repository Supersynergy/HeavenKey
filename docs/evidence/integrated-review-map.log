    532 });
    533 el<HTMLFormElement>("recovery-form").addEventListener("submit", event => {
    534   event.preventDefault(); void perform(el("recovery-submit"), async () => {
    535     const name = input("recovery-name"); const code = input("recovery-code"); el<HTMLInputElement>("recovery-code").value = "";
    536     const start = await api<Ceremony<PublicKeyCredentialCreationOptionsJSON>>("/api/recovery/start", { name, code, label: input("recovery-label") });
    537     const credential = await createCredential(start); await api("/api/recovery/finish", { request_id: start.request_id, credential });
    538     clearSession(); el<HTMLInputElement>("name").value = name;
    539     status("Konto wiederhergestellt. Melde dich mit dem neuen Passkey an und erstelle einen neuen Einmalcode.", false);
    540   });
    541 });
    542 void (async () => {
    543   try {
    544     const config = await api<{ origin: string; rp_id: string; keystore: string }>("/api/config");
    545     el("security-summary").textContent = `${config.origin} · Passkey-Domain: ${config.rp_id} · Signierschlüssel: ${config.keystore === "native-os-store" ? "Betriebssystem-Keystore" : "externe Schlüsseldatei"} · Lokaler Pilot`;
    546   } catch { el("security-summary").textContent = "HeavenKey-Verbindung nicht verfügbar. Prüfe, ob das Programm läuft."; }
    547   platformControls();
    548 })();

