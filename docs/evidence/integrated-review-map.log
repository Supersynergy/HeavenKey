scripts/revocation_snapshot.py --- Python
  1 """Export the delegation revocation set as a uac-gate snapshot file.
  2
  3 The gate (apps/gate) reads a JSON snapshot per request:
  4 {"version": 1, "generated_at": <unix seconds>, "revoked": ["<64-hex id>", ...]}.
  5
  6 This script produces that file from the local store. It either runs
  7 `uac-api --store-query` itself or consumes an existing --store-query output.
  8
  9 Usage:
 10     python3 scripts/revocation_snapshot.py --data data --out revocations.json
 11     python3 scripts/revocation_snapshot.py --store-query-json rows.json --out revocations.json
 12
 13 Environment: UAC_STORE_KEY / UAC_STORE_KEY_FILE apply to the store query
 14 exactly as for the API; UAC_API_BINARY overrides the binary path.
 15 """
 16 import json
 17 import os
 18 import subprocess
 19 import sys
 20 import tempfile
 21 import time
 22
 23 STORE_QUERY = {"sql": "SELECT id FROM delegations WHERE revoked=1", "params": []}
 24 MAX_ID_LENGTH = 64
 25 MAX_ENTRIES = 65536
 26
 27
 28 def query_ids(binary, data_dir):
 29     env = dict(os.environ)
 30     env["UAC_DATA"] = data_dir
 31     result = subprocess.run(
 32         [binary, "--store-query", json.dumps(STORE_QUERY)],
 33         capture_output=True,
 34         text=True,
 35         env=env,
 36         timeout=60,
 37     )
 38     if result.returncode != 0:
 39         raise SystemExit(f"store query failed: {result.stderr.strip() or result.stdout.strip()}")
 40     return parse_rows(result.stdout)
 41
 42
 43 def parse_rows(text):
 44     rows = json.loads(text)
 45     if not isinstance(rows, list):
 46         raise SystemExit("store query did not return a row array")
 47     revoked = []
 48     for row in rows:
 49         if not isinstance(row, list) or len(row) != 1:
 50             raise SystemExit("delegations.id query must return one column per row")
 51         value = row[0]
 52         if isinstance(value, dict) and "blob_base64" in value:
 53             import base64
 54             value = base64.b64decode(value["blob_base64"]).hex()
 55         if not isinstance(value, str):
 56             raise SystemExit("delegations.id must be text or a single blob column")
 57         candidate = value.strip().lower()
 58         if len(candidate) != MAX_ID_LENGTH or any(c not in "0123456789abcdef" for c in candidate):
 59             raise SystemExit(f"delegations.id is not a 64-hex grant id: {value!r}")
 60         revoked.append(candidate)
 61     if len(revoked) > MAX_ENTRIES:
 62         raise SystemExit("revocation snapshot exceeds entry limit")
 63     return sorted(set(revoked))
 64
 65
 66 def write_snapshot(path, revoked, generated_at):
 67     snapshot = {"version": 1, "generated_at": generated_at, "revoked": revoked}
 68     directory = os.path.dirname(os.path.abspath(path)) or "."
 69     os.makedirs(directory, exist_ok=True)
 70     handle, tmp = tempfile.mkstemp(dir=directory, prefix=".revocations-", suffix=".tmp")
 71     try:
 72         with os.fdopen(handle, "w") as stream:
 73             json.dump(snapshot, stream, indent=1, sort_keys=True)
 74             stream.write("\n")
 75         os.replace(tmp, path)
 76     except BaseException:
 77         os.unlink(tmp)
 78         raise
 79
 80
 81 def main(argv):
 82     args = {"--out": None, "--data": "data", "--store-query-json": None, "--binary": None}
 83     index = 0
 84     while index < len(argv):
 85         flag = argv[index]
 86         if flag not in args or index + 1 >= len(argv):
 87             raise SystemExit(f"unknown or incomplete flag: {flag}")
 88         args[flag] = argv[index + 1]
 89         index += 2
 90     if args["--out"] is None:
 91         raise SystemExit("--out PATH is required")
 92     if args["--store-query-json"]:
 93         with open(args["--store-query-json"], encoding="utf-8") as stream:
 94             revoked = parse_rows(stream.read())
 95     else:
 96         binary = args["--binary"] or os.environ.get("UAC_API_BINARY", "uac-api")
 97         revoked = query_ids(binary, args["--data"])
 98     write_snapshot(args["--out"], revoked, int(time.time()))
 99     print(json.dumps({"revocations": len(revoked), "out": args["--out"]}))
100
101
102 if __name__ == "__main__":
103     main(sys.argv[1:])
104

