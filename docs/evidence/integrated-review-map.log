436     #[test]
437     fn key_dir_prefers_xdg_config() {
438         let root = PathBuf::from("/cfg");
439         let lookup = |name: &str| match name {
440             "XDG_CONFIG_HOME" => Some(root.join("xdg").into_os_string()),
441             "HOME" => Some(root.join("home").into_os_string()),
442             _ => None,
443         };
444         assert_eq!(
445             key_dir("linux", lookup).unwrap(),
446             root.join("xdg/heavenkey")
447         );
448         let home_only = |name: &str| match name {
449             "HOME" => Some(root.join("home").into_os_string()),
450             _ => None,
451         };
452         assert_eq!(
453             key_dir("linux", home_only).unwrap(),
454             root.join("home/.config/heavenkey")
455         );
456     }
