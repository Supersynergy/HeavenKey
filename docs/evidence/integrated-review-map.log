364         let dir = temp_dir("issuer");
365         fs::write(dir.join("issuer.key"), [5; 32]).unwrap();
366         let store = open_with_key(&dir, &test_key(1)).unwrap();
367         assert!(!dir.join("issuer.key").exists());
368         assert_eq!(store.issuer.to_bytes(), [5; 32]);
369         let stored: Vec<u8> = store
