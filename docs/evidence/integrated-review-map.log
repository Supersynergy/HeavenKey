   1 //! Local pilot features. All authorization is checked again at execution time.
   2 use super::*;
   3 use ed25519_dalek::{Signature, Signer, VerifyingKey};
   4 use std::collections::BTreeMap;
   5
   6 #[derive(Default)]
   7 pub(super) struct Platform {
   8     recoveries: HashMap<String, RecoveryRegistration>,
   9     invocations: HashMap<String, AgentChallenge>,
  10     recovery_attempts: HashMap<String, (u8, Instant)>,
  11 }
  12 struct RecoveryRegistration {
  13     user_id: String,
  14     digest: String,
  15     label: String,
  16     state: PasskeyRegistration,
  17     expires: Instant,
  18 }
  19 struct AgentChallenge {
  20     invocation: AgentInvocation,
  21     message: Vec<u8>,
  22     expires: Instant,
  23 }
  24 impl Platform {
  25     pub fn prune(&mut self) {
  26         let instant = Instant::now();
  27         self.recoveries.retain(|_, x| x.expires > instant);
  28         self.invocations.retain(|_, x| x.expires > instant);
  29         self.recovery_attempts.retain(|_, x| x.1 > instant);
  30     }
  31 }
  32
  33 pub(super) fn initialize(db: &Connection) -> rusqlite::Result<()> {
  34     db.execute_batch(
  35         "CREATE TABLE IF NOT EXISTS platform_metadata(key TEXT PRIMARY KEY,value TEXT NOT NULL);
  36          CREATE TABLE IF NOT EXISTS recovery_codes(account_id TEXT PRIMARY KEY REFERENCES users(id),digest TEXT NOT NULL,used INTEGER NOT NULL DEFAULT 0,created INTEGER NOT NULL);
  37          CREATE TABLE IF NOT EXISTS agent_tasks(id TEXT PRIMARY KEY,account_id TEXT NOT NULL REFERENCES users(id),credential_id TEXT NOT NULL REFERENCES credentials(id),token TEXT NOT NULL,revoked INTEGER NOT NULL DEFAULT 0,created INTEGER NOT NULL,expires_at INTEGER NOT NULL);
  38          CREATE INDEX IF NOT EXISTS agent_tasks_account ON agent_tasks(account_id);
  39          CREATE TABLE IF NOT EXISTS agent_operations(id TEXT PRIMARY KEY,task_id TEXT NOT NULL REFERENCES agent_tasks(id),account_id TEXT NOT NULL REFERENCES users(id),created INTEGER NOT NULL);
  40          CREATE TABLE IF NOT EXISTS crm_contacts(account_id TEXT NOT NULL REFERENCES users(id),id TEXT NOT NULL,name TEXT NOT NULL,note TEXT NOT NULL,PRIMARY KEY(account_id,id));
  41          CREATE TABLE IF NOT EXISTS vaults(account_id TEXT PRIMARY KEY REFERENCES users(id),revision INTEGER NOT NULL,record TEXT NOT NULL);
  42          CREATE TABLE IF NOT EXISTS audit_events(id TEXT PRIMARY KEY,account_id TEXT NOT NULL REFERENCES users(id),event TEXT NOT NULL,reference TEXT NOT NULL,created INTEGER NOT NULL);
  43          CREATE INDEX IF NOT EXISTS audit_account ON audit_events(account_id,created);"
  44     )
  45 }
  46
  47 pub(super) fn identity(origin: &str, rp_id: &str) -> Result<Url, Box<dyn std::error::Error>> {
  48     let parsed = Url::parse(origin)?;
  49     let host = parsed.domain().ok_or("origin requires a DNS hostname")?;
  50     if !parsed.username().is_empty()
  51         || parsed.password().is_some()
  52         || parsed.query().is_some()
  53         || parsed.fragment().is_some()
  54         || parsed.path() != "/"
  55         || !(host == rp_id || host.ends_with(&format!(".{rp_id}")))
  56         || !(parsed.scheme() == "https"
  57             || parsed.scheme() == "http" && host == "localhost" && rp_id == "localhost")
  58         || rp_id.is_empty()
  59         || rp_id.contains(['/', ':', '@'])
  60     {
  61         return Err("invalid WebAuthn origin/RP ID; remote origins require HTTPS".into());
  62     }
  63     Ok(parsed)
  64 }
  65 pub(super) fn pin_identity(db: &Connection, rp_id: &str) -> Result<(), Box<dyn std::error::Error>> {
  66     let pinned: Option<String> = db
  67         .query_row(
  68             "SELECT value FROM platform_metadata WHERE key='rp_id'",
  69             [],
  70             |r| r.get(0),
  71         )
  72         .optional()?;
  73     match pinned {
  74         Some(pinned) if pinned != rp_id => return Err("RP ID differs from this data directory; provision new credentials in a separate directory".into()),
  75         Some(_) => {},
  76         None => {
  77             let users: i64 = db.query_row("SELECT count(*) FROM users", [], |r| r.get(0))?;
  78             if users > 0 && rp_id != "localhost" { return Err("existing localhost credentials cannot migrate to a different RP ID".into()); }
  79             db.execute("INSERT INTO platform_metadata(key,value) VALUES('rp_id',?1)", [rp_id])?;
  80         }
  81     }
  82     Ok(())
  83 }
  84 fn db_time(value: u64) -> ApiResult<i64> {
  85     i64::try_from(value).map_err(|_| forbidden("time_out_of_range"))
  86 }
  87 fn audit(db: &Connection, account: &str, event: &str, reference: &str) -> ApiResult<()> {
  88     db.execute(
  89         "INSERT INTO audit_events(id,account_id,event,reference,created) VALUES(?1,?2,?3,?4,?5)",
  90         params![
  91             Uuid::new_v4().to_string(),
  92             account,
  93             event,
  94             reference,
  95             db_time(now())?
  96         ],
  97     )
  98     .map_err(internal)?;
  99     Ok(())
 100 }
 101 fn invalidate_account(inner: &mut Inner, account: &str) {
 102     inner.sessions.retain(|_, s| s.user_id != account);
 103     inner.approvals.retain(|_, s| s.user_id != account);
 104     inner.enrollments.retain(|_, s| s.user_id != account);
 105     inner.authentications.retain(|_, s| s.user.id != account);
 106     inner
 107         .platform
 108         .recoveries
 109         .retain(|_, s| s.user_id != account);
 110 }
