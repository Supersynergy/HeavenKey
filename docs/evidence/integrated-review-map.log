 41 fn grant(
 42     issuer: &SigningKey,
 43     audience: [u8; 32],
 44     actions: &[Action],
 45     not_before: u64,
 46     expires_at: u64,
 47     remaining_delegations: u8,
 48     parent: Option<[u8; 32]>,
 49 ) -> Signed<Grant> {
 50     sign_grant(
 51         issuer,
 52         Grant {
 53             issuer: public(issuer),
 54             audience,
 55             resource: RESOURCE.into(),
 56             actions: actions.iter().copied().collect(),
 57             not_before,
 58             expires_at,
 59             remaining_delegations,
 60             parent,
 61         },
 62     )
 63     .unwrap()
 64 }
 65
 66 fn invocation(
 67     signer: &SigningKey,
 68     grant: [u8; 32],
 69     resource: &str,
 70     action: Action,
 71     arguments_hash: [u8; 32],
 72     nonce: [u8; 32],
 73     issued_at: u64,
 74 ) -> Signed<Invocation> {
 75     sign_invocation(
 76         signer,
 77         Invocation {
 78             grant,
 79             resource: resource.into(),
 80             action,
 81             arguments_hash,
 82             nonce,
 83             issued_at,
 84         },
 85     )
 86     .unwrap()
 87 }
 88
 89 fn body_message(domain: &[u8], body: &impl serde::Serialize) -> String {
 90     let mut bytes = domain.to_vec();
 91     bytes.extend(serde_json::to_vec(body).unwrap());
 92     hex(&bytes)
 93 }
 94
 95 fn signed_id(signed: &Signed<Grant>) -> String {
 96     hex(&grant_id(signed).unwrap())
 97 }
