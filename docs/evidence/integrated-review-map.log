 552 pub(super) async fn agent_revoke(
 553     State(app): State<App>,
 554     headers: HeaderMap,
 555     Json(input): Json<AgentRevoke>,
 556 ) -> ApiResult<Json<Value>> {
 557     let mut inner = app.inner.lock().map_err(internal)?;
 558     let approval = inner.take_approval(input.approval_id.as_deref());
 559     let user = inner.session_user(&headers)?;
 560     inner.require_approval(
 561         &headers,
 562         &user,
 563         input.approval_id.as_deref(),
 564         approval,
 565         &Management::AgentRevoke {
 566             id: input.id.clone(),
 567         },
 568     )?;
 569     management_allowed(
 570         &inner,
 571         &user,
 572         &Management::AgentRevoke {
