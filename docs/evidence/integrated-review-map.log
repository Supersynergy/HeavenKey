369 def check_environment(root: Path, report: Report) -> None:
370     rel = "deploy/systemd/api.env.example"
371     path = root / rel
372     values = {}
373     valid = path.is_file()
374     if valid:
375         for line in strip_comments(path.read_text(encoding="utf-8")).splitlines():
376             if not line.strip():
377                 continue
378             match = re.fullmatch(r"([A-Z][A-Z0-9_]*)=(.*)", line)
379             try:
380                 parts = shlex.split(match.group(2)) if match else []
381             except ValueError:
382                 parts = []
383             if not match or len(parts) != 1 or match.group(1) in values:
384                 valid = False
385                 continue
386             values[match.group(1)] = parts[0]
387     report.add("api-env-format", rel, valid, "eindeutige EnvironmentFile-Zuweisungen")
388     origin = values.get("HEAVENKEY_PUBLIC_ORIGIN", "")
389     try:
390         url = urlsplit(origin)
391         alias = urlsplit(values.get("HEAVENKEY_ORIGIN", origin))
392         try:
393             ipaddress.ip_address(url.hostname or "")
394             dns = False
395         except ValueError:
396             dns = bool(url.hostname and "." in url.hostname)
397         identity = (url.scheme == "https" and bool(url.hostname)
398                     and dns and not url.username and not url.password
399                     and not url.query and not url.fragment and url.path in {"", "/"}
400                     and values.get("HEAVENKEY_RP_ID") == url.hostname
401                     and (alias.scheme, alias.hostname, alias.port or 443)
402                     == (url.scheme, url.hostname, url.port or 443)
403                     and not alias.username and not alias.password
404                     and not alias.query and not alias.fragment and alias.path in {"", "/"})
405         _ = url.port  # Reject malformed ports even when the host is valid.
406     except ValueError:
407         identity = False
408     report.add("api-env-identity", rel, identity,
409                "HTTPS-Domain, gleiche RP-ID, kein konkurrierender Origin-Override")
410     key = Path(values.get("HEAVENKEY_KEY_FILE", ""))
411     store_key = Path(values.get("UAC_STORE_KEY_FILE", ""))
412     document = Path(values.get("HEAVENKEY_DOCUMENT", ""))
413     private = (all(path.is_absolute() and ".." not in path.parts and len(path.parts) > 2
414                    for path in [key, store_key, document])
415                and all(not path.is_relative_to("/var/lib/heavenkey") for path in [key, store_key])
416                and len({key, store_key, document}) == 3
417                and "UAC_STORE_KEY" not in values)
418     report.add("api-env-private-files", rel, private,
419                "getrennte absolute Dokument-/Schluesselpfade; beide Schluessel ausserhalb data/")
420
