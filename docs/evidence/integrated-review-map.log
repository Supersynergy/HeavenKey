apps/api/src/hosting.rs --- Rust
  1 use std::{fs, io::Read, path::Path};
  2 use webauthn_rs::prelude::Url;
  3
  4 pub struct Hosting {
  5     pub origin: String,
  6     pub host: String,
  7     pub rp_id: String,
  8 }
  9
 10 impl Hosting {
 11     pub fn new(port: u16, public: Option<&str>) -> Result<Self, Box<dyn std::error::Error>> {
 12         let Some(public) = public else {
 13             return Ok(Self {
 14                 origin: format!("http://localhost:{port}"),
 15                 host: format!("localhost:{port}"),
 16                 rp_id: "localhost".into(),
 17             });
 18         };
 19         let url = Url::parse(public)?;
 20         if url.scheme() != "https"
 21             || !url.username().is_empty()
 22             || url.password().is_some()
 23             || url.query().is_some()
 24             || url.fragment().is_some()
 25             || url.path() != "/"
 26             || url.domain().is_none()
 27         {
 28             return Err("HEAVENKEY_PUBLIC_ORIGIN must be an HTTPS domain origin without a path, credentials, query or fragment".into());
 29         }
 30         let rp_id = url.host_str().ok_or("missing HTTPS domain")?.to_string();
 31         if rp_id == "localhost" || !rp_id.contains('.') {
 32             return Err("public HTTPS origin requires a DNS domain".into());
 33         }
 34         let origin = url.origin().ascii_serialization();
 35         let host = origin
 36             .strip_prefix("https://")
 37             .ok_or("invalid origin")?
 38             .to_string();
 39         Ok(Self {
 40             origin,
 41             host,
 42             rp_id,
 43         })
 44     }
 45 }
 46
 47 pub fn document(path: Option<&Path>, public: bool) -> Result<String, Box<dyn std::error::Error>> {
 48     let Some(path) = path else {
 49         if public {
 50             return Err("HTTPS hosting requires HEAVENKEY_DOCUMENT, a private UTF-8 file outside the web root".into());
 51         }
 52         return Ok("HeavenKey example document — verified access".into());
 53     };
 54     let mut text = String::new();
 55     fs::File::open(path)?
 56         .take(65537)
 57         .read_to_string(&mut text)?;
 58     if text.is_empty() || text.len() > 65536 {
 59         return Err("protected document must contain 1 to 65536 UTF-8 bytes".into());
 60     }
 61     Ok(text)
 62 }
 63
 64 #[cfg(test)]
 65 mod tests {
 66     use super::*;
 67
 68     #[test]
 69     fn local_default_is_preserved() {
 70         let config = Hosting::new(18240, None).unwrap();
 71         assert_eq!(config.origin, "http://localhost:18240");
 72         assert_eq!(config.host, "localhost:18240");
 73         assert_eq!(config.rp_id, "localhost");
 74     }
 75
 76     #[test]
 77     fn public_origin_binds_host_and_rp_exactly() {
 78         let config = Hosting::new(18240, Some("https://heaven.example:8443/")).unwrap();
 79         assert_eq!(config.origin, "https://heaven.example:8443");
 80         assert_eq!(config.host, "heaven.example:8443");
 81         assert_eq!(config.rp_id, "heaven.example");
 82     }
 83
 84     #[test]
 85     fn insecure_or_ambiguous_public_origins_are_rejected() {
 86         for origin in [
 87             "http://heaven.example",
 88             "https://127.0.0.1",
 89             "https://localhost",
 90             "https://heaven.example/document",
 91             "https://user@heaven.example",
 92             "https://heaven.example?x=1",
 93             "https://heaven.example#x",
 94         ] {
 95             assert!(Hosting::new(18240, Some(origin)).is_err(), "{origin}");
 96         }
 97     }
 98
 99     #[test]
100     fn public_mode_requires_private_document() {
101         assert!(document(None, true).is_err());
102         assert!(document(None, false).is_ok());
103     }
104 }
