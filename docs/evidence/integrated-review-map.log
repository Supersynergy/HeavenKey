304
305     fn temp_dir(name: &str) -> PathBuf {
306         let dir =
307             std::env::temp_dir().join(format!("heavenkey-store-{name}-{}", std::process::id()));
308         let _ = fs::remove_dir_all(&dir);
309         fs::create_dir_all(&dir).unwrap();
310         dir
311     }
