 1 import base64
 2 import importlib.util
 3 import json
 4 import os
 5 import tempfile
 6 import unittest
 7 from pathlib import Path
 8
 9 SPEC = importlib.util.spec_from_file_location(
10     "revocation_snapshot", Path(__file__).with_name("revocation_snapshot.py")
11 )
12 MODULE = importlib.util.module_from_spec(SPEC)
13 SPEC.loader.exec_module(MODULE)
14
15 HEX_A = "ab" * 32
16 HEX_B = "cd" * 32
17
18
19 class ParseRowsTest(unittest.TestCase):
20     def test_text_ids(self):
21         revoked = MODULE.parse_rows(json.dumps([[HEX_A], [HEX_B]]))
22         self.assertEqual(revoked, sorted([HEX_A, HEX_B]))
23
24     def test_dedup_and_sort(self):
25         revoked = MODULE.parse_rows(json.dumps([[HEX_B], [HEX_A], [HEX_B]]))
26         self.assertEqual(revoked, [HEX_A, HEX_B])
27
28     def test_blob_id_decoded(self):
29         blob = base64.b64encode(bytes.fromhex(HEX_A)).decode()
30         revoked = MODULE.parse_rows(json.dumps([[{"blob_base64": blob}]]))
31         self.assertEqual(revoked, [HEX_A])
32
33     def test_rejects_bad_id(self):
34         with self.assertRaises(SystemExit):
35             MODULE.parse_rows(json.dumps([["not-hex"]]))
36
37     def test_rejects_non_list_rows(self):
38         with self.assertRaises(SystemExit):
39             MODULE.parse_rows('{"rows": []}')
40
41     def test_rejects_wide_row(self):
42         with self.assertRaises(SystemExit):
43             MODULE.parse_rows(json.dumps([[HEX_A, "extra"]]))
44
45
46 class WriteSnapshotTest(unittest.TestCase):
47     def test_envelope_shape_and_atomic_write(self):
48         with tempfile.TemporaryDirectory() as tmp:
49             out = Path(tmp) / "sub" / "revocations.json"
50             MODULE.write_snapshot(str(out), [HEX_A], 1700000000)
51             data = json.loads(out.read_text())
52             self.assertEqual(data, {"version": 1, "generated_at": 1700000000, "revoked": [HEX_A]})
53             self.assertEqual([p for p in Path(tmp).rglob("*") if p.is_file()], [out])
54
55
56 if __name__ == "__main__":
57     unittest.main()
