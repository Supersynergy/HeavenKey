scripts/ops_check.py --- Python
  1 #!/usr/bin/env python3
  2 """Statische Pruefung der HeavenKey-Betriebskonfiguration (deploy/).
  3
  4 Prueft ohne installierte nginx-/caddy-Binaeren:
  5 - Pflicht-Direktiven in deploy/caddy/Caddyfile und deploy/nginx/nginx.conf
  6   (TLS >= 1.2, keine schwachen Cipher, Upstream 127.0.0.1:18240,
  7   unveraenderte Host/Origin, statische Health-Route, begrenzte Timeouts,
  8   Body-Limit >= 32 KiB,
  9   HSTS).
 10 - Haertungs-Defaults in deploy/systemd/*.service (NoNewPrivileges,
 11   ProtectSystem, PrivateTmp, StateDirectory, Restart, nicht-root User).
 12 - Keine Klartext-Secrets in deploy/ (Private-Key-Bloecke, Token/Passwort-
 13   Zuweisungen).
 14 - Konsistenter Upstream-Port 18240 ueber alle Configs und docs/OPERATIONS.md.
 15 - Oeffentliche HTTPS-Identitaet und externe Headless-Schluesseldatei.
 16
 17 Exit-Code 0 = alles ok, 1 = mindestens ein Fehler, 2 = Aufruffehler.
 18 Ausgabe: menschenlesbare Zeilen plus optionalem JSON-Report (--json),
 19 z. B. fuer docs/evidence/ops-check.json. Siehe docs/OPERATIONS.md.
 20 """
 21
 22 from __future__ import annotations
 23
 24 import argparse
 25 import ipaddress
 26 import json
 27 import re
 28 import shlex
 29 import sys
 30 from pathlib import Path
 31 from urllib.parse import urlsplit
 32
 33 API_UPSTREAM_PORT = 18240
 34 MIN_BODY_BYTES = 32 * 1024  # DefaultBodyLimit::max(32 * 1024) in apps/api
 35
 36 DEPLOY_FILES = [
 37     "deploy/caddy/Caddyfile",
 38     "deploy/nginx/nginx.conf",
 39     "deploy/systemd/uac-api.service",
 40     "deploy/systemd/uac-gate.service",
 41     "deploy/systemd/api.env.example",
 42 ]
 43 DOC_FILE = "docs/OPERATIONS.md"
 44
 45 # Cipher-/Schluesselwoerter, die nicht vorkommen duerfen (TLS < 1.3-Niveau).
 46 WEAK_TOKENS = re.compile(
 47     r"\b(RC4|3DES|DES-CBC|DES\b|NULL|aNULL|eNULL|EXPORT|EXP|MD5|ADH|DSS|"
 48     r"SEED|IDEA|CAMELLIA|SHA1)\b"
 49 )
 50
 51 # Klartext-Secret-Muster fuer deploy/*: Private-Key-Bloecke und
 52 # "name = wert"-Zuweisungen typischer Secret-Namen mit langem Wert.
 53 SECRET_PATTERNS = [
 54     re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----"),
 55     re.compile(
 56         r"(?i)\b(api[_-]?key|secret|password|passwd|token|privkey|"
 57         r"private[_-]?key|issuer[_-]?key|UAC_STORE_KEY)\s*[:=]\s*"
 58         r"['\"]?[A-Za-z0-9+/_.=-]{12,}"
 59     ),
 60 ]
 61
 62
 63 class Report:
 64     def __init__(self) -> None:
 65         self.checks: list[dict] = []
 66
 67     def add(self, check_id: str, path: str, ok: bool, detail: str) -> None:
 68         self.checks.append(
 69             {
 70                 "check": check_id,
 71                 "file": path,
 72                 "status": "pass" if ok else "fail",
 73                 "detail": detail,
 74             }
 75         )
 76         print(f"{'PASS' if ok else 'FAIL'} {check_id:28} {path}: {detail}")
 77
 78     @property
 79     def ok(self) -> bool:
 80         return all(c["status"] == "pass" for c in self.checks)
 81
 82     def to_json(self) -> dict:
 83         failed = [c for c in self.checks if c["status"] == "fail"]
 84         return {
 85             "tool": "ops_check",
 86             "scope": "deploy/ + docs/OPERATIONS.md",
 87             "ok": self.ok,
 88             "total": len(self.checks),
 89             "failed": len(failed),
 90             "checks": self.checks,
 91         }
 92
 93
 94 def strip_comments(text: str) -> str:
 95     """Entfernt #-Kommentare bis Zeilenende (ausreichend fuer unsere Dateien)."""
 96     out_lines = []
 97     for line in text.splitlines():
 98         # '#' am Zeilenanfang oder nach Whitespace beginnt einen Kommentar.
 99         out_lines.append(re.sub(r"(?<!['\"#])(?<!\S)#.*$", "", line))
100     return "\n".join(out_lines)
101
102
103 def parse_size(raw: str) -> int | None:
104     """Parst Groessenangaben wie 64k, 64KB, 64KiB, 32M, 1048576 in Bytes."""
105     m = re.fullmatch(r"\s*(\d+)\s*([A-Za-z]*)", raw)
106     if not m:
107         return None
108     value, unit = int(m.group(1)), m.group(2).lower()
109     factors = {
110         "": 1,
111         "b": 1,
112         "k": 1024,
113         "kb": 1000,
114         "kib": 1024,
115         "m": 1024**2,
116         "mb": 10**6,
117         "mib": 1024**2,
118         "g": 1024**3,
119         "gb": 10**9,
120         "gib": 1024**3,
121     }
122     if unit not in factors:
123         return None
124     return value * factors[unit]
125
126
127 def bounded_timeouts(body: str, names: list[str]) -> bool:
128     """Reject missing, disabled or over-two-minute template timeouts."""
129     for name in names:
130         values = re.findall(rf"(?m)^\s*{re.escape(name)}\s+([^\s;}}]+)", body)
131         if not values:
132             return False
133         for value in values:
134             match = re.fullmatch(r"(\d+(?:\.\d+)?)(ms|s|m)", value)
135             if not match:
136                 return False
137             seconds = float(match.group(1)) * {"ms": 0.001, "s": 1, "m": 60}[match.group(2)]
138             if not 0 < seconds <= 120:
139                 return False
140     return True
141
142
143 def check_caddy(text: str, rel: str, report: Report) -> None:
144     body = strip_comments(text)
145
146     def has(pattern: str) -> bool:
147         return re.search(pattern, body) is not None
148
149     report.add("caddy-tls", rel, has(r"(?m)^\s*tls\b"), "tls-Direktive vorhanden")
150     proto = re.search(r"protocols\s+([^\n}]+)", body)
151     proto_ok = bool(
152         proto
153         and "tls1.2" in proto.group(1)
154         and "tls1.3" in proto.group(1)
155         and not re.search(r"tls1\.[01]\b|tls1\b(?!\.[23])|ssl3", proto.group(1))
156     )
157     report.add(
158         "caddy-tls-versions",
159         rel,
160         proto_ok,
161         "protocols auf tls1.2/tls1.3 begrenzt",
162     )
163     ciphers = re.search(r"(?m)^\s*ciphers\s+([^\n}]+)", body)
164     weak = WEAK_TOKENS.search(ciphers.group(1)) if ciphers else None
165     report.add(
166         "caddy-ciphers",
167         rel,
168         ciphers is not None and weak is None,
169         "keine schwachen TLS1.2-Cipher",
170     )
171     report.add(
172         "caddy-upstream",
173         rel,
174         has(rf"reverse_proxy\s+(?:https?://)?(?:127\.0\.0\.1|localhost):{API_UPSTREAM_PORT}\b"),
175         f"reverse_proxy -> 127.0.0.1:{API_UPSTREAM_PORT}",
176     )
177     report.add(
178         "caddy-public-identity",
179         rel,
180         not has(r"(?im)^\s*header_up\s+[+\-]?(?:Host|Origin)\b"),
181         "Host und Origin unveraendert (Caddy-Default)",
182     )
183     report.add(
184         "caddy-health",
185         rel,
186         has(r"respond\s+/healthz\b") and has(r"respond\s+/healthz[^\n]*\b200\b"),
187         "statische Health-Route /healthz -> 200",
188     )
189     size = re.search(r"max_size\s+([^\n}\s]+)", body)
190     parsed = parse_size(size.group(1)) if size else None
191     report.add(
192         "caddy-body-limit",
193         rel,
194         parsed is not None and parsed >= MIN_BODY_BYTES,
195         f"request_body max_size >= {MIN_BODY_BYTES} Bytes (API: 32 KiB)",
196     )
197     report.add(
198         "caddy-hsts",
199         rel,
200         has(r"Strict-Transport-Security"),
201         "HSTS-Header dokumentiert/gesetzt",
202     )
203     report.add(
204         "caddy-timeouts",
205         rel,
206         bounded_timeouts(body, ["dial_timeout", "response_header_timeout", "read_timeout", "write_timeout"]),
207         "alle Upstream-Timeouts > 0 und <= 120s",
208     )
209
210
211 def check_nginx(text: str, rel: str, report: Report) -> None:
212     body = strip_comments(text)
213
214     def has(pattern: str) -> bool:
215         return re.search(pattern, body) is not None
216
217     report.add(
218         "nginx-listen-tls",
219         rel,
220         has(r"listen\s+[^\n;]*443[^\n;]*\bssl\b"),
221         "listen 443 ssl konfiguriert",
222     )
223     proto = re.search(r"ssl_protocols\s+([^;]+);", body)
224     proto_val = proto.group(1) if proto else ""
225     proto_ok = bool(
226         proto
227         and re.search(r"\bTLSv1\.2\b", proto_val)
228         and re.search(r"\bTLSv1\.3\b", proto_val)
229         and not re.search(
230             r"\b(TLSv1\.0|TLSv1\.1|SSLv2|SSLv3)\b|\bTLSv1\b(?!\.)", proto_val
231         )
232     )
233     report.add(
234         "nginx-tls-versions",
235         rel,
236         proto_ok,
237         "ssl_protocols auf TLSv1.2/TLSv1.3 begrenzt",
238     )
239     ciphers = re.search(r"ssl_ciphers\s+['\"]?([^;'\"\n]+)", body)
240     weak = WEAK_TOKENS.search(ciphers.group(1)) if ciphers else None
241     report.add(
242         "nginx-ciphers",
243         rel,
244         ciphers is not None and weak is None,
245         "keine schwachen TLSv1.2-Cipher",
246     )
247     report.add(
248         "nginx-cert",
249         rel,
250         has(r"ssl_certificate\s+\S+;") and has(r"ssl_certificate_key\s+\S+;"),
251         "Zertifikat und Schluessel-Pfad gesetzt",
252     )
253     upstream = has(
254         rf"proxy_pass\s+http://(?:127\.0\.0\.1|localhost):{API_UPSTREAM_PORT}\b"
255     ) or (
256         has(r"upstream\s+\w+\s*{")
257         and has(rf"server\s+127\.0\.0\.1:{API_UPSTREAM_PORT}\s*;")
258         and has(r"proxy_pass\s+http://\w+\s*;")
259     )
260     report.add(
261         "nginx-upstream",
262         rel,
263         upstream,
264         f"proxy_pass/upstream -> 127.0.0.1:{API_UPSTREAM_PORT}",
265     )
266     report.add(
267         "nginx-public-identity",
268         rel,
269         re.findall(r"(?im)^\s*proxy_set_header\s+Host\s+([^;]+);", body) == ["$http_host"]
270         and not has(r"(?im)^\s*proxy_set_header\s+Origin\b"),
271         "Host=$http_host und Origin unveraendert",
272     )
273     report.add(
274         "nginx-health",
275         rel,
276         has(r"location\s*=\s*/healthz") and has(r"return\s+200\b"),
277         "statische Health-Route /healthz -> 200",
278     )
279     size = re.search(r"client_max_body_size\s+([^\s;]+)\s*;", body)
280     parsed = parse_size(size.group(1)) if size else None
281     report.add(
282         "nginx-body-limit",
283         rel,
284         parsed is not None and parsed >= MIN_BODY_BYTES,
285         f"client_max_body_size >= {MIN_BODY_BYTES} Bytes (API: 32 KiB)",
286     )
287     report.add(
288         "nginx-hsts",
289         rel,
290         has(r"add_header\s+Strict-Transport-Security"),
291         "HSTS-Header dokumentiert/gesetzt",
292     )
293     report.add(
294         "nginx-timeouts",
295         rel,
296         bounded_timeouts(body, ["proxy_connect_timeout", "proxy_read_timeout", "proxy_send_timeout", "client_header_timeout", "client_body_timeout"]),
297         "alle Proxy-/Client-Timeouts > 0 und <= 120s",
298     )
