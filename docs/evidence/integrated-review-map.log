 842         input
 843             .grant_id
 844             .as_deref()
 845             .or(input.delegation_id.as_deref())
 846             .unwrap_or_default(),
 847     )?;
 848     Ok(Json(
 849         json!({"allowed":true,"data":app.document.as_ref(),"fresh_passkey_required":false}),
 850     ))
 851 }
 852
 853 #[derive(Clone, Serialize, Deserialize)]
 854 #[serde(deny_unknown_fields)]
 855 pub(super) struct VaultWrap {
 856     credential_id: String,
 857     salt: String,
 858     nonce: String,
 859     ciphertext: String,
 860 }
 861 #[derive(Clone, Serialize, Deserialize)]
 862 #[serde(deny_unknown_fields)]
 863 pub(super) struct RecoveryWrap {
 864     salt: String,
 865     nonce: String,
 866     ciphertext: String,
 867 }
 868 #[derive(Clone, Serialize, Deserialize)]
 869 #[serde(deny_unknown_fields)]
 870 pub(super) struct VaultRecord {
 871     version: u8,
 872     nonce: String,
 873     ciphertext: String,
 874     wraps: Vec<VaultWrap>,
 875     recovery: RecoveryWrap,
 876 }
 877 fn binary_length(value: &str, min: usize, max: usize) -> ApiResult<()> {
 878     let bytes = URL_SAFE_NO_PAD
 879         .decode(value)
 880         .map_err(|_| forbidden("invalid_vault_record"))?;
 881     if !(min..=max).contains(&bytes.len()) || URL_SAFE_NO_PAD.encode(bytes) != value {
 882         return Err(forbidden("invalid_vault_record"));
 883     }
 884     Ok(())
 885 }
 886 fn validate_vault(inner: &Inner, user: &User, record: &VaultRecord) -> ApiResult<()> {
 887     if record.version != 1 || record.wraps.is_empty() || record.wraps.len() > 8 {
 888         return Err(forbidden("invalid_vault_record"));
 889     }
 890     binary_length(&record.nonce, 12, 12)?;
 891     binary_length(&record.ciphertext, 16, 8192)?;
 892     binary_length(&record.recovery.salt, 32, 32)?;
 893     binary_length(&record.recovery.nonce, 12, 12)?;
 894     binary_length(&record.recovery.ciphertext, 48, 48)?;
 895     let mut ids = BTreeSet::new();
 896     for w in &record.wraps {
 897         if !ids.insert(&w.credential_id) || !inner.credential_active(&user.id, &w.credential_id)? {
 898             return Err(forbidden("vault_credential_denied"));
 899         }
 900         binary_length(&w.salt, 32, 32)?;
 901         binary_length(&w.nonce, 12, 12)?;
 902         binary_length(&w.ciphertext, 48, 48)?;
 903     }
 904     Ok(())
 905 }
 906 #[derive(Deserialize)]
 907 #[serde(deny_unknown_fields)]
 908 pub(super) struct VaultPrepare {
 909     expected_revision: u64,
 910     record: VaultRecord,
 911 }
 912 #[derive(Deserialize)]
 913 #[serde(deny_unknown_fields)]
 914 pub(super) struct VaultWrite {
 915     expected_revision: u64,
 916     record: VaultRecord,
 917     approval_id: Option<String>,
 918 }
 919 fn vault_operation(revision: u64, record: &VaultRecord) -> ApiResult<Management> {
 920     Ok(Management::VaultWrite {
 921         expected_revision: revision,
 922         digest: URL_SAFE_NO_PAD.encode(Sha256::digest(
 923             serde_json::to_vec(record).map_err(internal)?,
 924         )),
 925     })
 926 }
 927 pub(super) async fn vault(State(app): State<App>, headers: HeaderMap) -> ApiResult<Json<Value>> {
 928     let mut inner = app.inner.lock().map_err(internal)?;
 929     let user = inner.session_user(&headers)?;
 930     let row: Option<(i64, String)> = inner
 931         .db
 932         .query_row(
 933             "SELECT revision,record FROM vaults WHERE account_id=?1",
 934             [&user.id],
 935             |r| Ok((r.get(0)?, r.get(1)?)),
 936         )
 937         .optional()
 938         .map_err(internal)?;
 939     match row {
 940         Some((revision, record)) => Ok(Json(
 941             json!({"account_id":user.id,"revision":revision,"record":serde_json::from_str::<VaultRecord>(&record).map_err(internal)?}),
 942         )),
 943         None => Ok(Json(
 944             json!({"account_id":user.id,"revision":0,"record":null}),
 945         )),
 946     }
 947 }
 948 pub(super) async fn vault_prepare(
 949     State(app): State<App>,
 950     headers: HeaderMap,
 951     Json(input): Json<VaultPrepare>,
 952 ) -> ApiResult<Json<Value>> {
 953     let mut inner = app.inner.lock().map_err(internal)?;
 954     let user = inner.session_user(&headers)?;
 955     validate_vault(&inner, &user, &input.record)?;
 956     Ok(Json(
 957         json!({"management":vault_operation(input.expected_revision,&input.record)?}),
 958     ))
 959 }
 960 pub(super) async fn vault_write(
 961     State(app): State<App>,
 962     headers: HeaderMap,
 963     Json(input): Json<VaultWrite>,
 964 ) -> ApiResult<Json<Value>> {
 965     let mut inner = app.inner.lock().map_err(internal)?;
 966     let approval = inner.take_approval(input.approval_id.as_deref());
 967     let user = inner.session_user(&headers)?;
 968     inner.require_approval(
 969         &headers,
 970         &user,
 971         input.approval_id.as_deref(),
 972         approval,
 973         &vault_operation(input.expected_revision, &input.record)?,
 974     )?;
 975     validate_vault(&inner, &user, &input.record)?;
 976     let revision = input
 977         .expected_revision
 978         .checked_add(1)
 979         .filter(|v| *v <= 9007199254740991)
 980         .ok_or(forbidden("vault_revision_conflict"))?;
 981     let record = serde_json::to_string(&input.record).map_err(internal)?;
 982     let tx = inner.db.transaction().map_err(internal)?;
 983     let changed = if input.expected_revision == 0 {
 984         tx.execute(
 985             "INSERT OR IGNORE INTO vaults(account_id,revision,record) VALUES(?1,1,?2)",
 986             params![user.id, record],
 987         )
 988     } else {
 989         tx.execute(
 990             "UPDATE vaults SET revision=?1,record=?2 WHERE account_id=?3 AND revision=?4",
 991             params![
 992                 db_time(revision)?,
 993                 record,
 994                 user.id,
 995                 db_time(input.expected_revision)?
 996             ],
 997         )
 998     }
 999     .map_err(internal)?;
1000     if changed != 1 {
1001         return Err(ApiError(StatusCode::CONFLICT, "vault_revision_conflict"));
1002     }
1003     audit(&tx, &user.id, "vault_updated", &revision.to_string())?;
1004     tx.commit().map_err(internal)?;
1005     Ok(Json(json!({"revision":revision,"saved":true})))
1006 }
