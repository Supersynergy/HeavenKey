 1 import { test, expect } from "bun:test";
 2 import { random, encode, decode, wrap, unwrap, seal, open } from "./vault";
 3 test("vault rejects wrong key, changed account, wrong credential and modified ciphertext", async () => {
 4   const key = random(32), prf = random(32), salt = random(32);
 5   const wrapped = await wrap(key, prf, salt, "alice", "credential-a");
 6   expect(await unwrap(wrapped, prf, "alice", "credential-a")).toEqual(key);
 7   await expect(unwrap(wrapped, random(32), "alice", "credential-a")).rejects.toThrow();
 8   await expect(unwrap(wrapped, prf, "bob", "credential-a")).rejects.toThrow();
 9   await expect(unwrap(wrapped, prf, "alice", "credential-b")).rejects.toThrow();
10   const record = await seal("Privater Beispieltext 🗝", key, "alice");
11   expect(await open(record, key, "alice")).toBe("Privater Beispieltext 🗝");
12   await expect(open(record, key, "bob")).rejects.toThrow();
13   const bytes = decode(record.ciphertext); bytes[0] ^= 1;
14   await expect(open({ ...record, ciphertext: encode(bytes) }, key, "alice")).rejects.toThrow();
15   expect((await seal("same", key, "alice")).nonce).not.toBe((await seal("same", key, "alice")).nonce);
16 });
17 test("multiple independent passkeys and offline recovery wrap the same vault key", async () => {
18   const key = random(32), first = random(32), second = random(32), recovery = random(32);
19   const a = await wrap(key, first, random(32), "alice", "credential-a");
20   const b = await wrap(key, second, random(32), "alice", "credential-b");
21   const c = await wrap(key, recovery, random(32), "alice", "offline-recovery");
22   expect(await unwrap(a, first, "alice", "credential-a")).toEqual(await unwrap(b, second, "alice", "credential-b"));
23   expect(await unwrap(c, recovery, "alice", "offline-recovery")).toEqual(key);
24   await expect(unwrap(a, second, "alice", "credential-a")).rejects.toThrow();
25   expect(() => decode("invalid=")).toThrow();
26 });
