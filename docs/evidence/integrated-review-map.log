crates/verifier/tests/grant_v0.rs --- Rust
  1 //! Conformance vectors for the legacy grant-v0 profile.
  2 //!
  3 //! docs/vectors/grant-v0.json is generated by this test (regenerate with
  4 //! `HEAVENKEY_GRANT_V0_REGEN=1 cargo test -p uac-verifier --test grant_v0`) and
  5 //! independently re-verified by scripts/grant-reference.mjs, which re-encodes
  6 //! every body itself and checks signatures and ids with its own crypto.
  7
  8 use ed25519_dalek::SigningKey;
  9 use serde_json::{Value, json};
 10 use std::path::Path;
 11 use uac_verifier::*;
 12
 13 const GRANT_DOMAIN: &[u8] = b"UAC-AUDIT-GRANT-v0\0";
 14 const INVOKE_DOMAIN: &[u8] = b"UAC-AUDIT-INVOKE-v0\0";
 15 const RESOURCE: &str = "urn:demo:tool:alpha";
 16 const NOW: u64 = 100;
 17 const NONCE: [u8; 32] = [7; 32];
 18 const ARGS: [u8; 32] = [9; 32];
 19 const PATH: &str = "../../docs/vectors/grant-v0.json";
 20
 21 fn key(seed: u8) -> SigningKey {
 22     SigningKey::from_bytes(&[seed; 32])
 23 }
 24
 25 fn public(key: &SigningKey) -> [u8; 32] {
 26     key.verifying_key().to_bytes()
 27 }
 28
 29 fn hex(bytes: &[u8]) -> String {
 30     bytes.iter().map(|byte| format!("{byte:02x}")).collect()
 31 }
 32
 33 fn unhex(text: &str) -> [u8; 32] {
 34     let bytes: Vec<u8> = (0..text.len())
 35         .step_by(2)
 36         .map(|index| u8::from_str_radix(&text[index..index + 2], 16).unwrap())
 37         .collect();
 38     bytes.try_into().unwrap()
 39 }
