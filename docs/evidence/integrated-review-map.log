123     const result = await request("/api/recovery/rotate", { approval_id }, o.session); assert.equal(result.status, 200); recoveryCode = result.value.code;
124     const status = await request("/api/recovery", undefined, o.session); assert.equal(status.value.enabled, true); assert.equal(JSON.stringify(status.value).includes(recoveryCode), false);
