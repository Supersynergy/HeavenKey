 389 pub(super) struct AgentSpec {
 390     name: String,
 391     public_key: String,
 392     resource: String,
 393     actions: BTreeSet<Action>,
 394     ttl_seconds: u64,
 395     parent_id: Option<String>,
 396 }
 397 #[derive(Clone, Serialize, Deserialize)]
 398 #[serde(deny_unknown_fields)]
 399 struct AgentGrant {
 400     profile: String,
 401     id: String,
 402     account_id: String,
 403     credential_id: String,
 404     spec: AgentSpec,
 405     not_before: u64,
 406     expires_at: u64,
 407 }
 408 fn agent_message(body: &AgentGrant) -> ApiResult<Vec<u8>> {
 409     let mut bytes = b"HEAVENKEY-AGENT-GRANT-v1\0".to_vec();
 410     bytes.extend(serde_json::to_vec(body).map_err(internal)?);
 411     Ok(bytes)
 412 }
 413 fn public_key(value: &str) -> ApiResult<VerifyingKey> {
 414     let bytes: [u8; 32] = URL_SAFE_NO_PAD
 415         .decode(value)
 416         .map_err(|_| forbidden("invalid_agent_key"))?
 417         .try_into()
 418         .map_err(|_| forbidden("invalid_agent_key"))?;
 419     let key = VerifyingKey::from_bytes(&bytes).map_err(|_| forbidden("invalid_agent_key"))?;
 420     if key.is_weak() || URL_SAFE_NO_PAD.encode(bytes) != value {
 421         return Err(forbidden("invalid_agent_key"));
 422     }
 423     Ok(key)
 424 }
 425 fn agent_authority(inner: &Inner, user: &User, spec: &AgentSpec, expires_at: u64) -> ApiResult<()> {
 426     credential_label(&spec.name)?;
 427     public_key(&spec.public_key)?;
 428     if !(1..=3600).contains(&spec.ttl_seconds)
 429         || spec.actions.is_empty()
 430         || spec.actions.contains(&Action::Unlock)
 431     {
 432         return Err(forbidden("agent_scope_denied"));
 433     }
 434     match spec.resource.as_str() {
 435         "document" if spec.actions == BTreeSet::from([Action::Read]) => {}
 436         "crm.contacts" if user.owner && spec.parent_id.is_none() => {}
 437         _ => return Err(forbidden("agent_scope_denied")),
 438     }
 439     if let Some(parent) = &spec.parent_id {
 440         let chain = inner.delegation_chain(parent)?;
 441         inner.delegation_verify(user, &chain, RESOURCE, Action::Read)?;
 442         let leaf = chain.chain.last().ok_or(forbidden("delegation_denied"))?;
 443         if leaf.body.remaining_delegations == 0
 444             || expires_at > leaf.body.expires_at
 445             || spec.resource != "document"
 446         {
 447             return Err(forbidden("agent_scope_denied"));
 448         }
 449     } else if !user.owner {
 450         return Err(forbidden("agent_parent_required"));
 451     }
 452     Ok(())
 453 }
 454 pub(super) fn management_allowed(inner: &Inner, user: &User, op: &Management) -> ApiResult<()> {
 455     match op {
 456         Management::AgentCreate { spec } => agent_authority(
 457             inner,
 458             user,
 459             spec,
 460             now()
 461                 .checked_add(spec.ttl_seconds)
 462                 .ok_or(forbidden("agent_scope_denied"))?,
 463         ),
 464         Management::AgentRevoke { id } => {
 465             let owned: bool = inner
 466                 .db
 467                 .query_row(
 468                     "SELECT EXISTS(SELECT 1 FROM agent_tasks WHERE id=?1 AND account_id=?2)",
 469                     params![id, user.id],
 470                     |r| r.get(0),
 471                 )
 472                 .map_err(internal)?;
 473             if !owned {
 474                 return Err(forbidden("agent_not_found"));
 475             }
 476             Ok(())
 477         }
 478         Management::RecoveryRotate
 479         | Management::RecoveryDisable
 480         | Management::VaultWrite { .. } => Ok(()),
 481         _ => Err(forbidden("management_changed")),
 482     }
 483 }
