scripts/first_run.py --- Python
 1 """Build and launch the checked-out preview without requiring just or Docker."""
 2 import argparse
 3 import os
 4 from pathlib import Path
 5 import shutil
 6 import subprocess
 7 import sys
 8
 9 ROOT = Path(__file__).resolve().parent.parent
10
11
12 def main():
13     parser = argparse.ArgumentParser(description=__doc__)
14     parser.add_argument("--check-only", action="store_true")
15     parser.add_argument("--no-open", action="store_true")
16     parser.add_argument("--port", type=int, default=18240)
17     parser.add_argument("--data-dir", type=Path)
18     parser.add_argument("--protection-key-file", type=Path)
19     args = parser.parse_args()
20     if not 1 <= args.port <= 65535:
21         parser.error("Port must be between 1 and 65535")
22     missing = [name for name in ("cargo", "bun") if not shutil.which(name)]
23     if missing:
24         print("Install these tools first: " + ", ".join(missing))
25         print("Rust: https://rustup.rs/\nBun 1.4.2: https://bun.sh/docs/installation")
26         return 1
27     version = subprocess.check_output(["bun", "--version"], text=True, timeout=15).strip()
28     if version != "1.4.2":
29         print(f"Bun 1.4.2 is required; installed: {version}")
30         return 1
31     print("Required tools available. Rustup selects the repository's pinned toolchain.")
32     if args.check_only:
33         return 0
34     env = os.environ.copy()
35     if args.protection_key_file:
36         from create_protection_key import create
37         path = args.protection_key_file.expanduser().absolute()
38         if not path.exists():
39             create(path)
40         env["HEAVENKEY_KEY_FILE"] = str(path)
41     for command, timeout in (
42         (["bun", "install", "--frozen-lockfile", "--ignore-scripts"], 180),
43         (["cargo", "fetch", "--locked"], 300),
44         ([sys.executable, "scripts/build_web.py"], 120),
45         (["cargo", "build", "--locked", "--offline"], 900),
46     ):
47         print("Running: " + " ".join(command), flush=True)
48         subprocess.run(command, cwd=ROOT, env=env, check=True, timeout=timeout)
49     binary = ROOT / "target/debug" / ("uac-api.exe" if os.name == "nt" else "uac-api")
50     command = [str(binary), "--port", str(args.port)]
51     if not args.no_open:
52         command.append("--open")
53     if args.data_dir:
54         command += ["--data-dir", str(args.data_dir)]
55     print("HeavenKey starts in this terminal. Stop with Ctrl+C.", flush=True)
56     return subprocess.call(command, cwd=ROOT, env=env)
57
58
59 if __name__ == "__main__":
60     try:
61         raise SystemExit(main())
62     except (subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError) as error:
63         print(f"Setup stopped: {error}", file=sys.stderr)
64         print("See docs/INSTALLATION.md for the matching solution.", file=sys.stderr)
65         raise SystemExit(1)
66

scripts/grant-reference.mjs --- JavaScript
  1 // Independent conformance check for the grant-v0 profile.
  2 // Re-encodes every body into canonical serde_json bytes (struct field order,
  3 // BTreeSet order, compact separators), verifies Ed25519 signatures and
  4 // SHA-256 grant ids with Node crypto, and replays the documented deny
  5 // semantics. `cargo test -p uac-verifier --test grant_v0` is the Rust side;
  6 // this file must not import its implementation.
  7 import { createHash, createPublicKey, verify } from "node:crypto";
  8 import { readFile } from "node:fs/promises";
  9 import { resolve } from "node:path";
 10 import { pathToFileURL } from "node:url";
 11 import assert from "node:assert/strict";
 12
 13 const GRANT_DOMAIN = Buffer.from("UAC-AUDIT-GRANT-v0\0", "utf8");
 14 const INVOKE_DOMAIN = Buffer.from("UAC-AUDIT-INVOKE-v0\0", "utf8");
 15 const MAX_CHAIN = 8, MAX_GRANT_BYTES = 4096, INVOKE_WINDOW = 30;
 16 const ACTION_RANK = { Read: 0, Write: 1, Unlock: 2 };
 17
 18 function reject(reason) { const e = new Error(reason); e.name = reason; throw e; }
 19 function requireValue(condition, reason) { if (!condition) reject(reason); }
 20 function bytes(value, length) {
 21   requireValue(Array.isArray(value) && value.every(n => Number.isInteger(n) && n >= 0 && n <= 255), "Encoding");
 22   if (length !== undefined) requireValue(value.length === length, "Encoding");
 23   return Buffer.from(value);
 24 }
 25 const equal = (a, b) => Buffer.from(a).equals(Buffer.from(b));
 26
 27 // Canonical serde_json encoders (field order = Rust struct declaration order).
 28 const emitArray = a => `[${a.join(",")}]`;
 29 const emitString = s => JSON.stringify(s); // serde_json escapes control chars, " and \\ only; identical for our inputs
 30 const emitOpt32 = v => v === null ? "null" : emitArray(v);
 31 function sortedActions(actions) { return [...new Set(actions)].sort((a, b) => ACTION_RANK[a] - ACTION_RANK[b]); }
 32
 33 function grantValid(body) {
 34   requireValue(body && typeof body === "object" && !Array.isArray(body), "Encoding");
 35   requireValue(JSON.stringify(Object.keys(body).sort()) === JSON.stringify(["actions", "audience", "expires_at", "issuer", "not_before", "parent", "remaining_delegations", "resource"]), "Encoding");
 36   bytes(body.issuer, 32); bytes(body.audience, 32);
 37   requireValue(typeof body.resource === "string", "Encoding");
 38   requireValue(Array.isArray(body.actions) && body.actions.every(a => Object.hasOwn(ACTION_RANK, a)), "Encoding");
 39   requireValue(Number.isSafeInteger(body.not_before) && body.not_before >= 0 && Number.isSafeInteger(body.expires_at) && body.expires_at >= 0, "Encoding");
 40   requireValue(Number.isInteger(body.remaining_delegations) && body.remaining_delegations >= 0 && body.remaining_delegations <= 255, "Encoding");
 41   if (body.parent !== null) bytes(body.parent, 32);
 42 }
 43 function invocationValid(body) {
 44   requireValue(body && typeof body === "object" && !Array.isArray(body), "Encoding");
 45   requireValue(JSON.stringify(Object.keys(body).sort()) === JSON.stringify(["action", "arguments_hash", "grant", "issued_at", "nonce", "resource"]), "Encoding");
 46   bytes(body.grant, 32); bytes(body.arguments_hash, 32); bytes(body.nonce, 32);
 47   requireValue(typeof body.resource === "string" && Object.hasOwn(ACTION_RANK, body.action), "Encoding");
 48   requireValue(Number.isSafeInteger(body.issued_at) && body.issued_at >= 0, "Encoding");
 49 }
 50 function emitGrant(body) {
 51   return `{"issuer":${emitArray(body.issuer)},"audience":${emitArray(body.audience)},"resource":${emitString(body.resource)},"actions":[${sortedActions(body.actions).map(a => `"${a}"`).join(",")}],"not_before":${body.not_before},"expires_at":${body.expires_at},"remaining_delegations":${body.remaining_delegations},"parent":${emitOpt32(body.parent)}}`;
 52 }
 53 function emitInvocation(body) {
 54   return `{"grant":${emitArray(body.grant)},"resource":${emitString(body.resource)},"action":${emitString(body.action)},"arguments_hash":${emitArray(body.arguments_hash)},"nonce":${emitArray(body.nonce)},"issued_at":${body.issued_at}}`;
 55 }
 56 function emitSigned(signed, emitBody) {
 57   return `{"body":${emitBody(signed.body)},"signature":${emitArray(signed.signature)}}`;
 58 }
 59 function grantMessage(body) { grantValid(body); return Buffer.concat([GRANT_DOMAIN, Buffer.from(emitGrant(body), "utf8")]); }
 60 function invocationMessage(body) { invocationValid(body); return Buffer.concat([INVOKE_DOMAIN, Buffer.from(emitInvocation(body), "utf8")]); }
 61 function grantId(signed) {
 62   return createHash("sha256").update(GRANT_DOMAIN).update(Buffer.from(emitSigned(signed, emitGrant), "utf8")).digest("hex");
 63 }
 64 const publicKey = issuer => createPublicKey({ key: Buffer.concat([Buffer.from("302a300506032b6570032100", "hex"), bytes(issuer, 32)]), format: "der", type: "spki" });
 65 function signatureOk(signed, emitBody, domain, publicBytes) {
 66   return verify(null, Buffer.concat([domain, Buffer.from(emitBody(signed.body), "utf8")]), publicKey(publicBytes), bytes(signed.signature));
 67 }
 68
 69 export function decodeGrant(text) {
 70   requireValue(Buffer.byteLength(text) <= MAX_GRANT_BYTES, "Limits");
 71   let result;
 72   try { result = JSON.parse(text); } catch { reject("Encoding"); }
 73   const tokens = text.match(/"(?:\\.|[^"\\])*"|[{}\[\]:,]|-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?|true|false|null/g) || [];
 74   const stack = [];
 75   for (let n = 0; n < tokens.length; n++) {
 76     const token = tokens[n], frame = stack.at(-1);
 77     if (token === "{") stack.push({ object: true, keys: new Set(), key: true });
 78     else if (token === "[") stack.push({ object: false });
 79     else if (token === "}" || token === "]") stack.pop();
 80     else if (token === "," && frame?.object) frame.key = true;
 81     else if (frame?.object && frame.key && token.startsWith('"') && tokens[n + 1] === ":") {
 82       const key = JSON.parse(token); requireValue(!frame.keys.has(key), "Encoding"); frame.keys.add(key); frame.key = false;
 83     }
 84   }
 85   requireValue(result && JSON.stringify(Object.keys(result).sort()) === JSON.stringify(["body", "signature"]), "Encoding");
 86   grantValid(result.body); bytes(result.signature);
 87   return result;
 88 }
 89
 90 export function verifyChain(chain, invocation, context, state = { lastTime: 0, nonces: new Set() }) {
 91   const { root, resource, action, argumentsHash, nonce, now } = context;
 92   requireValue(chain.length >= 1 && chain.length <= MAX_CHAIN, "Limits");
 93   requireValue(now >= state.lastTime, "ClockRollback");
 94   state.lastTime = now;
 95   let previous = null;
 96   for (const signed of chain) {
 97     requireValue(Buffer.byteLength(emitSigned(signed, emitGrant), "utf8") <= MAX_GRANT_BYTES, "Limits");
 98     requireValue(signatureOk(signed, emitGrant, GRANT_DOMAIN, signed.body.issuer), "Signature");
 99     const body = signed.body;
100     requireValue(body.actions.length > 0 && body.resource === resource, "Escalation");
101     requireValue(!(body.not_before >= body.expires_at || now < body.not_before || now >= body.expires_at), "Time");
102     requireValue(!context.revoked.includes(grantId(signed)), "Revoked");
103     if (previous) {
104       const parent = previous.body;
105       requireValue(equal(body.issuer, parent.audience) && body.parent !== null && equal(body.parent, Buffer.from(grantId(previous), "hex")), "Chain");
106       requireValue(sortedActions(body.actions).every(a => parent.actions.includes(a)) && body.not_before >= parent.not_before && body.expires_at <= parent.expires_at && parent.remaining_delegations > 0 && body.remaining_delegations < parent.remaining_delegations, "Escalation");
107     } else {
108       requireValue(equal(body.issuer, root) && body.parent === null, "UntrustedRoot");
109     }
110     previous = signed;
111   }
112   const leaf = previous;
113   requireValue(signatureOk(invocation, emitInvocation, INVOKE_DOMAIN, leaf.body.audience), "Signature");
114   const req = invocation.body;
115   requireValue(equal(req.grant, Buffer.from(grantId(leaf), "hex")) && req.resource === resource && req.action === action && equal(req.arguments_hash, argumentsHash) && equal(req.nonce, nonce) && leaf.body.actions.includes(action), "Invocation");
116   requireValue(!(now < req.issued_at || now - req.issued_at >= INVOKE_WINDOW), "Time");
117   requireValue(!state.nonces.has(req.nonce.join(",")), "Replay");
118   state.nonces.add(req.nonce.join(","));
119   return true;
120 }
121
122 export function authorizeGrant(signed, { root, holder, resource, action, now, revoked }) {
123   requireValue(Buffer.byteLength(emitSigned(signed, emitGrant), "utf8") <= MAX_GRANT_BYTES, "Limits");
124   requireValue(signatureOk(signed, emitGrant, GRANT_DOMAIN, signed.body.issuer), "Signature");
125   const body = signed.body;
126   requireValue(equal(body.issuer, root) && body.parent === null, "UntrustedRoot");
127   requireValue(!revoked, "Revoked");
128   requireValue(equal(body.audience, holder) && body.resource === resource && body.actions.includes(action), "Invocation");
129   requireValue(!(body.not_before >= body.expires_at || now < body.not_before || now >= body.expires_at), "Time");
130   return true;
131 }
132
133 function outcome(fn) {
134   try { fn(); return "ok"; } catch (e) { return e.name || "Encoding"; }
135 }
136
137 export function checkVectors(vectors) {
138   const grants = new Map(vectors.fixtures.map(f => [f.name, f.grant]));
139   const invocations = new Map(vectors.invocations.map(f => [f.name, f.invocation]));
140   const root = Buffer.from(vectors.trusted_root, "hex");
141   let checks = 0;
142   for (const fixture of vectors.fixtures) {
143     const m = grantMessage(fixture.grant.body);
144     assert.equal(m.toString("hex"), fixture.message_hex, `message ${fixture.name}`);
145     assert.equal(grantId(fixture.grant), fixture.id_hex, `id ${fixture.name}`);
146     if (fixture.signature_valid !== false) assert.ok(signatureOk(fixture.grant, emitGrant, GRANT_DOMAIN, fixture.grant.body.issuer), `signature ${fixture.name}`);
147     else assert.ok(!signatureOk(fixture.grant, emitGrant, GRANT_DOMAIN, fixture.grant.body.issuer), `signature ${fixture.name}`);
148     checks++;
149   }
150   for (const fixture of vectors.invocations) {
151     assert.equal(invocationMessage(fixture.invocation.body).toString("hex"), fixture.message_hex, `message ${fixture.name}`);
152     checks++;
153   }
154   for (const kase of vectors.cases) {
155     const state = { lastTime: 0, nonces: new Set() };
156     const chain = kase.chain.map(name => grants.get(name));
157     const invocation = invocations.get(kase.invocation);
158     for (const step of kase.steps) {
159       const context = {
160         root, resource: kase.context.resource, action: kase.context.action,
161         argumentsHash: Buffer.from(kase.context.arguments_hash, "hex"), nonce: Buffer.from(kase.context.nonce, "hex"),
162         revoked: kase.revoked || [], now: step.now,
163       };
164       assert.equal(outcome(() => verifyChain(chain, invocation, context, state)), step.expect, `${kase.name} @${step.now}`);
165       checks++;
166     }
167   }
168   for (const kase of vectors.grant_cases) {
169     const context = {
170       root, holder: Buffer.from(kase.holder, "hex"), resource: kase.resource,
171       action: kase.action, now: kase.now, revoked: kase.revoked || false,
172     };
173     assert.equal(outcome(() => authorizeGrant(grants.get(kase.grant), context)), kase.expect, kase.name);
174     checks++;
175   }
176   for (const entry of vectors.invalid_json) { assert.throws(() => decodeGrant(entry.json), entry.name); checks++; }
177   for (const entry of vectors.equivalent_json) {
178     const decoded = decodeGrant(entry.json);
179     assert.equal(grantId(decoded), entry.expect_id, entry.name); checks++;
180   }
181   return { passed: checks, fixtures: vectors.fixtures.length, cases: vectors.cases.length, independent: "Node crypto Ed25519/SHA256 with separate serde_json encoder" };
182 }
183
184 if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
185   const [command = "--check", path = "docs/vectors/grant-v0.json"] = process.argv.slice(2);
186   assert.equal(command, "--check");
187   console.log(JSON.stringify(checkVectors(JSON.parse(await readFile(path, "utf8")))));
188 }
189

scripts/https_e2e.mjs --- JavaScript
  1 import assert from "node:assert/strict";
  2 import { readFile, writeFile, mkdir } from "node:fs/promises";
  3 import { createHash } from "node:crypto";
  4 import { chromium } from "playwright-core";
  5
  6 const origin = process.env.HEAVENKEY_TEST_ORIGIN;
  7 const data = process.env.HEAVENKEY_TEST_DATA;
  8 const output = process.env.HEAVENKEY_TEST_EVIDENCE;
  9 const localTLS = process.env.HEAVENKEY_LOCAL_TLS_TEST === "1" && /^https:\/\/heaven\.test:\d+$/.test(origin || "");
 10 if (!origin || (!/^https:\/\/[a-z0-9-]+\.trycloudflare\.com$/.test(origin) && !localTLS) || !data || !output) {
 11   throw new Error("explicit owned HTTPS test origin, isolated data and evidence directory required");
 12 }
 13 await mkdir(output, { recursive: true });
 14 const document = await readFile(process.env.HEAVENKEY_DOCUMENT, "utf8");
 15 const cases = [];
 16 const responses = [];
 17 const actors = [];
 18 let browser;
 19 let failure;
 20 async function test(name, action) {
 21   try { await action(); cases.push({ name, pass: true }); console.log(`PASS ${name}`); }
 22   catch (error) { cases.push({ name, pass: false, error: error.message }); throw error; }
 23 }
 24 async function actor(name) {
 25   const context = await browser.newContext({ ignoreHTTPSErrors: localTLS });
 26   const page = await context.newPage();
 27   const cdp = await context.newCDPSession(page);
 28   await cdp.send("WebAuthn.enable");
 29   await cdp.send("WebAuthn.addVirtualAuthenticator", { options: { protocol: "ctap2", transport: "internal", hasResidentKey: true, hasUserVerification: true, isUserVerified: true, automaticPresenceSimulation: true } });
 30   page.on("response", r => {
 31     if (r.url().includes("/api/")) responses.push({ actor: name, path: new URL(r.url()).pathname, status: r.status() });
 32   });
 33   await page.goto(origin);
 34   await page.locator("#name").fill(name);
 35   const value = { context, page, name }; actors.push(value); return value;
 36 }
 37 async function action(a, selector, endpoint) {
 38   const response = a.page.waitForResponse(r => r.url() === origin + endpoint, { timeout: 15000 });
 39   await a.page.locator(selector).click();
 40   const result = await response; assert.equal(result.status(), 200, await result.text()); return result.json();
 41 }
 42 async function confirm(a, selector, endpoint) {
 43   const response = a.page.waitForResponse(r => r.url() === origin + endpoint, { timeout: 15000 });
 44   await a.page.locator(selector).click();
 45   await a.page.locator("#management-confirm").click();
 46   const result = await response; assert.equal(result.status(), 200, await result.text()); return result.json();
 47 }
 48 async function post(a, path, body) {
 49   return a.page.evaluate(async ({ path, body }) => {
 50     const r = await fetch(path, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
 51     return { status: r.status, body: await r.json() };
 52   }, { path, body });
 53 }
 54 async function get(a, path) {
 55   return a.page.evaluate(async path => {
 56     const response = await fetch(path);
 57     return { status: response.status, text: await response.text() };
 58   }, path);
 59 }
 60 try {
 61   browser = await chromium.launch({ executablePath: process.env.CHROME_PATH || "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome", headless: true, args: localTLS ? ["--host-resolver-rules=MAP heaven.test 127.0.0.1", "--no-proxy-server", "--ignore-certificate-errors"] : [] });
 62   const owner = await actor("owner");
 63   const guest = await actor("guest");
 64   let grant;
 65   await test("trusted HTTPS and exact public RP ID", async () => {
 66     assert.equal(await owner.page.evaluate(() => isSecureContext), true);
 67     const health = await get(owner, "/health");
 68     assert.equal(JSON.parse(health.text).mode, "https-passkey-pilot");
 69     const start = await post(guest, "/api/register/start", { name: "rp-probe" });
 70     assert.equal(start.body.options.publicKey.rp.id, new URL(origin).hostname);
 71   });
 72   await test("document is absent from anonymous routes and web assets", async () => {
 73     for (const path of ["/", "/main.js", "/style.css", "/document", "/protected-document.txt", "/owner-bootstrap.txt"]) {
 74       const response = await get(owner, path);
 75       assert.equal(response.text.includes(document), false, path);
 76     }
 77     assert.equal((await get(owner, "/api/grants")).status, 401);
 78   });
 79   await test("first visitor cannot claim owner", async () => {
 80     assert.equal((await post(guest, "/api/register/start", { name: "owner" })).status, 403);
 81   });
 82   await test("owner enrolls with one-use operator code and verified passkey", async () => {
 83     await owner.page.locator("#bootstrap").fill((await readFile(data + "/owner-bootstrap.txt", "utf8")).trim());
 84     await action(owner, "#register", "/api/register/finish");
 85     await action(owner, "#login", "/api/auth/finish");
 86   });
 87   await test("guest enrolls own passkey and has no access initially", async () => {
 88     await action(guest, "#register", "/api/register/finish");
 89     await action(guest, "#login", "/api/auth/finish");
 90     await guest.page.locator("#grants .empty").waitFor();
 91   });
 92   await test("owner issues read access after passkey confirmation", async () => {
 93     grant = await confirm(owner, "#issue", "/api/grants");
 94     await owner.page.locator(".grant a").waitFor();
 95   });
 96   await test("share link opens recipient account without a bearer credential", async () => {
 97     const link = await owner.page.locator(".grant a").getAttribute("href");
 98     assert.equal(link, origin + "/?guest=guest");
 99     await guest.page.goto(link);
100     assert.equal(await guest.page.locator("#name").inputValue(), "guest");
101     await action(guest, "#login", "/api/auth/finish");
102     await guest.page.locator(".grant button").first().waitFor();
103   });
104   await test("document opens only after recipient passkey and grant verification", async () => {
105     const result = await action(guest, ".grant button:first-child", "/api/auth/finish");
106     assert.equal(result.authorized, true); assert.equal(result.data, document);
107     const sessionResult = await action(guest, ".grant button:last-child", "/api/read");
108     assert.equal(sessionResult.allowed, true); assert.equal(sessionResult.data, document);
109     await guest.page.screenshot({ path: output + "/https-document-open.png", fullPage: true });
110   });
111   await test("fresh ceremony prepared before revocation cannot survive it", async () => {
112     const invocation = { grant: grant.grant, resource: "urn:uac:lab:document", action: "Read", arguments: { document: "overview" } };
113     const pending = await post(guest, "/api/auth/start", { name: "guest", invocation });
114     assert.equal(pending.status, 200);
115     const credential = await guest.page.evaluate(async options => {
116       const decode = s => Uint8Array.from(atob(s.replace(/-/g, "+").replace(/_/g, "/")), c => c.charCodeAt(0));
117       options.publicKey.challenge = decode(options.publicKey.challenge);
118       for (const c of options.publicKey.allowCredentials || []) c.id = decode(c.id);
119       return (await navigator.credentials.get(options)).toJSON();
120     }, pending.body.options);
121     await confirm(owner, ".grant button:first-child", "/api/grants/revoke");
122     const denied = await post(guest, "/api/auth/finish", { request_id: pending.body.request_id, credential, invocation });
123     assert.equal(denied.status, 403); assert.equal(denied.body.data, undefined);
124     await writeFile(output + "/revocation-response.json", JSON.stringify({ status: denied.status, error: denied.body.error }, null, 2));
125   });
126   await test("stale recipient page cannot fetch document after revocation", async () => {
127     const response = guest.page.waitForResponse(r => r.url() === origin + "/api/auth/start");
128     await guest.page.locator(".grant button").first().click();
129     assert.equal((await response).status(), 403);
130     await guest.page.waitForFunction(() => document.querySelector("#status").dataset.error === "true");
131     assert.equal(await guest.page.locator("#result").innerText(), "—");
132     await guest.page.screenshot({ path: output + "/https-document-denied.png", fullPage: true });
133   });
134   await test("reload and recipient login preserve revocation", async () => {
135     await guest.page.reload(); await action(guest, "#login", "/api/auth/finish");
136     await guest.page.getByText("Widerrufen", { exact: true }).waitFor();
137     assert.equal(await guest.page.locator(".grant button").first().isDisabled(), true);
138     await guest.page.screenshot({ path: output + "/https-revoked-persistent.png", fullPage: true });
139   });
140 } catch (error) { failure = error; console.error(error); }
141 finally {
142   await browser?.close();
143   await writeFile(output + "/HTTPS-ACCEPTANCE.json", JSON.stringify({ pass: !failure, origin, local_tls_with_test_certificate: localTLS, cases, responses, verifier: "real Rust WebAuthn verifier", authenticator: "virtual CTAP2", hardware_verified: false, document_sha256: createHash("sha256").update(document).digest("hex") }, null, 2) + "\n");
144 }
145 if (failure) process.exitCode = 1;
