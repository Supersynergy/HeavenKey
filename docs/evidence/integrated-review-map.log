133     const finish = await request("/api/recovery/finish", { request_id: start.value.request_id, credential: replacement.registration(start.value.options.publicKey) }); assert.equal(finish.status, 200);
134     assert.equal((await request("/api/session", undefined, o.session)).status, 401);
135     assert.equal((await request("/api/recovery/start", { name: "owner", code: recoveryCode, label: "Replay" })).status, 403);
136     assert.equal((await request("/api/agents/challenge", { id: task, resource: "crm.contacts", action: "Read", arguments: {} })).status, 403);
137     const changed = await login("owner", replacement); assert.equal(changed.account_id, o.account_id); o = changed;
138     const startOld = await request("/api/auth/start", { name: "owner" });
139     const result = await request("/api/auth/finish", { request_id: startOld.value.request_id, credential: owner.assertion(startOld.value.options.publicKey) }); assert.equal(result.status, 401);
140   });
