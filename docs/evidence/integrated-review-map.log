 658 fn invocation_allowed(inner: &Inner, inv: &AgentInvocation) -> ApiResult<AgentGrant> {
 659     let grant = agent_allowed(inner, &inv.id)?;
 660     if inv.resource != grant.spec.resource
 661         || !grant.spec.actions.contains(&inv.action)
 662         || inv.arguments.len() > 4
 663         || inv
 664             .arguments
 665             .iter()
 666             .any(|(k, v)| k.len() > 32 || v.len() > 256 || v.chars().any(char::is_control))
 667     {
 668         return Err(forbidden("agent_scope_denied"));
 669     }
 670     match (inv.resource.as_str(), inv.action) {
 671         ("document", Action::Read) | ("crm.contacts", Action::Read) if inv.arguments.is_empty() => {
 672         }
 673         ("crm.contacts", Action::Write)
 674             if inv.arguments.len() == 2
 675                 && inv
 676                     .arguments
 677                     .get("id")
 678                     .is_some_and(|id| id == "demo-contact")
 679                 && inv.arguments.contains_key("note") => {}
 680         _ => return Err(forbidden("agent_arguments_denied")),
 681     }
 682     Ok(grant)
 683 }
 684 pub(super) async fn agent_challenge(
 685     State(app): State<App>,
 686     Json(input): Json<AgentInvocation>,
 687 ) -> ApiResult<Json<Value>> {
 688     let mut inner = app.inner.lock().map_err(internal)?;
 689     inner.prune();
 690     invocation_allowed(&inner, &input)?;
 691     if inner.platform.invocations.len() >= MAX_PENDING
 692         || inner
 693             .platform
 694             .invocations
 695             .values()
 696             .filter(|x| x.invocation.id == input.id)
 697             .count()
 698             >= 8
 699     {
 700         return Err(ApiError(StatusCode::TOO_MANY_REQUESTS, "challenge_limit"));
 701     }
 702     let mut nonce = [0u8; 32];
 703     rand::rng().fill_bytes(&mut nonce);
 704     let id = Uuid::new_v4().to_string();
 705     let mut message = b"HEAVENKEY-AGENT-INVOKE-v1\0".to_vec();
 706     message.extend(Sha256::digest(app.origin.as_bytes()));
 707     message.extend(nonce);
 708     message.extend(Sha256::digest(
 709         serde_json::to_vec(&input).map_err(internal)?,
 710     ));
 711     let encoded = URL_SAFE_NO_PAD.encode(&message);
 712     inner.platform.invocations.insert(
 713         id.clone(),
 714         AgentChallenge {
 715             invocation: input,
 716             message,
 717             expires: Instant::now() + Duration::from_secs(60),
 718         },
 719     );
 720     Ok(Json(
 721         json!({"challenge_id":id,"message":encoded,"expires_in":60,"algorithm":"Ed25519"}),
 722     ))
 723 }
 724 #[derive(Deserialize)]
 725 #[serde(deny_unknown_fields)]
 726 pub(super) struct AgentProof {
 727     challenge_id: String,
 728     signature: String,
 729 }
 730 pub(super) async fn agent_invoke(
 731     State(app): State<App>,
 732     Json(input): Json<AgentProof>,
 733 ) -> ApiResult<Json<Value>> {
 734     let mut inner = app.inner.lock().map_err(internal)?;
 735     inner.prune();
 736     let pending = inner
 737         .platform
 738         .invocations
 739         .remove(&input.challenge_id)
 740         .ok_or(forbidden("challenge_missing"))?;
 741     let grant = invocation_allowed(&inner, &pending.invocation)?;
 742     let bytes = URL_SAFE_NO_PAD
 743         .decode(&input.signature)
 744         .map_err(|_| forbidden("agent_signature_invalid"))?;
 745     let signature =
 746         Signature::from_slice(&bytes).map_err(|_| forbidden("agent_signature_invalid"))?;
 747     public_key(&grant.spec.public_key)?
 748         .verify_strict(&pending.message, &signature)
 749         .map_err(|_| forbidden("agent_signature_invalid"))?;
 750     let tx = inner.db.transaction().map_err(internal)?;
 751     tx.execute(
 752         "INSERT INTO agent_operations(id,task_id,account_id,created) VALUES(?1,?2,?3,?4)",
 753         params![
 754             input.challenge_id,
 755             grant.id,
 756             grant.account_id,
 757             db_time(now())?
 758         ],
 759     )
 760     .map_err(|_| forbidden("challenge_replayed"))?;
 761     let data = match pending.invocation.resource.as_str() {
 762         "document" => json!({"document":app.document.as_ref()}),
 763         "crm.contacts" => {
 764             tx.execute("INSERT OR IGNORE INTO crm_contacts(account_id,id,name,note) VALUES(?1,'demo-contact','Hotel Alpenblick · Beispiel','Synthetischer Testkontakt')",[&grant.account_id]).map_err(internal)?;
 765             if pending.invocation.action == Action::Write {
 766                 tx.execute(
 767                     "UPDATE crm_contacts SET note=?1 WHERE account_id=?2 AND id='demo-contact'",
 768                     params![pending.invocation.arguments.get("note"), grant.account_id],
 769                 )
 770                 .map_err(internal)?;
 771             }
 772             let contact=tx.query_row("SELECT id,name,note FROM crm_contacts WHERE account_id=?1 AND id='demo-contact'",[&grant.account_id],|r|Ok(json!({"id":r.get::<_,String>(0)?,"name":r.get::<_,String>(1)?,"note":r.get::<_,String>(2)?}))).map_err(internal)?;
 773             json!({"tenant":grant.account_id,"contacts":[contact],"sandbox":true})
 774         }
 775         _ => return Err(forbidden("agent_scope_denied")),
 776     };
 777     audit(
 778         &tx,
 779         &grant.account_id,
 780         if pending.invocation.action == Action::Write {
 781             "agent_write"
 782         } else {
 783             "agent_read"
 784         },
 785         &grant.id,
 786     )?;
 787     tx.commit().map_err(internal)?;
 788     Ok(Json(
 789         json!({"allowed":true,"operation":input.challenge_id,"data":data}),
 790     ))
 791 }
