apps/web/src/vault.ts --- TypeScript
 1 /** Browser-only encryption. PRF outputs and plaintext never enter the API payload. */
 2 export type WrappedKey = { salt: string; nonce: string; ciphertext: string };
 3 export type PasskeyWrap = WrappedKey & { credential_id: string };
 4 export type VaultRecord = { version: 1; nonce: string; ciphertext: string; wraps: PasskeyWrap[]; recovery: WrappedKey };
 5 const encoder = new TextEncoder();
 6 export const random = (size: number): Uint8Array<ArrayBuffer> => crypto.getRandomValues(new Uint8Array(size));
 7 export function encode(value: Uint8Array): string { return btoa(String.fromCharCode(...value)).replaceAll("+", "-").replaceAll("/", "_").replace(/=+$/, ""); }
 8 export function decode(value: string): Uint8Array<ArrayBuffer> {
 9   if (!/^[A-Za-z0-9_-]+$/.test(value)) throw new Error("Ungültige Schlüsselkodierung.");
10   const bytes = Uint8Array.from(atob(value.replaceAll("-", "+").replaceAll("_", "/")), c => c.charCodeAt(0));
11   if (encode(bytes) !== value) throw new Error("Ungültige Schlüsselkodierung.");
12   return bytes;
13 }
14 const aad = (account: string, purpose: string) => encoder.encode(`HEAVENKEY-VAULT-v1\0${account}\0${purpose}`);
15 async function aes(bytes: Uint8Array<ArrayBuffer>, usage: KeyUsage[]): Promise<CryptoKey> { return crypto.subtle.importKey("raw", bytes, { name: "AES-GCM" }, false, usage); }
16 async function wrappingKey(secret: Uint8Array<ArrayBuffer>, salt: Uint8Array<ArrayBuffer>): Promise<CryptoKey> {
17   if (secret.length !== 32 || salt.length !== 32) throw new Error("Schlüssel muss 32 Bytes enthalten.");
18   const source = await crypto.subtle.importKey("raw", secret, "HKDF", false, ["deriveKey"]);
19   return crypto.subtle.deriveKey({ name: "HKDF", hash: "SHA-256", salt, info: encoder.encode("HeavenKey vault key wrapping v1") }, source, { name: "AES-GCM", length: 256 }, false, ["encrypt", "decrypt"]);
20 }
21 export async function wrap(dataKey: Uint8Array<ArrayBuffer>, secret: Uint8Array<ArrayBuffer>, salt: Uint8Array<ArrayBuffer>, account: string, identity: string): Promise<WrappedKey> {
22   if (dataKey.length !== 32) throw new Error("Ungültiger Tresorschlüssel.");
23   const nonce = random(12);
24   const ciphertext = await crypto.subtle.encrypt({ name: "AES-GCM", iv: nonce, additionalData: aad(account, identity) }, await wrappingKey(secret, salt), dataKey);
25   return { salt: encode(salt), nonce: encode(nonce), ciphertext: encode(new Uint8Array(ciphertext)) };
26 }
27 export async function unwrap(record: WrappedKey, secret: Uint8Array<ArrayBuffer>, account: string, identity: string): Promise<Uint8Array<ArrayBuffer>> {
28   const plain = await crypto.subtle.decrypt({ name: "AES-GCM", iv: decode(record.nonce), additionalData: aad(account, identity) }, await wrappingKey(secret, decode(record.salt)), decode(record.ciphertext));
29   const bytes = new Uint8Array(plain);
30   if (bytes.length !== 32) throw new Error("Ungültiger Tresorschlüssel.");
31   return bytes;
32 }
33 export async function seal(text: string, key: Uint8Array<ArrayBuffer>, account: string): Promise<{ nonce: string; ciphertext: string }> {
34   const plain = encoder.encode(text);
35   if (plain.length > 4096) throw new Error("Der Pilot speichert höchstens 4096 UTF-8-Bytes.");
36   const nonce = random(12);
37   const ciphertext = await crypto.subtle.encrypt({ name: "AES-GCM", iv: nonce, additionalData: aad(account, "data") }, await aes(key, ["encrypt"]), plain);
38   return { nonce: encode(nonce), ciphertext: encode(new Uint8Array(ciphertext)) };
39 }
40 export async function open(record: Pick<VaultRecord, "nonce" | "ciphertext">, key: Uint8Array<ArrayBuffer>, account: string): Promise<string> {
41   const plain = await crypto.subtle.decrypt({ name: "AES-GCM", iv: decode(record.nonce), additionalData: aad(account, "data") }, await aes(key, ["decrypt"]), decode(record.ciphertext));
42   return new TextDecoder("utf-8", { fatal: true }).decode(plain);
43 }
