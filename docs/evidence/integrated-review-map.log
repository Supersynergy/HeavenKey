    417 async function prf(credentialId: string, salt: Uint8Array<ArrayBuffer>): Promise<Uint8Array<ArrayBuffer>> {
    418   if (!sessionName) throw new Error("Bitte zuerst anmelden.");
    419   const start = await api<Ceremony<PublicKeyCredentialRequestOptionsJSON>>("/api/auth/start", { name: sessionName });
    420   const options = start.options.publicKey;
    421   const controller = new AbortController(); nativeAbort = controller;
    422   const key = await passkeyRequest(async () => {
    423     try {
    424       return await navigator.credentials.get({ signal: controller.signal, publicKey: {
    425         challenge: vaultCrypto.decode(options.challenge), rpId: options.rpId, timeout: 60000, userVerification: "required",
    426         allowCredentials: [{ id: vaultCrypto.decode(credentialId), type: "public-key" }],
    427         extensions: { prf: { eval: { first: salt } } } as AuthenticationExtensionsClientInputs,
    428       } }) as PublicKeyCredential | null;
    429     } finally { nativeAbort = undefined; }
    430   });
    431   if (!key) throw new Error("Passkey-Abfrage wurde abgebrochen.");
    432   const response = key.response as AuthenticatorAssertionResponse;
    433   const credential = {
    434     id: key.id, rawId: vaultCrypto.encode(new Uint8Array(key.rawId)), type: key.type,
    435     response: { clientDataJSON: vaultCrypto.encode(new Uint8Array(response.clientDataJSON)), authenticatorData: vaultCrypto.encode(new Uint8Array(response.authenticatorData)), signature: vaultCrypto.encode(new Uint8Array(response.signature)), userHandle: response.userHandle ? vaultCrypto.encode(new Uint8Array(response.userHandle)) : null },
    436     clientExtensionResults: {}, ...(key.authenticatorAttachment ? { authenticatorAttachment: key.authenticatorAttachment } : {}),
    437   };
    438   setSession(await api<Record<string, unknown>>("/api/auth/finish", { request_id: start.request_id, credential }));
    439   const result = key.getClientExtensionResults() as { prf?: { results?: { first?: ArrayBuffer } } };
    440   if (!result.prf?.results?.first || result.prf.results.first.byteLength !== 32) throw new Error("Dieser Passkey oder Browser bietet hier kein PRF. Deine normale Passkey-Anmeldung funktioniert weiterhin. Nutze für den Tresor ein PRF-fähiges Gerät.");
    441   return new Uint8Array(result.prf.results.first);
    442 }
