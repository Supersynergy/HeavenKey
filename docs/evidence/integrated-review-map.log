453         })
454         .collect();
455     let invocation_fixtures: Vec<Value> = fixtures
456         .invocations
457         .iter()
458         .map(|(name, i)| {
459             json!({
460                 "name": name,
461                 "invocation": serde_json::to_value(i).unwrap(),
462                 "message_hex": body_message(INVOKE_DOMAIN, &i.body),
463             })
464         })
465         .collect();
466     let grant_cases = json!([
467         {"name": "authorize_ok", "grant": "root", "holder": hex(&public(&key(2))), "resource": RESOURCE, "action": "Read", "now": NOW, "expect": "ok"},
468         {"name": "authorize_write", "grant": "root", "holder": hex(&public(&key(2))), "resource": RESOURCE, "action": "Write", "now": NOW, "expect": "ok"},
469         {"name": "authorize_revoked", "grant": "root", "holder": hex(&public(&key(2))), "resource": RESOURCE, "action": "Read", "now": NOW, "revoked": true, "expect": "Revoked"},
470         {"name": "authorize_wrong_holder", "grant": "root", "holder": hex(&public(&key(3))), "resource": RESOURCE, "action": "Read", "now": NOW, "expect": "Invocation"},
471         {"name": "authorize_wrong_action", "grant": "root", "holder": hex(&public(&key(2))), "resource": RESOURCE, "action": "Unlock", "now": NOW, "expect": "Invocation"},
472         {"name": "authorize_wrong_resource", "grant": "root", "holder": hex(&public(&key(2))), "resource": "urn:demo:tool:beta", "action": "Read", "now": NOW, "expect": "Invocation"},
473         {"name": "authorize_expired_boundary", "grant": "root", "holder": hex(&public(&key(2))), "resource": RESOURCE, "action": "Read", "now": 1000, "expect": "Time"},
474         {"name": "authorize_not_yet", "grant": "future_root", "holder": hex(&public(&key(2))), "resource": RESOURCE, "action": "Read", "now": 49, "expect": "Time"},
475         {"name": "authorize_wrong_root", "grant": "foreign_root", "holder": hex(&public(&key(2))), "resource": RESOURCE, "action": "Read", "now": NOW, "expect": "UntrustedRoot"},
476         {"name": "authorize_parent_set", "grant": "child", "holder": hex(&public(&key(3))), "resource": RESOURCE, "action": "Read", "now": NOW, "expect": "UntrustedRoot"},
477         {"name": "authorize_oversized", "grant": "oversized", "holder": hex(&public(&key(3))), "resource": "urn:demo:tool:alpha", "action": "Read", "now": NOW, "expect": "Limits"},
478         {"name": "authorize_bad_signature", "grant": "bad_signature", "holder": hex(&public(&key(3))), "resource": RESOURCE, "action": "Read", "now": NOW, "expect": "Signature"},
479     ]);
480     json!({
481         "version": 1,
482         "profile": "heavenkey-grant-v0",
483         "domains": {"grant": "UAC-AUDIT-GRANT-v0\\0", "invoke": "UAC-AUDIT-INVOKE-v0\\0"},
484         "limits": {"max_chain": MAX_CHAIN, "max_grant_bytes": MAX_GRANT_BYTES, "invocation_window_seconds": 30},
485         "trusted_root": hex(&public(&key(1))),
486         "resource": RESOURCE,
487         "fixtures": grant_fixtures,
488         "invocations": invocation_fixtures,
489         "cases": cases,
490         "grant_cases": grant_cases,
491     })
