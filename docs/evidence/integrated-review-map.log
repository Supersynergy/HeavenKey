scripts/firefox_e2e.py --- Python
  1 """Firefox UI + extension acceptance using disposable WebDriver virtual authenticators."""
  2 import base64
  3 import json
  4 import os
  5 from pathlib import Path
  6 import socket
  7 import shutil
  8 import subprocess
  9 import tempfile
 10 import time
 11 import urllib.error
 12 import urllib.request
 13
 14 ROOT = Path(__file__).resolve().parent.parent
 15 ORIGIN = 'http://localhost:18247'
 16 OUT = ROOT / 'docs/images/screenshots'
 17 EVIDENCE = ROOT / 'docs/evidence'
 18 ELEMENT = 'element-6066-11e4-a52e-4f735466cecf'
 19
 20
 21 def http(url, method='GET', body=None):
 22     data = None if body is None else json.dumps(body).encode()
 23     request = urllib.request.Request(url, data=data, method=method, headers={'Content-Type':'application/json', **({'Origin':ORIGIN} if url.startswith(ORIGIN + '/') else {})})
 24     try:
 25         with urllib.request.urlopen(request, timeout=20) as response:
 26             return json.load(response)
 27     except urllib.error.HTTPError as error:
 28         raise RuntimeError(f'HTTP {error.code}: {error.read().decode()[:1000]}') from error
 29
 30
 31 def wait(check, seconds=15):
 32     deadline = time.monotonic() + seconds
 33     while time.monotonic() < deadline:
 34         result = check()
 35         if result:
 36             return result
 37         time.sleep(.05)
 38     raise RuntimeError('Firefox UI wait timed out')
 39
 40
 41 def main():
 42     OUT.mkdir(parents=True, exist_ok=True)
 43     EVIDENCE.mkdir(parents=True, exist_ok=True)
 44     cases = []
 45     with tempfile.TemporaryDirectory(prefix='heavenkey-firefox-ui-') as temporary:
 46         temp = Path(temporary)
 47         key = temp / 'protection.key'; key.write_bytes(os.urandom(32)); key.chmod(0o600)
 48         data = temp / 'data'
 49         env = dict(os.environ, HEAVENKEY_KEY_FILE=str(key), HEAVENKEY_ORIGIN=ORIGIN, HEAVENKEY_RP_ID="localhost")
 50         binary = Path(env.get('HEAVENKEY_BINARY', ROOT / 'target/debug/uac-api')).resolve()
 51         driver_path = env.get('GECKODRIVER_PATH', 'geckodriver')
 52         firefox = env.get('FIREFOX_PATH', 'firefox')
 53         with socket.socket() as probe:
 54             probe.bind(('127.0.0.1', 0)); port = probe.getsockname()[1]
 55         base = f'http://localhost:{port}'
 56         server = driver = None; session_id = None; passed = False
 57         with (temp/'api.log').open('w') as api_log, (temp/'webdriver.log').open('w') as driver_log:
 58             try:
 59                 server = subprocess.Popen([str(binary),'--data-dir',str(data),'--port','18247'],env=env,stdout=api_log,stderr=api_log)
 60                 def server_ready():
 61                     if server.poll() is not None: raise RuntimeError((temp/'api.log').read_text())
 62                     try:return http(ORIGIN+'/health').get('status')=='ok'
 63                     except (OSError,RuntimeError):return False
 64                 wait(server_ready)
 65                 driver = subprocess.Popen([driver_path,'--host','127.0.0.1','--port',str(port)],env=env,stdout=driver_log,stderr=driver_log)
 66                 def driver_ready():
 67                     if driver.poll() is not None:raise RuntimeError((temp/'webdriver.log').read_text())
 68                     try:return http(base+'/status').get('value',{}).get('ready')
 69                     except OSError:return False
 70                 wait(driver_ready)
 71                 extension_uuid = 'c58d4770-783f-4ccf-b511-32ed00d01d6b'
 72                 created = http(base+'/session','POST',{'capabilities':{'alwaysMatch':{'browserName':'firefox','moz:firefoxOptions':{'binary':firefox,'args':['-headless'],'prefs':{'extensions.webextensions.uuids':json.dumps({'heavenkey@supersynergy.local':extension_uuid}),'browser.download.folderList':2,'browser.download.dir':str(temp/'downloads'),'browser.helperApps.neverAsk.saveToDisk':'application/json'}}}}})['value']
 73                 session_id = created['sessionId']; root = base+'/session/'+session_id
 74                 def command(path,body=None,method=None):return http(root+path,method or ('GET' if body is None else 'POST'),body).get('value')
 75                 def js(source,*args):return command('/execute/sync',{'script':source,'args':list(args)})
 76                 def text(identity):return js('return document.getElementById(arguments[0]).textContent;',identity)
 77                 def click(identity):
 78                     found=command('/element',{'using':'css selector','value':'#'+identity})
 79                     command('/element/'+found[ELEMENT]+'/click',{})
 80                 def fill(identity,value):js('const e=document.getElementById(arguments[0]);e.value=arguments[1];e.dispatchEvent(new Event("input",{bubbles:true}));e.dispatchEvent(new Event("change",{bubbles:true}));',identity,value)
 81                 def ready():return js('return document.documentElement.dataset.ready === "true";')
 82                 def screenshot(name,section=None):
 83                     if section:js('document.getElementById(arguments[0]).scrollIntoView({block:"start"});',section)
 84                     time.sleep(.1)
 85                     (OUT/name).write_bytes(base64.b64decode(command('/screenshot')))
 86                 def case(name):cases.append({'name':name,'pass':True});print('PASS '+name,flush=True)
 87                 options={'protocol':'ctap2','transport':'internal','hasResidentKey':True,'hasUserVerification':True,'isUserConsenting':True,'isUserVerified':True}
 88                 auth=command('/webauthn/authenticator',options)
 89                 command('/window/rect',{'width':1360,'height':1000})
 90                 command('/url',{'url':ORIGIN});wait(ready)
 91                 assert js('return isSecureContext && typeof PublicKeyCredential === "function";')
 92                 assert not js('return document.documentElement.scrollWidth > innerWidth;')
 93                 screenshot('firefox-01-start.png')
 94                 case('Firefox loads the actual interface without horizontal overflow')
 95                 fill('bootstrap',(data/'owner-bootstrap.txt').read_text().strip())
 96                 click('register');wait(lambda:'eingeschrieben' in text('status'))
 97                 click('login');wait(lambda:'Eigentümer' in text('identity'))
 98                 wait(lambda:not js('return document.getElementById("recovery-rotate").disabled;'))
 99                 case('Native navigator.credentials registration and login pass the Rust verifier')
100                 click('recovery-rotate');wait(lambda:js('return document.getElementById("management-dialog").open;'))
101                 screenshot('firefox-02-confirmation.png')
102                 click('management-confirm');wait(lambda:'Neuer Einmalcode' in text('recovery-created'))
103                 click('recovery-download')
104                 kit_path=wait(lambda:next((temp/'downloads').glob('heavenkey-recovery-*.json'),None))
105                 kit=json.loads(kit_path.read_text());assert kit['account_recovery_code'].startswith('hk-recovery-v1.')
106                 screenshot('firefox-03-recovery.png','recovery')
107                 case('Exact-action passkey confirmation creates and downloads the recovery kit')
108                 fill('credential-label','Virtueller Ersatz-Passkey');click('credential-add')
109                 wait(lambda:js('return document.getElementById("management-dialog").open;'));click('management-confirm')
110                 wait(lambda:'hinzugefügt' in text('status'))
111                 case('A second virtual passkey is added through the actual interface')
112                 runtime=shutil.which('node') or shutil.which('bun')
113                 if not runtime: raise RuntimeError('Node.js or Bun is required for the agent example')
114                 agent_file=temp/'agent.pem'
115                 generated=json.loads(subprocess.check_output([runtime,str(ROOT/'scripts/agent.mjs'),'keygen',str(agent_file)],text=True,timeout=10))
116                 public=generated['public_key']
117                 fill('agent-public',public);fill('agent-name','Hotel-Assistent · Beispiel')
118                 click('agent-create');wait(lambda:js('return document.getElementById("management-dialog").open;'));click('management-confirm')
119                 wait(lambda:'Agentenauftrag freigegeben' in text('status'))
120                 task=json.loads(text('result'))['task_id']
121                 invoked=json.loads(subprocess.check_output([runtime,str(ROOT/'scripts/agent.mjs'),'read',str(agent_file),task,'--origin',ORIGIN],text=True,timeout=15))
122                 assert invoked['allowed']
