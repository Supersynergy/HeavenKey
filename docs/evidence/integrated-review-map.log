crates/verifier/tests/delegation_v1_edge.rs --- Rust
  1 //! Extended edge-case parity tests for the heavenkey-delegation-v1 vectors.
  2 //!
  3 //! Loads the same independent TypeScript vectors as the unit tests and asserts
  4 //! exact message/id/signature parity plus every deny expectation, including the
  5 //! extended deep-chain, boundary and malformed-JSON coverage.
  6
  7 use ed25519_dalek::SigningKey;
  8 use serde::Deserialize;
  9 use serde_json::Value;
 10 use std::collections::{BTreeMap, BTreeSet};
 11 use uac_verifier::delegation::{
 12     Context, DelegationGrant, decode, id, message, sign, verify_chain, verify_structure,
 13 };
 14 use uac_verifier::{Action, Error, Signed};
 15
 16 #[derive(Deserialize)]
 17 struct Vectors {
 18     seed_byte: u8,
 19     trusted_issuer: [u8; 32],
 20     fixtures: Vec<Fixture>,
 21     cases: Vec<Case>,
 22     invalid_json: Vec<InvalidJson>,
 23     #[serde(default)]
 24     equivalent_json: Vec<EquivalentJson>,
 25 }
 26
 27 #[derive(Deserialize)]
 28 struct Fixture {
 29     name: String,
 30     grant: Value,
 31     message_hex: Option<String>,
 32     id_hex: Option<String>,
 33 }
 34
 35 #[derive(Deserialize)]
 36 struct Case {
 37     name: String,
 38     chain: Vec<String>,
 39     audience: [u8; 32],
 40     resource: String,
 41     action: Action,
 42     now: u64,
 43     revoked: Vec<String>,
 44     allowed: bool,
 45     expect_error: Option<String>,
 46     issuer: Option<[u8; 32]>,
 47 }
 48
 49 #[derive(Deserialize)]
 50 struct InvalidJson {
 51     name: String,
 52     json: String,
 53 }
 54
 55 #[derive(Deserialize)]
 56 struct EquivalentJson {
 57     name: String,
 58     fixture: String,
 59     json: String,
 60 }
 61
 62 fn vectors() -> Vectors {
 63     serde_json::from_str(include_str!("../../../docs/vectors/delegation-v1.json"))
 64         .expect("independent TypeScript vectors")
 65 }
 66
 67 fn hex(bytes: &[u8]) -> String {
 68     bytes.iter().map(|byte| format!("{byte:02x}")).collect()
 69 }
 70
 71 fn unhex<const N: usize>(value: &str) -> [u8; N] {
 72     assert_eq!(value.len(), N * 2);
 73     std::array::from_fn(|i| u8::from_str_radix(&value[i * 2..i * 2 + 2], 16).expect("fixture hex"))
 74 }
 75
 76 fn fixture_grants<'a>(
 77     fixtures: &'a BTreeMap<String, &'a Fixture>,
 78     names: &[String],
 79 ) -> Result<Vec<Signed<DelegationGrant>>, Error> {
 80     names
 81         .iter()
 82         .map(|name| {
 83             decode(
 84                 &serde_json::to_vec(&fixtures.get(name).expect("named fixture").grant)
 85                     .expect("fixture JSON"),
 86             )
 87         })
 88         .collect()
 89 }
 90
 91 fn expected_error(name: &str) -> Error {
 92     match name {
 93         "Encoding" => Error::Encoding,
 94         "Limits" => Error::Limits,
 95         "Signature" => Error::Signature,
 96         "UntrustedRoot" => Error::UntrustedRoot,
 97         "Chain" => Error::Chain,
 98         "Escalation" => Error::Escalation,
 99         "Time" => Error::Time,
100         "Revoked" => Error::Revoked,
101         "Invocation" => Error::Invocation,
102         other => panic!("unknown expected error {other}"),
103     }
104 }
105
106 #[test]
107 fn edge_fixture_messages_ids_and_signatures_match() {
108     let vectors = vectors();
109     let signer = SigningKey::from_bytes(&[vectors.seed_byte; 32]);
110     assert_eq!(signer.verifying_key().to_bytes(), vectors.trusted_issuer);
111     for fixture in vectors.fixtures {
112         let bytes = serde_json::to_vec(&fixture.grant).expect("fixture JSON");
113         let decoded = decode(&bytes);
114         if let Some(expected_message) = fixture.message_hex {
115             let grant = decoded.unwrap_or_else(|error| panic!("{}: {error:?}", fixture.name));
116             assert_eq!(
117                 hex(&message(&grant.body).expect("valid message")),
118                 expected_message,
119                 "{} message",
120                 fixture.name
121             );
122             assert_eq!(
123                 hex(&id(&grant).expect("valid ID")),
124                 fixture.id_hex.expect("ID"),
125                 "{} ID",
126                 fixture.name
127             );
128             let resigned = sign(&signer, grant.body.clone());
129             if grant.body.issuer != vectors.trusted_issuer {
130                 assert_eq!(
131                     resigned.err(),
132                     Some(Error::UntrustedRoot),
133                     "{} foreign issuer must not sign",
134                     fixture.name
135                 );
136             } else if fixture.name == "bad_signature" {
137                 assert_ne!(
138                     resigned.expect("resign").signature,
139                     grant.signature,
140                     "{} tampered signature",
141                     fixture.name
142                 );
143             } else {
144                 assert_eq!(
145                     resigned.expect("resign").signature,
146                     grant.signature,
147                     "{} signature",
148                     fixture.name
149                 );
150             }
151         } else {
152             assert!(
153                 decoded.is_err(),
154                 "{} rejects invalid encoding",
155                 fixture.name
156             );
157         }
158     }
159 }
160
161 #[test]
162 fn edge_chain_allow_and_deny_cases_match() {
163     let vectors = vectors();
164     let fixtures: BTreeMap<String, &Fixture> = vectors
165         .fixtures
166         .iter()
167         .map(|fixture| (fixture.name.clone(), fixture))
168         .collect();
169     assert!(vectors.cases.len() >= 50, "extended case coverage present");
170     for case in vectors.cases {
171         let revoked: BTreeSet<[u8; 32]> = case.revoked.iter().map(|id| unhex::<32>(id)).collect();
172         let root = case.issuer.as_ref().unwrap_or(&vectors.trusted_issuer);
173         let outcome = fixture_grants(&fixtures, &case.chain).and_then(|chain| {
174             verify_chain(
175                 &chain,
176                 Context {
177                     root,
178                     verified_holder: &case.audience,
179                     resource: &case.resource,
180                     action: case.action,
181                     now: case.now,
182                     revoked: &revoked,
183                 },
184             )
185         });
186         assert_eq!(outcome.is_ok(), case.allowed, "{}", case.name);
187         if let Some(expected) = &case.expect_error {
188             assert_eq!(
189                 outcome.expect_err("denied case"),
190                 expected_error(expected),
191                 "{} error kind",
192                 case.name
193             );
194         }
195     }
196 }
197
198 #[test]
199 fn edge_deep_chain_structure_variants() {
200     let vectors = vectors();
201     let fixtures: BTreeMap<String, &Fixture> = vectors
202         .fixtures
203         .iter()
204         .map(|fixture| (fixture.name.clone(), fixture))
205         .collect();
206     let names = |names: &[&str]| {
207         names
208             .iter()
209             .map(|name| name.to_string())
210             .collect::<Vec<_>>()
211     };
212     let four = fixture_grants(&fixtures, &names(&["a1", "a2", "a3", "a4"])).expect("four links");
213     let five =
214         fixture_grants(&fixtures, &names(&["b1", "b2", "b3", "b4", "b5"])).expect("five links");
215     assert!(verify_structure(&four, &vectors.trusted_issuer).is_ok());
216     assert!(verify_structure(&five, &vectors.trusted_issuer).is_ok());
217     assert_eq!(five.len(), 5);
218     assert_eq!(five.last().expect("leaf").body.remaining_delegations, 0);
219     let six = fixture_grants(
220         &fixtures,
221         &names(&["depth_1", "depth_2", "depth_3", "depth_4", "six_5", "six_6"]),
222     )
223     .expect("six links decode");
224     assert_eq!(
225         verify_structure(&six, &vectors.trusted_issuer),
226         Err(Error::Limits)
227     );
228     let skipped = fixture_grants(&fixtures, &names(&["root", "grandchild"])).expect("decodes");
229     assert_eq!(
230         verify_structure(&skipped, &vectors.trusted_issuer),
231         Err(Error::Chain)
232     );
233     let doubled_root =
234         fixture_grants(&fixtures, &names(&["root", "second_root"])).expect("decodes");
235     assert_eq!(
236         verify_structure(&doubled_root, &vectors.trusted_issuer),
237         Err(Error::Chain)
238     );
239     let exhausted =
240         fixture_grants(&fixtures, &names(&["exhausted_root", "exhausted_child"])).expect("decodes");
241     assert_eq!(
242         verify_structure(&exhausted, &vectors.trusted_issuer),
243         Err(Error::Escalation)
244     );
245     let two_hop_cycle =
246         fixture_grants(&fixtures, &names(&["a1", "a2", "a3", "a4_cycle"])).expect("decodes");
247     assert_eq!(
248         verify_structure(&two_hop_cycle, &vectors.trusted_issuer),
249         Err(Error::Chain)
250     );
251     let root_only = fixture_grants(&fixtures, &names(&["root"])).expect("decodes");
252     let foreign_root = SigningKey::from_bytes(&[8; 32]).verifying_key().to_bytes();
253     assert_eq!(
254         verify_structure(&root_only, &foreign_root),
255         Err(Error::UntrustedRoot)
256     );
257 }
258
259 #[test]
260 fn edge_invalid_json_vectors_are_rejected() {
261     let vectors = vectors();
262     assert!(
263         vectors.invalid_json.len() >= 25,
264         "extended malformed coverage"
265     );
266     for invalid in vectors.invalid_json {
267         assert!(decode(invalid.json.as_bytes()).is_err(), "{}", invalid.name);
268     }
269 }
270
271 #[test]
272 fn edge_equivalent_json_serializations_keep_id_and_message() {
273     let vectors = vectors();
274     let fixtures: BTreeMap<String, &Fixture> = vectors
275         .fixtures
276         .iter()
277         .map(|fixture| (fixture.name.clone(), fixture))
278         .collect();
279     assert!(!vectors.equivalent_json.is_empty());
280     for entry in vectors.equivalent_json {
281         let decoded = decode(entry.json.as_bytes())
282             .unwrap_or_else(|error| panic!("{}: {error:?}", entry.name));
283         let fixture = fixtures.get(&entry.fixture).expect("named fixture");
284         assert_eq!(
285             hex(&message(&decoded.body).expect("message")),
286             fixture.message_hex.clone().expect("fixture message"),
287             "{} message",
288             entry.name
289         );
290         assert_eq!(
291             hex(&id(&decoded).expect("ID")),
292             fixture.id_hex.clone().expect("fixture ID"),
293             "{} ID",
294             entry.name
295         );
296     }
297 }
