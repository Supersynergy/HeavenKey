 21 fn hex_decode(text: &str) -> Result<Vec<u8>, Box<dyn std::error::Error>> {
 22     let text = text.trim();
 23     if !text.len().is_multiple_of(2) || !text.bytes().all(|byte| byte.is_ascii_hexdigit()) {
 24         return Err("store key must be hex".into());
 25     }
 26     (0..text.len())
 27         .step_by(2)
 28         .map(|index| u8::from_str_radix(&text[index..index + 2], 16).map_err(Into::into))
 29         .collect()
 30 }
 31
 32 fn key_dir(os: &str, lookup: impl Fn(&str) -> Option<OsString>) -> Option<PathBuf> {
 33     let nonempty = |name: &str| lookup(name).filter(|value| !value.is_empty());
 34     match os {
 35         "windows" => nonempty("LOCALAPPDATA").map(PathBuf::from),
 36         "macos" => {
 37             nonempty("HOME").map(|home| PathBuf::from(home).join("Library/Application Support"))
 38         }
 39         _ => match nonempty("XDG_CONFIG_HOME") {
 40             Some(path) => Some(PathBuf::from(path)),
 41             None => nonempty("HOME").map(|home| PathBuf::from(home).join(".config")),
 42         },
 43     }
 44     .map(|base| base.join("heavenkey"))
 45 }
 46
 47 fn key_file_path() -> Result<PathBuf, Box<dyn std::error::Error>> {
 48     if let Some(path) = std::env::var_os("UAC_STORE_KEY_FILE").filter(|v| !v.is_empty()) {
 49         return Ok(PathBuf::from(path));
 50     }
 51     Ok(key_dir(std::env::consts::OS, |name| std::env::var_os(name))
 52         .ok_or("no config directory for the store key; set UAC_STORE_KEY or UAC_STORE_KEY_FILE")?
 53         .join("store.key"))
 54 }
 55
 56 fn write_new_key(path: &Path) -> Result<[u8; 32], Box<dyn std::error::Error>> {
 57     if let Some(parent) = path.parent() {
 58         fs::create_dir_all(parent)?;
 59         #[cfg(unix)]
 60         {
 61             use std::os::unix::fs::PermissionsExt;
 62             fs::set_permissions(parent, fs::Permissions::from_mode(0o700))?;
 63         }
 64     }
 65     let mut bytes = [0; 32];
 66     rand::rng().fill_bytes(&mut bytes);
 67     let mut options = fs::OpenOptions::new();
 68     options.write(true).create_new(true);
 69     #[cfg(unix)]
 70     {
 71         use std::os::unix::fs::OpenOptionsExt;
 72         options.mode(0o600);
 73     }
 74     let mut file = options.open(path)?;
 75     use std::io::Write;
 76     file.write_all(&bytes)?;
 77     file.sync_all()?;
 78     Ok(bytes)
 79 }
 80
 81 fn resolve_key() -> Result<[u8; 32], Box<dyn std::error::Error>> {
 82     if let Ok(value) = std::env::var("UAC_STORE_KEY") {
 83         let bytes = hex_decode(&value)?;
 84         return bytes
 85             .try_into()
 86             .map_err(|_| "UAC_STORE_KEY must be 64 hex characters".into());
 87     }
 88     let path = key_file_path()?;
 89     let bytes = if path.exists() {
 90         fs::read(&path)?
 91     } else {
 92         write_new_key(&path)?.to_vec()
 93     };
 94     bytes
 95         .try_into()
 96         .map_err(|_| format!("invalid store key length in {}", path.display()).into())
 97 }
 98
 99 fn is_plaintext(db_path: &Path) -> Result<bool, Box<dyn std::error::Error>> {
100     if !db_path.exists() {
101         return Ok(false);
102     }
103     let mut header = [0; 16];
104     use std::io::Read;
105     let mut file = fs::File::open(db_path)?;
106     let read = file.read(&mut header)?;
107     Ok(read == 16 && &header == PLAINTEXT_HEADER)
108 }
109
110 fn key_pragma(key: &[u8; 32]) -> String {
111     format!("PRAGMA key = \"x'{}'\";", hex_encode(key))
112 }
113
114 fn open_encrypted(
115     db_path: &Path,
116     key: &[u8; 32],
117 ) -> Result<Connection, Box<dyn std::error::Error>> {
118     let db = Connection::open(db_path)?;
119     db.execute_batch(&key_pragma(key))?;
120     db.query_row("SELECT count(*) FROM sqlite_master", [], |_| Ok(()))
121         .map_err(
122             |_| "store key rejected: data could not be decrypted (wrong key or corrupt store)",
123         )?;
124     Ok(db)
125 }
126
127 fn migrate_plaintext(db_path: &Path, key: &[u8; 32]) -> Result<(), Box<dyn std::error::Error>> {
128     let temp = db_path.with_file_name(format!(
129         "{}.enc-tmp",
130         db_path.file_name().unwrap_or_default().to_string_lossy()
131     ));
132     if temp.exists() {
133         fs::remove_file(&temp)?;
134     }
135     {
136         let plain = Connection::open(db_path)?;
137         plain.execute_batch("PRAGMA wal_checkpoint(TRUNCATE);")?;
138         plain.execute_batch(&format!(
139             "ATTACH DATABASE '{}' AS enc KEY \"x'{}'\"; SELECT sqlcipher_export('enc'); DETACH DATABASE enc;",
140             temp.to_string_lossy().replace('\'', "''"),
141             hex_encode(key)
142         ))?;
143     }
144     fs::rename(&temp, db_path)?;
145     for side in ["-wal", "-shm"] {
146         let side = db_path.with_file_name(format!(
147             "{}{}",
148             db_path.file_name().unwrap_or_default().to_string_lossy(),
149             side
150         ));
151         if side.exists() {
152             fs::remove_file(&side)?;
153         }
154     }
155     Ok(())
156 }
157
158 fn custody_issuer(
159     db: &Connection,
160     data: &Path,
161     generate: impl Fn() -> [u8; 32],
162 ) -> Result<SigningKey, Box<dyn std::error::Error>> {
163     let mut stored: Option<Vec<u8>> = db
164         .query_row("SELECT value FROM meta WHERE key='issuer_key'", [], |row| {
165             row.get(0)
166         })
167         .optional()?;
168     let key_path = data.join("issuer.key");
169     if key_path.exists() {
170         let bytes = fs::read(&key_path)?;
171         match &stored {
172             Some(existing) if *existing != bytes => {
173                 return Err(
174                     "conflicting issuer custody: meta key and issuer.key file differ".into(),
175                 );
176             }
177             Some(_) => {}
178             None => {
179                 db.execute(
180                     "INSERT INTO meta(key,value) VALUES('issuer_key',?1)",
181                     params![bytes.clone()],
182                 )?;
183                 stored = Some(bytes);
184             }
185         }
186         fs::remove_file(&key_path)?;
187     }
188     let bytes = match stored {
189         Some(existing) => existing,
190         None => {
191             let bytes = generate().to_vec();
192             db.execute(
193                 "INSERT INTO meta(key,value) VALUES('issuer_key',?1)",
194                 params![bytes],
195             )?;
196             bytes
197         }
198     };
199     let bytes: [u8; 32] = bytes
200         .try_into()
201         .map_err(|_| "invalid issuer key length in store")?;
202     Ok(SigningKey::from_bytes(&bytes))
203 }
204
205 fn open_database(data: &Path, key: &[u8; 32]) -> Result<Connection, Box<dyn std::error::Error>> {
206     let db_path = data.join("uac.sqlite");
207     if is_plaintext(&db_path)? {
208         migrate_plaintext(&db_path, key)?;
209     }
210     let db = open_encrypted(&db_path, key)?;
211     db.execute_batch("PRAGMA journal_mode=WAL; PRAGMA foreign_keys=ON;")?;
212     db.execute_batch("CREATE TABLE IF NOT EXISTS meta(key TEXT PRIMARY KEY,value BLOB NOT NULL);")?;
213     Ok(db)
214 }
215
216 #[cfg(test)]
217 fn open_with_key(data: &Path, key: &[u8; 32]) -> Result<Store, Box<dyn std::error::Error>> {
218     let db = open_database(data, key)?;
219     let issuer = custody_issuer(&db, data, || {
220         let mut bytes = [0; 32];
221         rand::rng().fill_bytes(&mut bytes);
222         bytes
223     })?;
224     Ok(Store { db, issuer })
225 }
226
227 pub fn open(data: &Path) -> Result<Store, Box<dyn std::error::Error>> {
228     let key = resolve_key()?;
229     let db = open_database(data, &key)?;
230     let stored: Option<Vec<u8>> = db
231         .query_row("SELECT value FROM meta WHERE key='issuer_key'", [], |row| {
232             row.get(0)
233         })
234         .optional()?;
235     let imported: Option<[u8; 32]> = stored
236         .map(|bytes| {
237             bytes
238                 .try_into()
239                 .map_err(|_| "invalid issuer key length in store")
240         })
241         .transpose()?;
242     let key_file = std::env::var_os("HEAVENKEY_KEY_FILE").map(PathBuf::from);
243     let bytes = uac_keystore::load_issuer_with_seed(data, key_file.as_deref(), imported.as_ref())?;
244     let issuer = custody_issuer(&db, data, || *bytes)?;
245     Ok(Store { db, issuer })
246 }
247
248 fn json_to_param(value: &Value) -> rusqlite::types::Value {
249     match value {
250         Value::Null => rusqlite::types::Value::Null,
251         Value::Bool(v) => rusqlite::types::Value::Integer(i64::from(*v)),
252         Value::Number(v) => v
253             .as_i64()
254             .map(rusqlite::types::Value::Integer)
255             .unwrap_or_else(|| rusqlite::types::Value::Real(v.as_f64().unwrap_or(0.0))),
256         Value::String(v) => rusqlite::types::Value::Text(v.clone()),
257         _ => rusqlite::types::Value::Text(value.to_string()),
258     }
259 }
260
261 fn column_json(row: &rusqlite::Row, index: usize) -> Value {
262     match row.get_ref(index) {
263         Ok(rusqlite::types::ValueRef::Null) => Value::Null,
264         Ok(rusqlite::types::ValueRef::Integer(v)) => json!(v),
265         Ok(rusqlite::types::ValueRef::Real(v)) => json!(v),
266         Ok(rusqlite::types::ValueRef::Text(v)) => {
267             Value::String(String::from_utf8_lossy(v).into_owned())
268         }
269         Ok(rusqlite::types::ValueRef::Blob(v)) => {
270             json!({ "blob_base64": base64::engine::general_purpose::STANDARD.encode(v) })
271         }
272         Err(_) => Value::Null,
273     }
274 }
275
276 /// Operator maintenance: run one statement against the local store.
277 /// SELECT returns JSON rows; other statements return {"affected": n}.
278 /// Requires store key custody (UAC_STORE_KEY / store key file) like the server.
279 pub fn query(
280     db: &Connection,
281     sql: &str,
282     parameters: &[Value],
283 ) -> Result<String, Box<dyn std::error::Error>> {
284     let mut statement = db.prepare(sql)?;
285     let bound: Vec<rusqlite::types::Value> = parameters.iter().map(json_to_param).collect();
286     if statement.column_count() == 0 {
287         let affected = statement.execute(rusqlite::params_from_iter(bound))?;
288         return Ok(json!({ "affected": affected }).to_string());
289     }
290     let columns = statement.column_count();
291     let mut rows = statement.query(rusqlite::params_from_iter(bound))?;
292     let mut out = Vec::new();
293     while let Some(row) = rows.next()? {
294         out.push(Value::Array(
295             (0..columns).map(|i| column_json(row, i)).collect(),
296         ));
297     }
298     Ok(Value::Array(out).to_string())
299 }
