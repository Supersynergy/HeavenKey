 .                                       81 #[derive(Debug)]
 .                                       82 pub enum Error {
 .                                       83     /// Underlying SQLite failure.
 .                                       84     Sql(rusqlite::Error),
 .                                       85     /// The requested tenant does
 .                                       .. not exist.
 .                                       86     TenantNotFound,
 .                                       87     /// The requested record does
 .                                       .. not exist *in this tenant* — forei
 .                                       .. gn ids are
 .                                       88     /// reported identically so th
 .                                       .. e error leaks no cross-tenant info
 .                                       .. rmation.
