 .                                       .. fe API (the brand prevents it); ke
 .                                       .. pt as a
 .                                       92     /// fail-closed guard.
 .                                       93     CrossTenant,
 .                                       94     /// A foreign-key or existence
 .                                       ..  check rejected a participant id.
 .                                       95     Foreign,
 .                                       96     /// A per-tenant uniqueness co
 .                                       .. nstraint was hit (e.g. duplicate u
 .                                       .. ser name).
 .                                       97     Duplicate,
 .                                       98     /// Caller input failed valida
 .                                       .. tion.
 .                                       99     Invalid(&'static str),
 .                                      100 }
