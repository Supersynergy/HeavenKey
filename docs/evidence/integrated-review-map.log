422 def check_secrets(root: Path, report: Report) -> None:
423     hits = []
424     for path in sorted(root.glob("deploy/**/*")):
425         if not path.is_file():
426             continue
427         text = path.read_text(encoding="utf-8", errors="replace")
428         for line_no, line in enumerate(text.splitlines(), 1):
429             for pattern in SECRET_PATTERNS:
430                 if pattern.search(line):
431                     hits.append(f"{path.relative_to(root)}:{line_no}")
432     report.add(
433         "secrets-scan",
434         "deploy/",
435         not hits,
436         "keine Klartext-Secrets" + (f" (Treffer: {', '.join(hits)})" if hits else ""),
437     )
