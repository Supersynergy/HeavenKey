scripts/create_protection_key.py --- Python
 1 """Explicit headless setup: create one private key file outside HeavenKey's data directory."""
 2 import argparse
 3 import os
 4 from pathlib import Path
 5
 6
 7 def create(path: Path):
 8     path = path.expanduser().absolute()
 9     path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
10     # Exclusive creation prevents overwriting a key needed by an existing database.
11     descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
12     with os.fdopen(descriptor, "wb") as stream:
13         stream.write(os.urandom(32))
14         stream.flush()
15         os.fsync(stream.fileno())
16     return path
17
18
19 if __name__ == "__main__":
20     parser = argparse.ArgumentParser(description=__doc__)
21     parser.add_argument("path", type=Path)
22     args = parser.parse_args()
23     print(f"Private protection key created: {create(args.path)}")
24     print("Set HEAVENKEY_KEY_FILE to this path. Back it up separately; never put it inside the data directory.")
25

