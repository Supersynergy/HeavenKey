 99 struct Fixtures {
100     grants: Vec<(String, Signed<Grant>)>,
101     invocations: Vec<(String, Signed<Invocation>)>,
102 }
103
104 impl Fixtures {
105     fn grant(&self, name: &str) -> &Signed<Grant> {
106         &self
107             .grants
108             .iter()
109             .find(|(n, _)| n == name)
110             .unwrap_or_else(|| panic!("unknown grant fixture {name}"))
111             .1
112     }
113     fn invocation(&self, name: &str) -> &Signed<Invocation> {
114         &self
115             .invocations
116             .iter()
117             .find(|(n, _)| n == name)
118             .unwrap_or_else(|| panic!("unknown invocation fixture {name}"))
119             .1
120     }
121 }
