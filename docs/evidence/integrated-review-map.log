scripts/agent.mjs --- JavaScript
 1 /** Local machine identity example. Never imports or drives a person's passkey. */
 2 import { generateKeyPairSync, createPrivateKey, createHash, sign, timingSafeEqual } from "node:crypto";
 3 import { writeFile, readFile, mkdir, chmod } from "node:fs/promises";
 4 import { dirname, resolve } from "node:path";
 5 const args = process.argv.slice(2);
 6 let origin = "http://localhost:18240";
 7 const flag = args.indexOf("--origin");
 8 if (flag !== -1) { origin = args[flag + 1]; args.splice(flag, 2); }
 9 const [command, file, task, ...extra] = args;
10 if (command === "keygen" && file) {
11   const keys = generateKeyPairSync("ed25519"); const path = resolve(file);
12   await mkdir(dirname(path), { recursive: true, mode: 0o700 });
13   await writeFile(path, keys.privateKey.export({ format: "pem", type: "pkcs8" }), { flag: "wx", mode: 0o600 });
14   await chmod(path, 0o600);
15   console.log(JSON.stringify({ private_key_file: path, public_key: keys.publicKey.export({ format: "der", type: "spki" }).subarray(-32).toString("base64url") }, null, 2));
16 } else if (["read", "note"].includes(command) && file && task) {
17   const parsed = new URL(origin);
18   if (parsed.username || parsed.password || parsed.search || parsed.hash || parsed.pathname !== "/" || !(parsed.protocol === "https:" || parsed.protocol === "http:" && parsed.hostname === "localhost")) throw new Error("Use a configured HTTPS origin or localhost.");
19   origin = parsed.origin;
20   const payload = { id: task, resource: command === "note" ? "crm.contacts" : (extra[0] || "crm.contacts"), action: command === "note" ? "Write" : "Read", arguments: command === "note" ? { id: "demo-contact", note: extra.join(" ") } : {} };
21   const post = async (path, body) => {
22     const response = await fetch(origin + path, { method: "POST", headers: { Origin: origin, "Content-Type": "application/json" }, body: JSON.stringify(body), signal: AbortSignal.timeout(10000) });
23     const value = await response.json(); if (!response.ok) throw new Error(value.error || `HTTP ${response.status}`); return value;
24   };
25   const challenge = await post("/api/agents/challenge", payload);
26   const message = Buffer.from(challenge.message, "base64url"), prefix = Buffer.from("HEAVENKEY-AGENT-INVOKE-v1\0");
27   const expected = createHash("sha256").update(JSON.stringify(payload)).digest();
28   if (message.length !== prefix.length + 96 || !timingSafeEqual(message.subarray(prefix.length, prefix.length + 32), createHash("sha256").update(origin).digest()) || !message.subarray(0, prefix.length).equals(prefix) || !timingSafeEqual(message.subarray(-32), expected)) throw new Error("Server challenge does not match the requested operation.");
29   const privateKey = createPrivateKey(await readFile(resolve(file)));
30   if (privateKey.asymmetricKeyType !== "ed25519") throw new Error("An Ed25519 agent key is required.");
31   const result = await post("/api/agents/invoke", { challenge_id: challenge.challenge_id, signature: sign(null, message, privateKey).toString("base64url") });
32   console.log(JSON.stringify(result, null, 2));
33 } else {
34   console.log("node scripts/agent.mjs keygen /private/path/agent.pem\nnode scripts/agent.mjs read /private/path/agent.pem TASK_ID [document|crm.contacts] [--origin https://your-service]\nnode scripts/agent.mjs note /private/path/agent.pem TASK_ID New contact note [--origin https://your-service]");
35   process.exitCode = command ? 1 : 0;
36 }
