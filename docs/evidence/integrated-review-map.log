 167 pub(super) async fn recovery_status(
 168     State(app): State<App>,
 169     headers: HeaderMap,
 170 ) -> ApiResult<Json<Value>> {
 171     let mut inner = app.inner.lock().map_err(internal)?;
 172     let user = inner.session_user(&headers)?;
 173     let enabled: bool = inner
 174         .db
 175         .query_row(
 176             "SELECT EXISTS(SELECT 1 FROM recovery_codes WHERE account_id=?1 AND used=0)",
 177             [&user.id],
 178             |r| r.get(0),
 179         )
 180         .map_err(internal)?;
 181     let count: i64 = inner
 182         .db
 183         .query_row(
 184             "SELECT count(*) FROM credentials WHERE user_id=?1 AND active=1",
 185             [&user.id],
 186             |r| r.get(0),
 187         )
 188         .map_err(internal)?;
 189     Ok(Json(
 190         json!({"enabled":enabled,"active_passkeys":count,"backup_passkey_recommended":count<2}),
 191     ))
 192 }
 193 pub(super) async fn recovery_rotate(
 194     State(app): State<App>,
 195     headers: HeaderMap,
 196     Json(input): Json<Approved>,
 197 ) -> ApiResult<Json<Value>> {
 198     let mut inner = app.inner.lock().map_err(internal)?;
 199     let approval = inner.take_approval(input.approval_id.as_deref());
 200     let user = inner.session_user(&headers)?;
 201     inner.require_approval(
 202         &headers,
 203         &user,
 204         input.approval_id.as_deref(),
 205         approval,
 206         &Management::RecoveryRotate,
 207     )?;
 208     let code = uac_recovery::generate();
 209     let digest = URL_SAFE_NO_PAD.encode(
 210         uac_recovery::digest(&user.id, &code)
 211             .ok_or_else(|| internal("recovery code generation"))?,
 212     );
 213     let tx = inner.db.transaction().map_err(internal)?;
 214     tx.execute("INSERT INTO recovery_codes(account_id,digest,used,created) VALUES(?1,?2,0,?3) ON CONFLICT(account_id) DO UPDATE SET digest=excluded.digest,used=0,created=excluded.created",params![user.id,digest,db_time(now())?]).map_err(internal)?;
 215     audit(&tx, &user.id, "recovery_rotated", "")?;
 216     tx.commit().map_err(internal)?;
 217     inner
 218         .platform
 219         .recoveries
 220         .retain(|_, r| r.user_id != user.id);
 221     Ok(Json(
 222         json!({"code":code,"display_once":true,"old_code_invalidated":true}),
 223     ))
 224 }
 225 pub(super) async fn recovery_disable(
 226     State(app): State<App>,
 227     headers: HeaderMap,
 228     Json(input): Json<Approved>,
 229 ) -> ApiResult<Json<Value>> {
 230     let mut inner = app.inner.lock().map_err(internal)?;
 231     let approval = inner.take_approval(input.approval_id.as_deref());
 232     let user = inner.session_user(&headers)?;
 233     inner.require_approval(
 234         &headers,
 235         &user,
 236         input.approval_id.as_deref(),
 237         approval,
 238         &Management::RecoveryDisable,
 239     )?;
 240     let tx = inner.db.transaction().map_err(internal)?;
 241     tx.execute("DELETE FROM recovery_codes WHERE account_id=?1", [&user.id])
 242         .map_err(internal)?;
 243     audit(&tx, &user.id, "recovery_disabled", "")?;
 244     tx.commit().map_err(internal)?;
 245     inner
 246         .platform
 247         .recoveries
 248         .retain(|_, r| r.user_id != user.id);
 249     Ok(Json(json!({"disabled":true})))
 250 }
 251 #[derive(Deserialize)]
 252 #[serde(deny_unknown_fields)]
 253 pub(super) struct RecoveryStart {
 254     name: String,
 255     code: String,
 256     label: String,
 257 }
 258 pub(super) async fn recovery_start(
 259     State(app): State<App>,
 260     Json(input): Json<RecoveryStart>,
 261 ) -> ApiResult<Json<Value>> {
 262     let mut inner = app.inner.lock().map_err(internal)?;
 263     inner.prune();
 264     let label = credential_label(&input.label)?;
 265     if input.name.len() > 32 || input.code.len() > 96 {
 266         return Err(forbidden("recovery_denied"));
 267     }
 268     if inner.platform.recoveries.len() >= MAX_PENDING {
 269         return Err(ApiError(StatusCode::TOO_MANY_REQUESTS, "ceremony_limit"));
 270     }
 271     let user = inner
 272         .user("name", &input.name)
 273         .map_err(|_| forbidden("recovery_denied"))?;
 274     let digest = uac_recovery::digest(&user.id, &input.code)
 275         .map(|digest| URL_SAFE_NO_PAD.encode(digest))
 276         .unwrap_or_default();
 277     let valid: bool = inner.db.query_row("SELECT EXISTS(SELECT 1 FROM recovery_codes WHERE account_id=?1 AND digest=?2 AND used=0)",params![user.id,digest],|r|r.get(0)).map_err(internal)?;
 278     if !valid {
 279         // Failed guesses must not lock the holder of a valid high-entropy code out.
 280         if !inner.platform.recovery_attempts.contains_key(&user.id)
 281             && inner.platform.recovery_attempts.len() >= MAX_PENDING
 282         {
 283             return Err(ApiError(
 284                 StatusCode::TOO_MANY_REQUESTS,
 285                 "recovery_rate_limit",
 286             ));
 287         }
 288         let attempt = inner
 289             .platform
 290             .recovery_attempts
 291             .entry(user.id.clone())
 292             .or_insert((0, Instant::now() + Duration::from_secs(600)));
 293         if attempt.0 >= 10 {
 294             return Err(ApiError(
 295                 StatusCode::TOO_MANY_REQUESTS,
 296                 "recovery_rate_limit",
 297             ));
 298         }
 299         attempt.0 += 1;
 300         return Err(forbidden("recovery_denied"));
 301     }
 302     let excluded = inner
 303         .active_credentials(&user.id)?
 304         .into_iter()
 305         .map(|c| c.passkey.cred_id().clone())
 306         .collect();
 307     let (options, state) = inner
 308         .webauthn
 309         .start_passkey_registration(
 310             Uuid::parse_str(&user.id).map_err(internal)?,
 311             &user.name,
 312             &user.name,
 313             Some(excluded),
 314         )
 315         .map_err(internal)?;
 316     let request_id = Uuid::new_v4().to_string();
 317     inner.platform.recoveries.insert(
 318         request_id.clone(),
 319         RecoveryRegistration {
 320             user_id: user.id,
 321             digest,
 322             label,
 323             state,
 324             expires: Instant::now() + Duration::from_secs(CEREMONY_TTL),
 325         },
 326     );
 327     Ok(Json(json!({"request_id":request_id,"options":options})))
 328 }
 329 pub(super) async fn recovery_finish(
 330     State(app): State<App>,
 331     Json(input): Json<RegisterFinish>,
 332 ) -> ApiResult<Json<Value>> {
 333     let mut inner = app.inner.lock().map_err(internal)?;
 334     inner.prune();
 335     let pending = inner
 336         .platform
 337         .recoveries
 338         .remove(&input.request_id)
 339         .ok_or(forbidden("ceremony_missing"))?;
 340     let key = inner
 341         .webauthn
 342         .finish_passkey_registration(&input.credential, &pending.state)
 343         .map_err(|_| ApiError(StatusCode::UNAUTHORIZED, "registration_invalid"))?;
 344     let id = credential_id(&key);
 345     inner.check_credential_unique(&id)?;
 346     let tx = inner.db.transaction().map_err(internal)?;
 347     if tx
 348         .execute(
 349             "UPDATE recovery_codes SET used=1 WHERE account_id=?1 AND digest=?2 AND used=0",
 350             params![pending.user_id, pending.digest],
 351         )
 352         .map_err(internal)?
 353         != 1
 354     {
 355         return Err(forbidden("recovery_denied"));
 356     }
 357     tx.execute(
 358         "UPDATE credentials SET active=0 WHERE user_id=?1",
 359         [&pending.user_id],
 360     )
 361     .map_err(internal)?;
 362     tx.execute(
 363         "INSERT INTO credentials(id,user_id,passkey,label,created) VALUES(?1,?2,?3,?4,?5)",
 364         params![
 365             id,
 366             pending.user_id,
 367             serde_json::to_string(&key).map_err(internal)?,
 368             pending.label,
 369             db_time(now())?
 370         ],
 371     )
 372     .map_err(internal)?;
 373     tx.execute(
 374         "UPDATE agent_tasks SET revoked=1 WHERE account_id=?1",
 375         [&pending.user_id],
 376     )
 377     .map_err(internal)?;
 378     audit(&tx, &pending.user_id, "account_recovered", &id)?;
 379     tx.commit().map_err(internal)?;
 380     invalidate_account(&mut inner, &pending.user_id);
 381     inner.platform.recovery_attempts.remove(&pending.user_id);
 382     Ok(Json(
 383         json!({"recovered":true,"login_required":true,"all_old_passkeys_revoked":true,"agents_revoked":true,"vault_recovery_key_required":true}),
 384     ))
 385 }
