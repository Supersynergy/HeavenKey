411     #[test]
412     fn query_returns_rows_and_affected() {
413         let dir = temp_dir("query");
414         let store = open_with_key(&dir, &test_key(1)).unwrap();
415         store
416             .db
417             .execute_batch("CREATE TABLE q(a TEXT,b INTEGER); INSERT INTO q VALUES('x',7);")
418             .unwrap();
419         let rows: Value = serde_json::from_str(
420             &query(&store.db, "SELECT a,b FROM q WHERE b=?1", &[json!(7)]).unwrap(),
421         )
422         .unwrap();
423         assert_eq!(rows, json!([["x", 7]]));
424         let affected: Value = serde_json::from_str(
425             &query(
426                 &store.db,
427                 "UPDATE q SET b=?1 WHERE a=?2",
428                 &[json!(8), json!("x")],
429             )
430             .unwrap(),
431         )
432         .unwrap();
433         assert_eq!(affected, json!({ "affected": 1 }));
