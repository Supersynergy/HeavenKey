301 def check_systemd(text: str, rel: str, report: Report) -> None:
302     body = strip_comments(text)
303     name = Path(rel).stem
304
305     def directive(key: str) -> str | None:
306         m = re.search(rf"(?m)^{re.escape(key)}=([^\n]+)", body)
307         return m.group(1).strip() if m else None
308
309     report.add(
310         f"systemd-exec-{name}",
311         rel,
312         bool(directive("ExecStart")) and name in (directive("ExecStart") or ""),
313         f"ExecStart referenziert {name}",
314     )
315     user = directive("User") or ""
316     report.add(
317         f"systemd-user-{name}",
318         rel,
319         bool(user) and user != "root",
320         f"dedizierter Nicht-Root-User ({user or 'fehlt'})",
321     )
322     report.add(
323         f"systemd-nnp-{name}",
324         rel,
325         directive("NoNewPrivileges") == "yes",
326         "NoNewPrivileges=yes",
327     )
328     protect = directive("ProtectSystem") or ""
329     report.add(
330         f"systemd-protectsystem-{name}",
331         rel,
332         protect in {"yes", "full", "strict"},
333         f"ProtectSystem={protect or 'fehlt'}",
334     )
335     report.add(
336         f"systemd-privatetmp-{name}",
337         rel,
338         directive("PrivateTmp") == "yes",
339         "PrivateTmp=yes",
340     )
341     report.add(
342         f"systemd-statedir-{name}",
343         rel,
344         bool(directive("StateDirectory")),
345         "StateDirectory fuer data/ gesetzt",
346     )
347     restart = directive("Restart") or ""
348     report.add(
349         f"systemd-restart-{name}",
350         rel,
351         restart in {"on-failure", "on-abnormal", "always"},
352         f"Restart={restart or 'fehlt'} dokumentiert",
353     )
354     if name == "uac-api":
355         report.add("systemd-api-env", rel,
356                    directive("EnvironmentFile") == "/etc/heavenkey/api.env",
357                    "verbindliche Service-Umgebung /etc/heavenkey/api.env")
358         report.add("systemd-api-custody", rel,
359                    directive("StateDirectoryMode") == "0700"
360                    and directive("UMask") == "0077"
361                    and directive("ReadOnlyPaths") == "/etc/heavenkey",
362                    "private Daten und schreibgeschuetzte externe Konfiguration")
363         report.add("systemd-api-restart-limit", rel,
364                    directive("StartLimitIntervalSec") == "60s"
365                    and directive("StartLimitBurst") == "3",
366                    "hoechstens drei Starts pro Minute")
367
