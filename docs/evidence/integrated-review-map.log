 590 fn agent_allowed(inner: &Inner, id: &str) -> ApiResult<AgentGrant> {
 591     let row: Option<(String, String, String, bool)> = inner
 592         .db
 593         .query_row(
 594             "SELECT token,account_id,credential_id,revoked FROM agent_tasks WHERE id=?1",
 595             [id],
 596             |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?, r.get(3)?)),
 597         )
 598         .optional()
 599         .map_err(internal)?;
 600     let (token, account, key, revoked) = row.ok_or(forbidden("agent_denied"))?;
 601     let token: Signed<AgentGrant> =
 602         serde_json::from_str(&token).map_err(|_| forbidden("agent_denied"))?;
 603     let grant = &token.body;
 604     let sig = Signature::from_slice(&token.signature).map_err(|_| forbidden("agent_denied"))?;
 605     inner
 606         .issuer
 607         .verifying_key()
 608         .verify_strict(&agent_message(grant)?, &sig)
 609         .map_err(|_| forbidden("agent_denied"))?;
 610     if revoked
 611         || grant.profile != "heavenkey-agent-v1"
 612         || grant.id != id
 613         || grant.account_id != account
 614         || grant.credential_id != key
 615         || grant.not_before > now()
 616         || grant.expires_at <= now()
 617         || !inner.credential_active(&account, &key)?
 618     {
 619         return Err(forbidden("agent_denied"));
 620     }
 621     agent_authority(
 622         inner,
 623         &inner.user("id", &account)?,
 624         &grant.spec,
 625         grant.expires_at,
 626     )?;
 627     Ok(token.body)
 628 }
 629 pub(super) async fn agents(State(app): State<App>, headers: HeaderMap) -> ApiResult<Json<Value>> {
 630     let mut inner = app.inner.lock().map_err(internal)?;
 631     let user = inner.session_user(&headers)?;
 632     let mut stmt=inner.db.prepare("SELECT id,token,revoked FROM agent_tasks WHERE account_id=?1 ORDER BY created DESC,rowid DESC LIMIT 100").map_err(internal)?;
 633     let rows = stmt
 634         .query_map([&user.id], |r| {
 635             Ok((
 636                 r.get::<_, String>(0)?,
 637                 r.get::<_, String>(1)?,
 638                 r.get::<_, bool>(2)?,
 639             ))
 640         })
 641         .map_err(internal)?;
 642     let mut tasks = Vec::new();
 643     for row in rows {
 644         let (id, token, revoked) = row.map_err(internal)?;
 645         let token: Signed<AgentGrant> = serde_json::from_str(&token).map_err(internal)?;
 646         tasks.push(json!({"id":id,"grant":token,"revoked":revoked,"effective_active":agent_allowed(&inner,&id).is_ok()}));
 647     }
 648     Ok(Json(json!({"tasks":tasks,"sandbox_only":true})))
 649 }
