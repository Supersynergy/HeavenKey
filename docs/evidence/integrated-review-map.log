313     fn test_key(byte: u8) -> [u8; 32] {
314         [byte; 32]
315     }
316
317     #[test]
318     fn new_store_is_encrypted_and_rejects_wrong_key() {
319         let dir = temp_dir("wrongkey");
320         {
321             let store = open_with_key(&dir, &test_key(1)).unwrap();
322             store
323                 .db
324                 .execute("CREATE TABLE t(v TEXT)", [])
325                 .and_then(|_| store.db.execute("INSERT INTO t VALUES('secret')", []))
326                 .unwrap();
327         }
328         let db_path = dir.join("uac.sqlite");
329         assert!(!is_plaintext(&db_path).unwrap());
330         assert!(open_with_key(&dir, &test_key(2)).is_err());
331         let store = open_with_key(&dir, &test_key(1)).unwrap();
332         let value: String = store
333             .db
334             .query_row("SELECT v FROM t", [], |row| row.get(0))
335             .unwrap();
336         assert_eq!(value, "secret");
337     }
338
339     #[test]
340     fn plaintext_database_migrates_and_loses_plaintext_sidecars() {
341         let dir = temp_dir("migrate");
342         let db_path = dir.join("uac.sqlite");
343         {
344             let plain = Connection::open(&db_path).unwrap();
345             plain
346                 .execute_batch("CREATE TABLE legacy(v TEXT); INSERT INTO legacy VALUES('row');")
347                 .unwrap();
348         }
349         fs::write(dir.join("uac.sqlite-wal"), b"stale").unwrap();
350         let store = open_with_key(&dir, &test_key(9)).unwrap();
351         assert!(!is_plaintext(&db_path).unwrap());
352         let wal = dir.join("uac.sqlite-wal");
353         assert!(!wal.exists() || fs::read(&wal).unwrap() != b"stale");
354         let value: String = store
355             .db
356             .query_row("SELECT v FROM legacy", [], |row| row.get(0))
357             .unwrap();
358         assert_eq!(value, "row");
359         assert!(open_with_key(&dir, &test_key(8)).is_err());
360     }
