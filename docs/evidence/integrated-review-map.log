 486 pub(super) struct AgentCreate {
 487     spec: AgentSpec,
 488     approval_id: Option<String>,
 489 }
 490 pub(super) async fn agent_create(
 491     State(app): State<App>,
 492     headers: HeaderMap,
 493     Json(input): Json<AgentCreate>,
 494 ) -> ApiResult<Json<Value>> {
 495     let mut inner = app.inner.lock().map_err(internal)?;
 496     let approval = inner.take_approval(input.approval_id.as_deref());
 497     let user = inner.session_user(&headers)?;
 498     let credential = inner.require_approval(
 499         &headers,
 500         &user,
 501         input.approval_id.as_deref(),
 502         approval,
 503         &Management::AgentCreate {
 504             spec: input.spec.clone(),
 505         },
 506     )?;
 507     let end = now()
 508         .checked_add(input.spec.ttl_seconds)
 509         .ok_or(forbidden("agent_scope_denied"))?;
 510     agent_authority(&inner, &user, &input.spec, end)?;
 511     let count: i64 = inner
 512         .db
 513         .query_row(
 514             "SELECT count(*) FROM agent_tasks WHERE account_id=?1 AND revoked=0 AND expires_at>?2",
 515             params![user.id, db_time(now())?],
 516             |r| r.get(0),
 517         )
 518         .map_err(internal)?;
 519     if count >= 32 {
 520         return Err(forbidden("agent_limit"));
 521     }
 522     let id = Uuid::new_v4().to_string();
 523     let body = AgentGrant {
 524         profile: "heavenkey-agent-v1".into(),
 525         id: id.clone(),
 526         account_id: user.id.clone(),
 527         credential_id: credential.clone(),
 528         spec: input.spec,
 529         not_before: now(),
 530         expires_at: end,
 531     };
 532     let signature = inner
 533         .issuer
 534         .sign(&agent_message(&body)?)
 535         .to_bytes()
 536         .to_vec();
 537     let token = Signed { body, signature };
 538     let tx = inner.db.transaction().map_err(internal)?;
 539     tx.execute("INSERT INTO agent_tasks(id,account_id,credential_id,token,created,expires_at) VALUES(?1,?2,?3,?4,?5,?6)",params![id,user.id,credential,serde_json::to_string(&token).map_err(internal)?,db_time(now())?,db_time(end)?]).map_err(internal)?;
 540     audit(&tx, &user.id, "agent_created", &id)?;
 541     tx.commit().map_err(internal)?;
 542     Ok(Json(
 543         json!({"id":id,"grant":token,"proof_of_possession_required":true,"integration":"local-sandbox"}),
 544     ))
 545 }
