102     const result = await request("/api/agents/invoke", { challenge_id: challenge.challenge_id, signature: encode(sign(null, Buffer.from(challenge.message, "base64url"), agent.privateKey)) }); assert.equal(result.status, 200);
103     assert.equal(result.value.data.contacts[0].note, "Protocol integration checked"); assert.equal(result.value.data.tenant, o.account_id);
104     assert.equal((await request("/api/agents/invoke", { challenge_id: challenge.challenge_id, signature: encode(sign(null, Buffer.from(challenge.message, "base64url"), agent.privateKey)) })).status, 403);
105     assert.equal((await request("/api/agents/challenge", { ...inv, arguments: { id: "other-contact", note: "denied" } })).status, 403);
106   });
107   await test("the shipped agent CLI validates the origin-bound challenge and executes a read", async () => {
108     const path = join(directory, "agent.pem");
