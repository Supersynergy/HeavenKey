 .                                      ... de this tenant"),
 .                                      110             Self::Duplicate => f.w
 .                                      ... rite_str("conflicts with an existi
 .                                      ... ng record in this tenant"),
 .                                      111             Self::Invalid(what) =>
 .                                      ...  write!(f, "invalid {what}"),
 .                                      112         }
 .                                      113     }
 .                                      114 }
