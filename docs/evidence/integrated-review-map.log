 117 pub(super) async fn config(State(app): State<App>) -> ApiResult<Json<Value>> {
 118     let inner = app.inner.lock().map_err(internal)?;
 119     let rp_id: String = inner
 120         .db
 121         .query_row(
 122             "SELECT value FROM platform_metadata WHERE key='rp_id'",
 123             [],
 124             |r| r.get(0),
 125         )
 126         .optional()
 127         .map_err(internal)?
 128         .unwrap_or_else(|| "localhost".into());
 129     Ok(Json(
 130         json!({"version":env!("CARGO_PKG_VERSION"),"origin":app.origin,"rp_id":rp_id,"issuer_public_key":URL_SAFE_NO_PAD.encode(inner.issuer.verifying_key().to_bytes()),"keystore":if std::env::var_os("HEAVENKEY_KEY_FILE").is_some(){"external-key-file"}else{"native-os-store"},"hardware_verified":false,"external_integration":"local-crm-sandbox","prf":"optional-client-side","session_seconds":300}),
 131     ))
 132 }
 133 pub(super) async fn session(State(app): State<App>, headers: HeaderMap) -> ApiResult<Json<Value>> {
 134     let mut inner = app.inner.lock().map_err(internal)?;
 135     let user = inner.session_user(&headers)?;
 136     let s = inner
 137         .sessions
 138         .get(session_token(&headers)?)
 139         .ok_or(forbidden("session_expired"))?;
 140     Ok(Json(
 141         json!({"account_id":user.id,"name":user.name,"owner":user.owner,"credential_id":s.credential_id,"expires_at":s.expires}),
 142     ))
 143 }
 144 pub(super) async fn logout(State(app): State<App>, headers: HeaderMap) -> ApiResult<Json<Value>> {
 145     let mut inner = app.inner.lock().map_err(internal)?;
 146     inner.session_user(&headers)?;
 147     let token = session_token(&headers)?;
 148     inner.sessions.remove(token);
 149     inner.approvals.retain(|_, a| a.session_token != token);
 150     inner.enrollments.retain(|_, a| a.session_token != token);
 151     inner.authentications.retain(|_, a| {
 152         a.management
 153             .as_ref()
 154             .is_none_or(|m| m.session_token != token)
 155     });
 156     Ok(Json(json!({"logged_out":true})))
 157 }
 158 pub(super) async fn events(State(app): State<App>, headers: HeaderMap) -> ApiResult<Json<Value>> {
 159     let mut inner = app.inner.lock().map_err(internal)?;
 160     let user = inner.session_user(&headers)?;
 161     let mut stmt = inner.db.prepare("SELECT event,reference,created FROM audit_events WHERE account_id=?1 ORDER BY created DESC,rowid DESC LIMIT 100").map_err(internal)?;
 162     let rows = stmt.query_map([user.id], |r| Ok(json!({"event":r.get::<_,String>(0)?,"reference":r.get::<_,String>(1)?,"created":r.get::<_,i64>(2)?}))).map_err(internal)?;
 163     let rows: Vec<Value> = rows.collect::<Result<_, _>>().map_err(internal)?;
 164     Ok(Json(json!({"events":rows})))
 165 }
