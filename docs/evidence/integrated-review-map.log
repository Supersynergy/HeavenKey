 799 pub(super) async fn read(
 800     State(app): State<App>,
 801     headers: HeaderMap,
 802     Json(input): Json<SessionRead>,
 803 ) -> ApiResult<Json<Value>> {
 804     let mut inner = app.inner.lock().map_err(internal)?;
 805     let user = inner.session_user(&headers)?;
 806     match (&input.grant_id, &input.delegation_id) {
 807         (Some(id), None) => {
