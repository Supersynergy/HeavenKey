487 def main() -> int:
488     parser = argparse.ArgumentParser(description=__doc__)
489     parser.add_argument(
490         "--root",
491         default=Path(__file__).resolve().parent.parent,
492         type=Path,
493         help="Repo-Wurzel (Standard: uebergeordneter Ordner des Skripts)",
494     )
495     parser.add_argument(
496         "--json",
497         type=Path,
498         default=None,
499         help="JSON-Report in diese Datei schreiben (z. B. docs/evidence/ops-check.json)",
500     )
501     args = parser.parse_args()
502     root = args.root.resolve()
503
504     report = Report()
505     for rel in DEPLOY_FILES + [DOC_FILE]:
506         report.add(
507             "exists",
508             rel,
509             (root / rel).is_file(),
510             "Datei vorhanden" if (root / rel).is_file() else "Datei fehlt",
511         )
512
513     caddy_path = root / "deploy/caddy/Caddyfile"
514     if caddy_path.is_file():
515         check_caddy(caddy_path.read_text(encoding="utf-8"), "deploy/caddy/Caddyfile", report)
516     nginx_path = root / "deploy/nginx/nginx.conf"
517     if nginx_path.is_file():
518         check_nginx(nginx_path.read_text(encoding="utf-8"), "deploy/nginx/nginx.conf", report)
519     for rel in DEPLOY_FILES:
520         if not rel.endswith(".service"):
521             continue
522         path = root / rel
523         if path.is_file():
524             check_systemd(path.read_text(encoding="utf-8"), rel, report)
525
526     check_secrets(root, report)
527     check_environment(root, report)
528     check_port_consistency(root, report)
529
530     summary = report.to_json()
531     print(
532         f"ops_check: {summary['total']} Checks, "
533         f"{summary['failed']} Fehler -> {'OK' if summary['ok'] else 'FEHLER'}"
534     )
535     if args.json:
536         args.json.parent.mkdir(parents=True, exist_ok=True)
537         args.json.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
538         print(f"Report: {args.json}")
539     return 0 if summary["ok"] else 1
540
541
542 if __name__ == "__main__":
543     sys.exit(main())
