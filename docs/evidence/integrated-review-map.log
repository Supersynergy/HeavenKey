 .                                      ... e {
 .                                      130                 ffi::SQLITE_CONSTR
 .                                      ... AINT_UNIQUE | ffi::SQLITE_CONSTRAI
 .                                      ... NT_PRIMARYKEY => {
 .                                      131                     return Self::D
 .                                      ... uplicate;
 .                                      132                 }
 .                                      133                 ffi::SQLITE_CONSTR
 .                                      ... AINT_FOREIGNKEY => return Self::Fo
 .                                      ... reign,
 .                                      134                 _ => {}
 .                                      135             }
 .                                      136         }
