 1 from pathlib import Path
 2 from datetime import datetime, timezone
 3 import json
 4 import os
 5 import signal
 6 import subprocess
 7 import sys
 8 import time
 9 
10 root = Path(__file__).resolve().parent.parent
11 name, seconds, *command = sys.argv[1:]
12 if command and command[0] == '--':
13     command = command[1:]
14 deadline = datetime.fromisoformat(json.loads((root/'docs/evidence/budget.json').read_text())['deadline_utc'])
15 remaining = (deadline - datetime.now(timezone.utc)).total_seconds()
16 timeout = min(float(seconds), remaining)
17 if timeout <= 0:
18     raise SystemExit('eight-hour spike deadline exceeded')
19 env = dict(os.environ, CARGO_BUILD_JOBS='4', CARGO_TERM_COLOR='never', RUSTC_WRAPPER='', CARGO_TARGET_DIR=str(root/'target'))
20 start = time.monotonic()
21 logfile = root/'docs/evidence'/f'{name}.log'
22 with logfile.open('w') as log:
23     child = subprocess.Popen(command, cwd=root, env=env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
24     try:
25         code = child.wait(timeout=timeout)
26     except subprocess.TimeoutExpired:
27         os.killpg(child.pid, signal.SIGKILL)
28         child.wait()
29         code = 124
30 event = {'name':name,'command':command,'exit_code':code,'elapsed_seconds':round(time.monotonic()-start,3),'time_utc':datetime.now(timezone.utc).isoformat(),'log':str(logfile)}
31 with (root/'docs/evidence/commands.jsonl').open('a') as ledger:
32     ledger.write(json.dumps(event)+'\n')
33 print(json.dumps(event))
34 if code:
35     print('\n'.join(logfile.read_text().splitlines()[-60:]))
36 raise SystemExit(code)
