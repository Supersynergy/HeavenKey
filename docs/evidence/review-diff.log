265     fn fixture() -> (Verifier, Vec<Signed<Grant>>, Signed<Invocation>) {
266         let root = key(1);
267         let owner = key(2);
268         let guest = key(3);
269         let parent = sign_grant(
270             &root,
271             Grant {
272                 issuer: root.verifying_key().to_bytes(),
273                 audience: owner.verifying_key().to_bytes(),
274                 resource: RESOURCE.into(),
275                 actions: [Action::Read, Action::Write].into(),
276                 not_before: 0,
277                 expires_at: 1000,
278                 remaining_delegations: 1,
279                 parent: None,
280             },
281         )
282         .unwrap();
283         let child = sign_grant(
284             &owner,
285             Grant {
286                 issuer: owner.verifying_key().to_bytes(),
287                 audience: guest.verifying_key().to_bytes(),
288                 resource: RESOURCE.into(),
289                 actions: [Action::Read].into(),
290                 not_before: 10,
291                 expires_at: 200,
292                 remaining_delegations: 0,
293                 parent: Some(grant_id(&parent).unwrap()),
294             },
295         )
296         .unwrap();
297         let invocation = sign_invocation(
298             &guest,
299             Invocation {
300                 grant: grant_id(&child).unwrap(),
301                 resource: RESOURCE.into(),
302                 action: Action::Read,
303                 arguments_hash: ARGS,
304                 nonce: NONCE,
305                 issued_at: NOW,
306             },
307         )
308         .unwrap();
309         (
310             Verifier::new(root.verifying_key().to_bytes(), RESOURCE.into()),
