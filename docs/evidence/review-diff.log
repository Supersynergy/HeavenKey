scripts/e2e.mjs --- JavaScript
  1 import { chromium } from "playwright-core";
  2 import { spawn } from "node:child_process";
  3 import { createHash, createPrivateKey, sign } from "node:crypto";
  4 import { mkdtemp, writeFile, mkdir, rm } from "node:fs/promises";
  5 import { join, resolve } from "node:path";
  6 import { tmpdir } from "node:os";
  7 import assert from "node:assert/strict";
  8 
  9 const root = resolve(".");
 10 const evidence = join(root, "docs/evidence");
 11 await mkdir(evidence, { recursive: true });
 12 const data = await mkdtemp(join(tmpdir(), "uac-sim-"));
 13 const port = 18241;
 14 const origin = `http://localhost:${port}`;
 15 let server, browser;
 16 const cases = [];
 17 const started = performance.now();
 18 async function test(name, action) {
 19   const start = performance.now();
 20   try { await action(); cases.push({ name, pass: true, elapsed_ms: Math.round(performance.now()-start) }); console.log(`PASS ${name}`); }
 21   catch (e) { cases.push({ name, pass: false, error: e.message }); throw e; }
 22 }
 23 async function startServer() {
 24   server = spawn(join(root,"target/debug/uac-api"), [], { cwd:root, env:{ ...process.env,UAC_PORT:String(port),UAC_DATA:data }, stdio:["ignore","pipe","pipe"], detached:true });
 25   let output = "";
 26   server.stdout.on("data", d => output += d); server.stderr.on("data", d => output += d);
 27   const end = Date.now()+15000;
 28   while (Date.now()<end) {
 29     if (server.exitCode !== null) throw new Error(`server exited: ${output}`);
 30     try { if ((await fetch(`${origin}/health`,{ signal:AbortSignal.timeout(1000) })).ok) return; } catch {}
 31     await new Promise(r => setTimeout(r,100));
 32   }
 33   throw new Error(`server startup timeout: ${output}`);
 34 }
 35 async function stopServer() {
 36   if (!server || server.exitCode !== null) return;
 37   process.kill(-server.pid,"SIGINT");
 38   const end=Date.now()+5000;
 39   while(server.exitCode===null && Date.now()<end) await new Promise(r=>setTimeout(r,50));
 40   if(server.exitCode===null) { process.kill(-server.pid,"SIGKILL"); await new Promise(r=>server.once("exit",r)); }
 41 }
 42 async function actor(name) {
 43   const context=await browser.newContext();
 44   const page=await context.newPage();
 45   const cdp=await context.newCDPSession(page);
 46   await cdp.send("WebAuthn.enable");
 47   const {authenticatorId}=await cdp.send("WebAuthn.addVirtualAuthenticator",{ options:{ protocol:"ctap2",ctap2Version:"ctap2_1",transport:"internal",hasResidentKey:true,hasUserVerification:true,isUserVerified:true,automaticPresenceSimulation:true } });
 48   await page.goto(origin);
 49   await page.locator("#name").fill(name);
 50   return {name,context,page,cdp,authenticatorId};
 51 }
 52 async function post(actor,path,body,session) {
 53   return actor.page.evaluate(async ({path,body,session})=>{
 54     const r=await fetch(path,{method:"POST",headers:{"Content-Type":"application/json",...(session?{Authorization:`Bearer ${session}`}:{})},body:JSON.stringify(body)});
 55     return {status:r.status,body:await r.json()};
 56   },{path,body,session});
 57 }
 58 async function login(a) {
 59   const response=a.page.waitForResponse(r=>r.url().endsWith("/api/auth/finish"));
 60   await a.page.locator("#login").click();
 61   const r=await response; assert.equal(r.status(),200);
 62   const value=await r.json();
 63   await a.page.waitForFunction(()=>document.querySelector("#status").textContent.includes("Sitzung ist aktiv"));
 64   return value.session;
 65 }
 66 async function registration(a) {
 67   const response=a.page.waitForResponse(r=>r.url().endsWith("/api/register/finish"));
 68   await a.page.locator("#register").click();
 69   const r=await response;assert.equal(r.status(),200);
 70   return r.json();
 71 }
 72 async function assertion(a,invocation=null) {
 73   const start=await post(a,"/api/auth/start",{name:a.name,invocation});
 74   assert.equal(start.status,200,JSON.stringify(start.body));
 75   const credential=await a.page.evaluate(async (options)=>{
 76     const dec=s=>Uint8Array.from(atob(s.replace(/-/g,"+").replace(/_/g,"/")),c=>c.charCodeAt(0));
 77     options.publicKey.challenge=dec(options.publicKey.challenge);
 78     for(const c of options.publicKey.allowCredentials) c.id=dec(c.id);
 79     const credential=await navigator.credentials.get(options);
 80     return credential.toJSON();
 81   },start.body.options);
 82   return {request_id:start.body.request_id,credential,invocation};
 83 }
 84 function invoke(grant) { return {grant:grant.grant,resource:"urn:uac:lab:document",action:"Read",arguments:{document:"overview"}}; }
 85 async function resign(a,payload,change) {
 86   const {credentials}=await a.cdp.send("WebAuthn.getCredentials",{authenticatorId:a.authenticatorId});
 87   const own=credentials.find(c=>Buffer.from(c.credentialId,"base64").toString("base64url")===payload.credential.rawId);
 88   assert.ok(own,"virtual credential export available");
 89   const response=payload.credential.response;
 90   let client=JSON.parse(Buffer.from(response.clientDataJSON,"base64url").toString());
 91   let auth=Buffer.from(response.authenticatorData,"base64url");
 92   change(client,auth);
 93   const clientBytes=Buffer.from(JSON.stringify(client));
 94   response.clientDataJSON=clientBytes.toString("base64url");
 95   response.authenticatorData=auth.toString("base64url");
 96   const key=createPrivateKey({key:Buffer.from(own.privateKey,"base64"),format:"der",type:"pkcs8"});
 97   response.signature=sign("sha256",Buffer.concat([auth,createHash("sha256").update(clientBytes).digest()]),key).toString("base64url");
 98   return payload;
 99 }
100 try {
101   await startServer();
102   browser=await chromium.launch({executablePath:"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",headless:true,args:["--disable-background-networking"],timeout:20000});
103   const owner=await actor("owner"),guest=await actor("guest"),foreign=await actor("foreign");
104   let ownerSession,guestSession,grant;
105   await test("browser owner passkey registration",async()=>assert.equal((await registration(owner)).owner,true));
106   await test("browser guest passkey registration",async()=>assert.equal((await registration(guest)).owner,false));
107   await test("browser foreign holder registration",async()=>assert.equal((await registration(foreign)).owner,false));
108   await test("browser owner authentication",async()=>{ownerSession=await login(owner);assert.ok(ownerSession);});
109   await test("browser guest authentication",async()=>{guestSession=await login(guest);assert.ok(guestSession);});
110   await test("owner grant issuance through UI",async()=>{
111     const response=owner.page.waitForResponse(r=>r.url().endsWith("/api/grants") && r.request().method()==="POST");
112     await owner.page.locator("#issue").click();const r=await response;assert.equal(r.status(),200);grant=await r.json();
113     assert.equal(grant.guest,"guest");
114   });
115   await test("guest grant invocation through UI",async()=>{
116     await guest.page.locator("#refresh").click();
117     await guest.page.locator(".grant button").first().waitFor();
118     const response=guest.page.waitForResponse(r=>r.url().endsWith("/api/auth/finish"));
119     await guest.page.locator(".grant button").first().click();const r=await response;assert.equal(r.status(),200);assert.equal((await r.json()).authorized,true);
120     await guest.page.waitForFunction(()=>document.querySelector("#result").textContent.includes('"authorized": true'));
121     await guest.page.screenshot({path:join(evidence,"browser-success.png"),fullPage:true});
122   });
123   await test("copied token without session cannot issue grants",async()=>assert.equal((await post(guest,"/api/grants",{guest_name:"guest",ttl_seconds:300})).status,401));
124   await test("guest cannot issue grants",async()=>assert.equal((await post(guest,"/api/grants",{guest_name:"foreign",ttl_seconds:300},guestSession)).status,403));
