477         i.body.arguments_hash = [0; 32];
478         i = sign_invocation(&key(3), i.body).unwrap();
479         assert_eq!(check(&mut v, &c, &i, NOW), Err(Error::Invocation));
480     }
481 
482     #[test]
483     fn rejects_request_action_outside_context() {
484         let (mut v, c, mut i) = fixture();
485         i.body.action = Action::Write;
486         i = sign_invocation(&key(3), i.body).unwrap();
487         assert_eq!(check(&mut v, &c, &i, NOW), Err(Error::Invocation));
488     }
489 
490     #[test]
491     fn rejects_old_invocation_at_boundary() {
492         let (mut v, c, i) = fixture();
493         assert_eq!(check(&mut v, &c, &i, 130), Err(Error::Time));
494     }
495 
496     #[test]
497     fn rejects_descendant_of_revoked_parent() {
498         let (mut v, c, i) = fixture();
499         v.revoke(grant_id(&c[0]).unwrap());
500         assert_eq!(check(&mut v, &c, &i, NOW), Err(Error::Revoked));
501     }
502 
503     #[test]
504     fn offline_verifier_cannot_know_remote_revocation() {
505         let (mut offline, c, i) = fixture();
506         let (mut online, _, _) = fixture();
507         online.revoke(grant_id(&c[0]).unwrap());
508         assert_eq!(check(&mut online, &c, &i, NOW), Err(Error::Revoked));
509         assert_eq!(check(&mut offline, &c, &i, NOW), Ok(()));
510     }
511 
512     #[test]
513     fn rejects_empty_and_excessive_chains() {
514         let (mut v, c, i) = fixture();
515         assert_eq!(check(&mut v, &[], &i, NOW), Err(Error::Limits));
516         assert_eq!(
517             check(&mut v, &vec![c[0].clone(); MAX_CHAIN + 1], &i, NOW),
518             Err(Error::Limits)
519         );
520     }
521 
522     #[test]
523     fn rejects_oversized_and_unknown_fields_before_verification() {
524         assert!(matches!(
525             decode_grant(&vec![0; MAX_GRANT_BYTES + 1]),
526             Err(Error::Limits)
527         ));
528         let (_, c, _) = fixture();
529         let mut value = serde_json::to_value(&c[0]).unwrap();
530         value["body"]["geofence"] = serde_json::json!({"radius":25});
531         assert!(matches!(
532             decode_grant(&serde_json::to_vec(&value).unwrap()),
533             Err(Error::Encoding)
534         ));
535         assert!(decode_grant(&serde_json::to_vec(&c[0]).unwrap()).is_ok());
536     }
537 }
