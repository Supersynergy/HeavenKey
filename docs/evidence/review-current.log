scripts/e2e.mjs --- JavaScript
  1 import { chromium } from "playwright-core";
  2 import { spawn } from "node:child_process";
  3 import { createHash, createPrivateKey, sign } from "node:crypto";
  4 import { mkdtemp, writeFile, mkdir, rm } from "node:fs/promises";
  5 import { join, resolve } from "node:path";
  6 import { tmpdir } from "node:os";
  7 import assert from "node:assert/strict";
  8 
  9 const root = resolve(".");
 10 const evidence = join(root, "docs/evidence");
 11 await mkdir(evidence, { recursive: true });
 12 const data = await mkdtemp(join(tmpdir(), "uac-sim-"));
 13 const port = 18241;
 14 const origin = `http://localhost:${port}`;
 15 let server, browser;
 16 const cases = [];
 17 const actors = [];
 18 let fatalError;
 19 const started = performance.now();
 20 async function test(name, action) {
 21   const start = performance.now();
 22   try { await action(); cases.push({ name, pass: true, elapsed_ms: Math.round(performance.now()-start) }); console.log(`PASS ${name}`); }
 23   catch (e) { cases.push({ name, pass: false, error: e.message }); throw e; }
 24 }
 25 async function startServer() {
 26   server = spawn(join(root,"target/debug/uac-api"), [], { cwd:root, env:{ ...process.env,UAC_PORT:String(port),UAC_DATA:data }, stdio:["ignore","pipe","pipe"] });
 27   let output = "";
 28   server.stdout.on("data", d => output += d); server.stderr.on("data", d => output += d);
 29   const end = Date.now()+15000;
 30   while (Date.now()<end) {
 31     if (server.exitCode !== null) throw new Error(`server exited: ${output}`);
 32     try { if ((await fetch(`${origin}/health`,{ signal:AbortSignal.timeout(1000) })).ok) return; } catch {}
 33     await new Promise(r => setTimeout(r,100));
 34   }
 35   throw new Error(`server startup timeout: ${output}`);
 36 }
 37 async function stopServer() {
 38   if (!server || server.exitCode !== null) return;
 39   server.kill("SIGINT");
 40   const end=Date.now()+5000;
 41   while(server.exitCode===null && Date.now()<end) await new Promise(r=>setTimeout(r,50));
 42   if(server.exitCode===null) { server.kill("SIGKILL"); await new Promise(r=>server.once("exit",r)); }
 43 }
 44 async function actor(name) {
 45   const context=await browser.newContext();
 46   const page=await context.newPage();
 47   const errors=[];page.on("pageerror",e=>errors.push(e.message));
 48   const cdp=await context.newCDPSession(page);
 49   await cdp.send("WebAuthn.enable");
 50   const {authenticatorId}=await cdp.send("WebAuthn.addVirtualAuthenticator",{ options:{ protocol:"ctap2",ctap2Version:"ctap2_1",transport:"internal",hasResidentKey:true,hasUserVerification:true,isUserVerified:true,automaticPresenceSimulation:true } });
 51   await page.goto(origin);
 52   await page.waitForFunction(()=>document.documentElement.dataset.ready==="true",null,{timeout:10000});
 53   await page.locator("#name").fill(name);
 54   const a={name,context,page,cdp,authenticatorId,errors};actors.push(a);return a;
 55 }
 56 async function post(actor,path,body,session) {
 57   return actor.page.evaluate(async ({path,body,session})=>{
 58     const r=await fetch(path,{method:"POST",headers:{"Content-Type":"application/json",...(session?{Authorization:`Bearer ${session}`}:{})},body:JSON.stringify(body)});
 59     return {status:r.status,body:await r.json()};
 60   },{path,body,session});
 61 }
 62 async function login(a) {
 63   const response=a.page.waitForResponse(r=>r.url().endsWith("/api/auth/finish"));
 64   await a.page.locator("#login").click();
 65   const r=await response; assert.equal(r.status(),200);
 66   const value=await r.json();
 67   await a.page.waitForFunction(()=>document.querySelector("#status").textContent.includes("Sitzung ist aktiv"));
 68   return value.session;
 69 }
 70 async function registration(a) {
 71   const response=a.page.waitForResponse(r=>r.url().endsWith("/api/register/finish"));
 72   await a.page.locator("#register").click();
 73   const r=await Promise.race([response,a.page.waitForFunction(()=>document.querySelector("#status").dataset.error==="true").then(async()=>{throw new Error(await a.page.locator("#status").innerText());})]);assert.equal(r.status(),200);
 74   return r.json();
 75 }
 76 async function assertion(a,invocation=null) {
 77   const start=await post(a,"/api/auth/start",{name:a.name,invocation});
 78   assert.equal(start.status,200,JSON.stringify(start.body));
 79   const credential=await a.page.evaluate(async (options)=>{
 80     const dec=s=>Uint8Array.from(atob(s.replace(/-/g,"+").replace(/_/g,"/")),c=>c.charCodeAt(0));
 81     options.publicKey.challenge=dec(options.publicKey.challenge);
 82     for(const c of options.publicKey.allowCredentials) c.id=dec(c.id);
 83     const credential=await navigator.credentials.get(options);
 84     return credential.toJSON();
 85   },start.body.options);
 86   return {request_id:start.body.request_id,credential,invocation};
 87 }
 88 function invoke(grant) { return {grant:grant.grant,resource:"urn:uac:lab:document",action:"Read",arguments:{document:"overview"}}; }
 89 async function resign(a,payload,change) {
 90   const {credentials}=await a.cdp.send("WebAuthn.getCredentials",{authenticatorId:a.authenticatorId});
 91   const own=credentials.find(c=>Buffer.from(c.credentialId,"base64").toString("base64url")===payload.credential.rawId);
 92   assert.ok(own,"virtual credential export available");
 93   const response=payload.credential.response;
 94   let client=JSON.parse(Buffer.from(response.clientDataJSON,"base64url").toString());
 95   let auth=Buffer.from(response.authenticatorData,"base64url");
 96   change(client,auth);
 97   const clientBytes=Buffer.from(JSON.stringify(client));
 98   response.clientDataJSON=clientBytes.toString("base64url");
 99   response.authenticatorData=auth.toString("base64url");
100   const key=createPrivateKey({key:Buffer.from(own.privateKey,"base64"),format:"der",type:"pkcs8"});
101   response.signature=sign("sha256",Buffer.concat([auth,createHash("sha256").update(clientBytes).digest()]),key).toString("base64url");
102   return payload;
103 }
104 try {
105   await startServer();
106   browser=await chromium.launch({executablePath:"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",headless:true,args:["--disable-background-networking"],timeout:20000});
107   const owner=await actor("owner"),guest=await actor("guest"),foreign=await actor("foreign");
108   let ownerSession,guestSession,grant;
109   await test("browser owner passkey registration",async()=>assert.equal((await registration(owner)).owner,true));
110   await test("browser guest passkey registration",async()=>assert.equal((await registration(guest)).owner,false));
111   await test("browser foreign holder registration",async()=>assert.equal((await registration(foreign)).owner,false));
112   await test("browser owner authentication",async()=>{ownerSession=await login(owner);assert.ok(ownerSession);});
113   await test("browser guest authentication",async()=>{guestSession=await login(guest);assert.ok(guestSession);});
114   await test("owner grant issuance through UI",async()=>{
115     const response=owner.page.waitForResponse(r=>r.url().endsWith("/api/grants") && r.request().method()==="POST");
116     await owner.page.locator("#issue").click();const r=await response;assert.equal(r.status(),200);grant=await r.json();
117     assert.equal(grant.guest,"guest");
118   });
119   await test("guest grant invocation through UI",async()=>{
120     await guest.page.locator("#refresh").click();
121     await guest.page.locator(".grant button").first().waitFor();
122     const response=guest.page.waitForResponse(r=>r.url().endsWith("/api/auth/finish"));
123     await guest.page.locator(".grant button").first().click();const r=await response;assert.equal(r.status(),200);assert.equal((await r.json()).authorized,true);
124     await guest.page.waitForFunction(()=>document.querySelector("#result").textContent.includes('"authorized": true'));
125     await guest.page.screenshot({path:join(evidence,"browser-success.png"),fullPage:true});
126   });
127   await test("copied token without session cannot issue grants",async()=>assert.equal((await post(guest,"/api/grants",{guest_name:"guest",ttl_seconds:300})).status,401));
128   await test("guest cannot issue grants",async()=>assert.equal((await post(guest,"/api/grants",{guest_name:"foreign",ttl_seconds:300},guestSession)).status,403));
129   await test("foreign holder denied before ceremony",async()=>assert.equal((await post(foreign,"/api/auth/start",{name:"foreign",invocation:invoke(grant)})).status,403));
130   await test("write escalation denied",async()=>{const i=invoke(grant);i.action="Write";assert.equal((await post(guest,"/api/auth/start",{name:"guest",invocation:i})).status,403);});
131   await test("foreign resource denied",async()=>{const i=invoke(grant);i.resource="urn:uac:other";assert.equal((await post(guest,"/api/auth/start",{name:"guest",invocation:i})).status,403);});
132   await test("modified signed grant denied",async()=>{const i=invoke(structuredClone(grant));i.grant.body.expires_at+=999;assert.equal((await post(guest,"/api/auth/start",{name:"guest",invocation:i})).status,403);});
133   await test("bound invocation arguments cannot change",async()=>{const p=await assertion(guest,invoke(grant));p.invocation.arguments.document="different";assert.equal((await post(guest,"/api/auth/finish",p)).status,403);});
134   await test("bound invocation cannot become login",async()=>{const p=await assertion(guest,invoke(grant));p.invocation=null;assert.equal((await post(guest,"/api/auth/finish",p)).status,403);});
