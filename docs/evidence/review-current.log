2229 342 async fn auth_start(
2230 343     State(app): State<App>,
2231 344     Json(input): Json<AuthStart>,
2232 345 ) -> ApiResult<Json<Value>> {
2233 346     let mut inner = app.inner.lock().map_err(internal)?;
2234 347     inner.prune();
2235 348     if inner.authentications.len() >= MAX_PENDING {
2236 349         return Err(ApiError(StatusCode::TOO_MANY_REQUESTS, "ceremony_limit"));
2237 350     }
2238 351     let user = inner.user("name", &input.name)?;
2239 352     if let Some(invocation) = &input.invocation {
2240 353         inner.grant_allowed(&user, invocation)?;
2241 354     }
2242 355     let (options, state) = inner
2243 356         .webauthn
2244 357         .start_passkey_authentication(std::slice::from_ref(&user.passkey))
2245 358         .map_err(internal)?;
2246 359     let request_id = Uuid::new_v4().to_string();
2247 360     let bound = binding(&input.invocation)?;
2248 361     inner.authentications.insert(
2249 362         request_id.clone(),
2250 363         Authentication {
2251 364             user,
2252 365             state,
2253 366             invocation: input.invocation,
2254 367             expires: now() + CEREMONY_TTL,
2255 368         },
2256 369     );
2257 370     Ok(Json(
2258 371         json!({"request_id":request_id,"options":options,"invocation_binding":URL_SAFE_NO_PAD.encode(bound)}),
2259 372     ))
2260 373 }
