4167 scripts/e2e.mjs --- JavaScript
4168   1 import { chromium } from "playwright-core";
4169   2 import { spawn } from "node:child_process";
4170   3 import { createHash, createPrivateKey, sign } from "node:crypto";
4171   4 import { mkdtemp, writeFile, mkdir, rm } from "node:fs/promises";
4172   5 import { join, resolve } from "node:path";
4173   6 import { tmpdir } from "node:os";
4174   7 import assert from "node:assert/strict";
4175   8 
4176   9 const root = resolve(".");
4177  10 const evidence = join(root, "docs/evidence");
4178  11 await mkdir(evidence, { recursive: true });
4179  12 const data = await mkdtemp(join(tmpdir(), "uac-sim-"));
4180  13 const port = 18241;
4181  14 const origin = `http://localhost:${port}`;
4182  15 let server, browser;
4183  16 const cases = [];
4184  17 const started = performance.now();
4185  18 async function test(name, action) {
4186  19   const start = performance.now();
4187  20   try { await action(); cases.push({ name, pass: true, elapsed_ms: Math.round(performance.now()-start) }); console.log(`PASS ${name}`); }
4188  21   catch (e) { cases.push({ name, pass: false, error: e.message }); throw e; }
4189  22 }
4190  23 async function startServer() {
4191  24   server = spawn(join(root,"target/debug/uac-api"), [], { cwd:root, env:{ ...process.env,UAC_PORT:String(port),UAC_DATA:data }, stdio:["ignore","pipe","pipe"], detached:true });
4192  25   let output = "";
4193  26   server.stdout.on("data", d => output += d); server.stderr.on("data", d => output += d);
4194  27   const end = Date.now()+15000;
4195  28   while (Date.now()<end) {
4196  29     if (server.exitCode !== null) throw new Error(`server exited: ${output}`);
4197  30     try { if ((await fetch(`${origin}/health`,{ signal:AbortSignal.timeout(1000) })).ok) return; } catch {}
4198  31     await new Promise(r => setTimeout(r,100));
4199  32   }
4200  33   throw new Error(`server startup timeout: ${output}`);
4201  34 }
4202  35 async function stopServer() {
4203  36   if (!server || server.exitCode !== null) return;
4204  37   process.kill(-server.pid,"SIGINT");
4205  38   const end=Date.now()+5000;
4206  39   while(server.exitCode===null && Date.now()<end) await new Promise(r=>setTimeout(r,50));
4207  40   if(server.exitCode===null) { process.kill(-server.pid,"SIGKILL"); await new Promise(r=>server.once("exit",r)); }
4208  41 }
4209  42 async function actor(name) {
4210  43   const context=await browser.newContext();
4211  44   const page=await context.newPage();
4212  45   const cdp=await context.newCDPSession(page);
4213  46   await cdp.send("WebAuthn.enable");
4214  47   const {authenticatorId}=await cdp.send("WebAuthn.addVirtualAuthenticator",{ options:{ protocol:"ctap2",ctap2Version:"ctap2_1",transport:"internal",hasResidentKey:true,hasUserVerification:true,isUserVerified:true,automaticPresenceSimulation:true } });
4215  48   await page.goto(origin);
4216  49   await page.locator("#name").fill(name);
4217  50   return {name,context,page,cdp,authenticatorId};
4218  51 }
4219  52 async function post(actor,path,body,session) {
4220  53   return actor.page.evaluate(async ({path,body,session})=>{
4221  54     const r=await fetch(path,{method:"POST",headers:{"Content-Type":"application/json",...(session?{Authorization:`Bearer ${session}`}:{})},body:JSON.stringify(body)});
4222  55     return {status:r.status,body:await r.json()};
4223  56   },{path,body,session});
4224  57 }
4225  58 async function login(a) {
4226  59   const response=a.page.waitForResponse(r=>r.url().endsWith("/api/auth/finish"));
4227  60   await a.page.locator("#login").click();
4228  61   const r=await response; assert.equal(r.status(),200);
4229  62   const value=await r.json();
4230  63   await a.page.waitForFunction(()=>document.querySelector("#status").textContent.includes("Sitzung ist aktiv"));
4231  64   return value.session;
4232  65 }
4233  66 async function registration(a) {
4234  67   const response=a.page.waitForResponse(r=>r.url().endsWith("/api/register/finish"));
4235  68   await a.page.locator("#register").click();
4236  69   const r=await response;assert.equal(r.status(),200);
4237  70   return r.json();
4238  71 }
4239  72 async function assertion(a,invocation=null) {
4240  73   const start=await post(a,"/api/auth/start",{name:a.name,invocation});
4241  74   assert.equal(start.status,200,JSON.stringify(start.body));
4242  75   const credential=await a.page.evaluate(async (options)=>{
4243  76     const dec=s=>Uint8Array.from(atob(s.replace(/-/g,"+").replace(/_/g,"/")),c=>c.charCodeAt(0));
4244  77     options.publicKey.challenge=dec(options.publicKey.challenge);
4245  78     for(const c of options.publicKey.allowCredentials) c.id=dec(c.id);
4246  79     const credential=await navigator.credentials.get(options);
4247  80     return credential.toJSON();
4248  81   },start.body.options);
4249  82   return {request_id:start.body.request_id,credential,invocation};
4250  83 }
4251  84 function invoke(grant) { return {grant:grant.grant,resource:"urn:uac:lab:document",action:"Read",arguments:{document:"overview"}}; }
4252  85 async function resign(a,payload,change) {
4253  86   const {credentials}=await a.cdp.send("WebAuthn.getCredentials",{authenticatorId:a.authenticatorId});
4254  87   const own=credentials.find(c=>Buffer.from(c.credentialId,"base64").toString("base64url")===payload.credential.rawId);
4255  88   assert.ok(own,"virtual credential export available");
4256  89   const response=payload.credential.response;
4257  90   let client=JSON.parse(Buffer.from(response.clientDataJSON,"base64url").toString());
4258  91   let auth=Buffer.from(response.authenticatorData,"base64url");
4259  92   change(client,auth);
4260  93   const clientBytes=Buffer.from(JSON.stringify(client));
4261  94   response.clientDataJSON=clientBytes.toString("base64url");
4262  95   response.authenticatorData=auth.toString("base64url");
4263  96   const key=createPrivateKey({key:Buffer.from(own.privateKey,"base64"),format:"der",type:"pkcs8"});
4264  97   response.signature=sign("sha256",Buffer.concat([auth,createHash("sha256").update(clientBytes).digest()]),key).toString("base64url");
4265  98   return payload;
4266  99 }
