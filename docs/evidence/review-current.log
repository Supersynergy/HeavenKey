2262 375 async fn auth_finish(
2263 376     State(app): State<App>,
2264 377     Json(input): Json<AuthFinish>,
2265 378 ) -> ApiResult<Json<Value>> {
2266 379     let mut inner = app.inner.lock().map_err(internal)?;
2267 380     inner.prune();
2268 381     let mut pending = inner
2269 382         .authentications
2270 383         .remove(&input.request_id)
2271 384         .ok_or(forbidden("ceremony_missing"))?;
2272 385     if binding(&pending.invocation)? != binding(&input.invocation)? {
2273 386         return Err(forbidden("invocation_changed"));
2274 387     }
2275 388     // Reload the current counter before accepting concurrent ceremonies.
2276 389     let current = inner.user("id", &pending.user.id)?;
2277 390     let result = inner
2278 391         .webauthn
2279 392         .finish_passkey_authentication(&input.credential, &pending.state)
2280 393         .map_err(|_| ApiError(StatusCode::UNAUTHORIZED, "authentication_invalid"))?;
2281 394     if !result.user_verified() {
2282 395         return Err(ApiError(
2283 396             StatusCode::UNAUTHORIZED,
2284 397             "user_verification_required",
2285 398         ));
2286 399     }
2287 400     if (result.counter() > 0 || current.counter > 0) && result.counter() <= current.counter {
2288 401         return Err(ApiError(StatusCode::UNAUTHORIZED, "counter_not_increasing"));
2289 402     }
2290 403     pending.user.passkey = current.passkey;
2291 404     if pending.user.passkey.update_credential(&result).is_none() {
2292 405         return Err(ApiError(StatusCode::UNAUTHORIZED, "credential_mismatch"));
2293 406     }
2294 407     if let Some(invocation) = &pending.invocation {
2295 408         inner.grant_allowed(&pending.user, invocation)?;
2296 409     }
2297 410     let key_json = serde_json::to_string(&pending.user.passkey).map_err(internal)?;
2298 411     let tx = inner.db.transaction().map_err(internal)?;
2299 412     tx.execute(
2300 413         "UPDATE users SET passkey=?1,counter=?2 WHERE id=?3",
2301 414         params![key_json, result.counter(), pending.user.id],
2302 415     )
2303 416     .map_err(internal)?;
2304 417     if let Some(invocation) = &pending.invocation {
2305 418         let id = token_id(&invocation.grant)?;
2306 419         let inserted=tx.execute("INSERT INTO operations(id,grant_id,holder,created) SELECT ?1,?2,?3,?4 WHERE EXISTS(SELECT 1 FROM grants WHERE id=?2 AND revoked=0)",params![input.request_id,id,pending.user.id,now()]).map_err(internal)?;
2307 420         if inserted != 1 {
2308 421             return Err(forbidden("grant_revoked"));
2309 422         }
2310 423     }
2311 424     tx.commit().map_err(internal)?;
2312 425     if let Some(invocation) = pending.invocation {
2313 426         Ok(Json(
2314 427             json!({"authorized":true,"resource":invocation.resource,"action":invocation.action,"arguments":invocation.arguments,"operation":input.request_id,"data":"UAC example document — verified access"}),
2315 428         ))
2316 429     } else {
2317 430         let session = Uuid::new_v4().to_string();
2318 431         inner.sessions.insert(
2319 432             session.clone(),
2320 433             Session {
2321 434                 user_id: pending.user.id,
2322 435                 expires: now() + 300,
2323 436             },
2324 437         );
2325 438         Ok(Json(
2326 439             json!({"session":session,"name":pending.user.name,"owner":pending.user.owner}),
2327 440         ))
2328 441     }
2329 442 }
