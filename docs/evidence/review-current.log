2605  79     const expiry = document.createElement("span"); expiry.className = "note"; expiry.textContent = `Endet ${new Date(grant.grant.body.expires_at * 1000).toLocaleTimeString("de-DE")}`;
2606  80     const id = document.createElement("code"); id.textContent = grant.id;
