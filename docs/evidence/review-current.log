2436 549 #[tokio::main]
2437 550 async fn main() -> Result<(), Box<dyn std::error::Error>> {
2438 551     let port: u16 = std::env::var("UAC_PORT")
2439 552         .unwrap_or_else(|_| "18240".into())
2440 553         .parse()?;
2441 554     let origin = format!("http://localhost:{port}");
2442 555     let data = std::env::var("UAC_DATA").unwrap_or_else(|_| "data".into());
2443 556     fs::create_dir_all(&data)?;
2444 557     let key_path = Path::new(&data).join("issuer.key");
2445 558     let bytes = if key_path.exists() {
2446 559         fs::read(&key_path)?
2447 560     } else {
2448 561         let mut bytes = [0; 32];
2449 562         rand::rng().fill_bytes(&mut bytes);
2450 563         let mut options = fs::OpenOptions::new();
2451 564         options.write(true).create_new(true);
2452 565         #[cfg(unix)]
2453 566         {
2454 567             use std::os::unix::fs::OpenOptionsExt;
2455 568             options.mode(0o600);
2456 569         }
2457 570         let mut f = options.open(&key_path)?;
2458 571         f.write_all(&bytes)?;
2459 572         f.sync_all()?;
2460 573         bytes.to_vec()
2461 574     };
2462 575     let issuer = SigningKey::from_bytes(&bytes.try_into().map_err(|_| "invalid issuer key")?);
2463 576     let db = Connection::open(Path::new(&data).join("uac.sqlite"))?;
2464 577     db.busy_timeout(Duration::from_secs(2))?;
2465 578     db.execute_batch("PRAGMA journal_mode=WAL; PRAGMA foreign_keys=ON; CREATE TABLE IF NOT EXISTS users(id TEXT PRIMARY KEY,name TEXT UNIQUE NOT NULL,owner INTEGER NOT NULL,credential_id TEXT UNIQUE NOT NULL,passkey TEXT NOT NULL,counter INTEGER NOT NULL DEFAULT 0); CREATE TABLE IF NOT EXISTS grants(id TEXT PRIMARY KEY,guest_id TEXT REFERENCES users(id),token TEXT NOT NULL,revoked INTEGER NOT NULL DEFAULT 0); CREATE TABLE IF NOT EXISTS operations(id TEXT PRIMARY KEY,grant_id TEXT REFERENCES grants(id),holder TEXT REFERENCES users(id),created INTEGER NOT NULL);")?;
2466 579     let webauthn = WebauthnBuilder::new("localhost", &Url::parse(&origin)?)?
2467 580         .rp_name("UAC local lab")
2468 581         .build()?;
2469 582     let app = App {
2470 583         inner: Arc::new(Mutex::new(Inner {
2471 584             db,
2472 585             webauthn,
2473 586             issuer,
2474 587             registrations: HashMap::new(),
2475 588             authentications: HashMap::new(),
2476 589             sessions: HashMap::new(),
2477 590         })),
2478 591         origin: origin.clone(),
2479 592         host: format!("localhost:{port}"),
2480 593     };
2481 594     let router = Router::new()
2482 595         .route("/", get(index))
2483 596         .route("/main.js", get(script))
2484 597         .route("/style.css", get(style))
2485 598         .route(
2486 599             "/health",
2487 600             get(|| async { Json(json!({"status":"ok","mode":"simulation-lab"})) }),
2488 601         )
2489 602         .route("/api/register/start", post(register_start))
2490 603         .route("/api/register/finish", post(register_finish))
2491 604         .route("/api/auth/start", post(auth_start))
2492 605         .route("/api/auth/finish", post(auth_finish))
2493 606         .route("/api/grants", get(grants).post(create_grant))
2494 607         .route("/api/grants/revoke", post(revoke_grant))
2495 608         .layer(DefaultBodyLimit::max(32 * 1024))
2496 609         .layer(middleware::from_fn_with_state(app.clone(), origin_guard))
2497 610         .with_state(app);
2498 611     let listener = tokio::net::TcpListener::bind((std::net::Ipv4Addr::LOCALHOST, port)).await?;
2499 612     println!("UAC lab listening on {origin}; hardware verification deferred");
2500 613     axum::serve(listener, router)
2501 614         .with_graceful_shutdown(async {
2502 615             if let Err(e) = tokio::signal::ctrl_c().await {
2503 616                 eprintln!("shutdown signal: {e}");
2504 617             }
2505 618         })
2506 619         .await?;
2507 620     Ok(())
2508 621 }
