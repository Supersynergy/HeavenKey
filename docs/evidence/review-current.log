549 #[tokio::main]
550 async fn main() -> Result<(), Box<dyn std::error::Error>> {
551     let port: u16 = std::env::var("UAC_PORT")
552         .unwrap_or_else(|_| "18240".into())
553         .parse()?;
554     let origin = format!("http://localhost:{port}");
555     let data = std::env::var("UAC_DATA").unwrap_or_else(|_| "data".into());
556     fs::create_dir_all(&data)?;
557     let key_path = Path::new(&data).join("issuer.key");
558     let bytes = if key_path.exists() {
559         fs::read(&key_path)?
560     } else {
561         let mut bytes = [0; 32];
562         rand::rng().fill_bytes(&mut bytes);
563         let mut options = fs::OpenOptions::new();
564         options.write(true).create_new(true);
565         #[cfg(unix)]
566         {
567             use std::os::unix::fs::OpenOptionsExt;
568             options.mode(0o600);
569         }
570         let mut f = options.open(&key_path)?;
571         f.write_all(&bytes)?;
572         f.sync_all()?;
573         bytes.to_vec()
574     };
575     let issuer = SigningKey::from_bytes(&bytes.try_into().map_err(|_| "invalid issuer key")?);
576     let db = Connection::open(Path::new(&data).join("uac.sqlite"))?;
577     db.busy_timeout(Duration::from_secs(2))?;
578     db.execute_batch("PRAGMA journal_mode=WAL; PRAGMA foreign_keys=ON; CREATE TABLE IF NOT EXISTS users(id TEXT PRIMARY KEY,name TEXT UNIQUE NOT NULL,owner INTEGER NOT NULL,credential_id TEXT UNIQUE NOT NULL,passkey TEXT NOT NULL,counter INTEGER NOT NULL DEFAULT 0); CREATE TABLE IF NOT EXISTS grants(id TEXT PRIMARY KEY,guest_id TEXT REFERENCES users(id),token TEXT NOT NULL,revoked INTEGER NOT NULL DEFAULT 0); CREATE TABLE IF NOT EXISTS operations(id TEXT PRIMARY KEY,grant_id TEXT REFERENCES grants(id),holder TEXT REFERENCES users(id),created INTEGER NOT NULL);")?;
579     let webauthn = WebauthnBuilder::new("localhost", &Url::parse(&origin)?)?
580         .rp_name("UAC local lab")
581         .build()?;
582     let app = App {
583         inner: Arc::new(Mutex::new(Inner {
584             db,
585             webauthn,
586             issuer,
587             registrations: HashMap::new(),
588             authentications: HashMap::new(),
589             sessions: HashMap::new(),
590         })),
591         origin: origin.clone(),
592         host: format!("localhost:{port}"),
593     };
594     let router = Router::new()
595         .route("/", get(index))
596         .route("/main.js", get(script))
597         .route("/style.css", get(style))
598         .route(
599             "/health",
600             get(|| async { Json(json!({"status":"ok","mode":"simulation-lab"})) }),
601         )
602         .route("/api/register/start", post(register_start))
603         .route("/api/register/finish", post(register_finish))
604         .route("/api/auth/start", post(auth_start))
605         .route("/api/auth/finish", post(auth_finish))
606         .route("/api/grants", get(grants).post(create_grant))
607         .route("/api/grants/revoke", post(revoke_grant))
608         .layer(DefaultBodyLimit::max(32 * 1024))
609         .layer(middleware::from_fn_with_state(app.clone(), origin_guard))
610         .with_state(app);
611     let listener = tokio::net::TcpListener::bind((std::net::Ipv4Addr::LOCALHOST, port)).await?;
612     println!("UAC lab listening on {origin}; hardware verification deferred");
613     axum::serve(listener, router)
614         .with_graceful_shutdown(async {
615             if let Err(e) = tokio::signal::ctrl_c().await {
616                 eprintln!("shutdown signal: {e}");
617             }
618         })
619         .await?;
620     Ok(())
621 }
