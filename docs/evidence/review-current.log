2396 509 async fn grants(State(app): State<App>, headers: HeaderMap) -> ApiResult<Json<Value>> {
2397 510     let mut inner = app.inner.lock().map_err(internal)?;
2398 511     let user = inner.session_user(&headers)?;
2399 512     let mut stmt=inner.db.prepare("SELECT g.id,u.name,g.token,g.revoked FROM grants g JOIN users u ON u.id=g.guest_id WHERE ?1 OR g.guest_id=?2 ORDER BY g.rowid DESC LIMIT 100").map_err(internal)?;
2400 513     let rows = stmt
2401 514         .query_map(params![user.owner, user.id], |r| {
2402 515             Ok((
2403 516                 r.get::<_, String>(0)?,
2404 517                 r.get::<_, String>(1)?,
2405 518                 r.get::<_, String>(2)?,
2406 519                 r.get::<_, bool>(3)?,
2407 520             ))
2408 521         })
2409 522         .map_err(internal)?;
2410 523     let mut out = Vec::new();
2411 524     for row in rows {
2412 525         let (id, name, token, revoked) = row.map_err(internal)?;
2413 526         out.push(json!({"id":id,"guest":name,"grant":serde_json::from_str::<Value>(&token).map_err(internal)?,"revoked":revoked}));
2414 527     }
2415 528     Ok(Json(json!({"grants":out})))
2416 529 }
