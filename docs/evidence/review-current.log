2722   3 use ed25519_dalek::{Signature, Signer, SigningKey, VerifyingKey};
2723   4 use serde::{Deserialize, Serialize};
2724   5 use sha2::{Digest, Sha256};
2725   6 use std::collections::BTreeSet;
2726   7 
2727   8 const GRANT_DOMAIN: &[u8] = b"UAC-AUDIT-GRANT-v0\0";
2728   9 const INVOCATION_DOMAIN: &[u8] = b"UAC-AUDIT-INVOKE-v0\0";
2729  10 pub const MAX_CHAIN: usize = 8;
2730  11 pub const MAX_GRANT_BYTES: usize = 4096;
2731  12 
2732  13 #[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]
2733  14 pub enum Action {
2734  15     Read,
2735  16     Write,
2736  17     Unlock,
2737  18 }
2738  19 
2739  20 #[derive(Debug, Clone, Serialize, Deserialize)]
2740  21 #[serde(deny_unknown_fields)]
2741  22 pub struct Grant {
2742  23     pub issuer: [u8; 32],
2743  24     pub audience: [u8; 32],
2744  25     pub resource: String,
2745  26     pub actions: BTreeSet<Action>,
2746  27     pub not_before: u64,
2747  28     pub expires_at: u64,
2748  29     pub remaining_delegations: u8,
2749  30     pub parent: Option<[u8; 32]>,
2750  31 }
2751  32 
2752  33 #[derive(Debug, Clone, Serialize, Deserialize)]
2753  34 #[serde(deny_unknown_fields)]
2754  35 pub struct Invocation {
2755  36     pub grant: [u8; 32],
2756  37     pub resource: String,
2757  38     pub action: Action,
2758  39     pub arguments_hash: [u8; 32],
2759  40     pub nonce: [u8; 32],
2760  41     pub issued_at: u64,
2761  42 }
2762  43 
2763  44 #[derive(Debug, Clone, Serialize, Deserialize)]
2764  45 #[serde(deny_unknown_fields)]
2765  46 pub struct Signed<T> {
2766  47     pub body: T,
2767  48     pub signature: Vec<u8>,
2768  49 }
2769  50 
2770  51 #[derive(Debug, PartialEq, Eq)]
2771  52 pub enum Error {
2772  53     Encoding,
2773  54     Limits,
2774  55     Signature,
2775  56     UntrustedRoot,
2776  57     Chain,
2777  58     Escalation,
2778  59     Time,
2779  60     ClockRollback,
2780  61     Revoked,
2781  62     Invocation,
2782  63     Replay,
2783  64 }
2784  65 
2785  66 fn message<T: Serialize>(domain: &[u8], body: &T) -> Result<Vec<u8>, Error> {
2786  67     let mut bytes = domain.to_vec();
2787  68     bytes.extend(serde_json::to_vec(body).map_err(|_| Error::Encoding)?);
2788  69     Ok(bytes)
2789  70 }
2790  71 
2791  72 pub fn sign_grant(key: &SigningKey, body: Grant) -> Result<Signed<Grant>, Error> {
2792  73     let signature = key.sign(&message(GRANT_DOMAIN, &body)?).to_bytes().to_vec();
2793  74     Ok(Signed { body, signature })
2794  75 }
2795  76 
2796  77 pub fn sign_invocation(key: &SigningKey, body: Invocation) -> Result<Signed<Invocation>, Error> {
2797  78     let signature = key
2798  79         .sign(&message(INVOCATION_DOMAIN, &body)?)
2799  80         .to_bytes()
2800  81         .to_vec();
2801  82     Ok(Signed { body, signature })
2802  83 }
2803  84 
2804  85 fn verify_signature<T: Serialize>(
2805  86     signed: &Signed<T>,
2806  87     public: &[u8; 32],
2807  88     domain: &[u8],
2808  89 ) -> Result<(), Error> {
2809  90     let key = VerifyingKey::from_bytes(public).map_err(|_| Error::Signature)?;
2810  91     let signature = Signature::from_slice(&signed.signature).map_err(|_| Error::Signature)?;
2811  92     key.verify_strict(&message(domain, &signed.body)?, &signature)
2812  93         .map_err(|_| Error::Signature)
2813  94 }
2814  95 
2815  96 pub fn grant_id(signed: &Signed<Grant>) -> Result<[u8; 32], Error> {
2816  97     let mut hash = Sha256::new();
2817  98     hash.update(GRANT_DOMAIN);
2818  99     hash.update(serde_json::to_vec(signed).map_err(|_| Error::Encoding)?);
2819 100     Ok(hash.finalize().into())
2820 101 }
2821 102 
2822 103 pub fn decode_grant(bytes: &[u8]) -> Result<Signed<Grant>, Error> {
2823 104     if bytes.len() > MAX_GRANT_BYTES {
2824 105         return Err(Error::Limits);
2825 106     }
2826 107     serde_json::from_slice(bytes).map_err(|_| Error::Encoding)
2827 108 }
2828 109 
2829 110 pub fn authorize_passkey_grant(
2830 111     signed: &Signed<Grant>,
2831 112     root: &[u8; 32],
2832 113     verified_holder: &[u8; 32],
2833 114     resource: &str,
2834 115     action: Action,
2835 116     now: u64,
2836 117     revoked: bool,
2837 118 ) -> Result<(), Error> {
2838 119     if serde_json::to_vec(signed)
2839 120         .map_err(|_| Error::Encoding)?
2840 121         .len()
2841 122         > MAX_GRANT_BYTES
2842 123     {
2843 124         return Err(Error::Limits);
2844 125     }
2845 126     verify_signature(signed, &signed.body.issuer, GRANT_DOMAIN)?;
2846 127     let grant = &signed.body;
2847 128     if &grant.issuer != root || grant.parent.is_some() {
2848 129         return Err(Error::UntrustedRoot);
2849 130     }
2850 131     if revoked {
2851 132         return Err(Error::Revoked);
2852 133     }
2853 134     if &grant.audience != verified_holder
2854 135         || grant.resource != resource
2855 136         || !grant.actions.contains(&action)
2856 137     {
2857 138         return Err(Error::Invocation);
2858 139     }
2859 140     if grant.not_before >= grant.expires_at || now < grant.not_before || now >= grant.expires_at {
2860 141         return Err(Error::Time);
2861 142     }
2862 143     Ok(())
2863 144 }
2864 145 
2865 146 pub struct RequestContext<'a> {
2866 147     pub now: u64,
2867 148     pub action: Action,
2868 149     pub arguments_hash: [u8; 32],
2869 150     pub expected_nonce: &'a [u8; 32],
2870 151 }
2871 152 
2872 153 pub struct Verifier {
2873 154     root: [u8; 32],
2874 155     resource: String,
2875 156     revoked: BTreeSet<[u8; 32]>,
2876 157     seen_nonces: BTreeSet<[u8; 32]>,
2877 158     last_time: u64,
2878 159 }
2879 160 
2880 161 impl Verifier {
2881 162     pub fn new(root: [u8; 32], resource: String) -> Self {
2882 163         Self {
2883 164             root,
2884 165             resource,
2885 166             revoked: BTreeSet::new(),
2886 167             seen_nonces: BTreeSet::new(),
2887 168             last_time: 0,
2888 169         }
2889 170     }
2890 171 
2891 172     pub fn revoke(&mut self, id: [u8; 32]) {
2892 173         self.revoked.insert(id);
2893 174     }
2894 175 
2895 176     pub fn verify(
2896 177         &mut self,
2897 178         chain: &[Signed<Grant>],
2898 179         invocation: &Signed<Invocation>,
2899 180         context: RequestContext<'_>,
2900 181     ) -> Result<(), Error> {
2901 182         if chain.is_empty() || chain.len() > MAX_CHAIN {
2902 183             return Err(Error::Limits);
2903 184         }
2904 185         if context.now < self.last_time {
2905 186             return Err(Error::ClockRollback);
2906 187         }
2907 188         self.last_time = context.now;
2908 189         let mut previous: Option<&Signed<Grant>> = None;
2909 190         for signed in chain {
2910 191             let grant = &signed.body;
2911 192             if serde_json::to_vec(signed)
2912 193                 .map_err(|_| Error::Encoding)?
2913 194                 .len()
2914 195                 > MAX_GRANT_BYTES
2915 196             {
2916 197                 return Err(Error::Limits);
2917 198             }
2918 199             verify_signature(signed, &grant.issuer, GRANT_DOMAIN)?;
2919 200             if grant.actions.is_empty() || grant.resource != self.resource {
2920 201                 return Err(Error::Escalation);
2921 202             }
2922 203             if grant.not_before >= grant.expires_at
2923 204                 || context.now < grant.not_before
2924 205                 || context.now >= grant.expires_at
2925 206             {
2926 207                 return Err(Error::Time);
2927 208             }
2928 209             if self.revoked.contains(&grant_id(signed)?) {
2929 210                 return Err(Error::Revoked);
2930 211             }
2931 212             if let Some(parent) = previous {
2932 213                 let p = &parent.body;
2933 214                 if grant.issuer != p.audience || grant.parent != Some(grant_id(parent)?) {
2934 215                     return Err(Error::Chain);
2935 216                 }
2936 217                 if !grant.actions.is_subset(&p.actions)
2937 218                     || grant.not_before < p.not_before
2938 219                     || grant.expires_at > p.expires_at
2939 220                     || p.remaining_delegations == 0
2940 221                     || grant.remaining_delegations >= p.remaining_delegations
2941 222                 {
2942 223                     return Err(Error::Escalation);
2943 224                 }
2944 225             } else if grant.issuer != self.root || grant.parent.is_some() {
2945 226                 return Err(Error::UntrustedRoot);
2946 227             }
2947 228             previous = Some(signed);
2948 229         }
2949 230         let leaf = previous.ok_or(Error::Limits)?;
2950 231         let request = &invocation.body;
2951 232         verify_signature(invocation, &leaf.body.audience, INVOCATION_DOMAIN)?;
2952 233         if request.grant != grant_id(leaf)?
2953 234             || request.resource != self.resource
2954 235             || request.action != context.action
2955 236             || request.arguments_hash != context.arguments_hash
2956 237             || request.nonce != *context.expected_nonce
2957 238             || !leaf.body.actions.contains(&context.action)
2958 239         {
2959 240             return Err(Error::Invocation);
2960 241         }
2961 242         if context.now < request.issued_at || context.now - request.issued_at >= 30 {
2962 243             return Err(Error::Time);
2963 244         }
2964 245         if !self.seen_nonces.insert(request.nonce) {
2965 246             return Err(Error::Replay);
2966 247         }
2967 248         Ok(())
2968 249     }
2969 250 }
