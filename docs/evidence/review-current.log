2331 444 async fn create_grant(
2332 445     State(app): State<App>,
2333 446     headers: HeaderMap,
2334 447     Json(input): Json<GrantCreate>,
2335 448 ) -> ApiResult<Json<Value>> {
2336 449     if !(1..=3600).contains(&input.ttl_seconds) {
2337 450         return Err(ApiError(StatusCode::BAD_REQUEST, "invalid_expiry"));
2338 451     }
2339 452     let mut inner = app.inner.lock().map_err(internal)?;
2340 453     let owner = inner.session_user(&headers)?;
2341 454     if !owner.owner {
2342 455         return Err(forbidden("owner_required"));
2343 456     }
2344 457     let guest = inner.user("name", &input.guest_name)?;
2345 458     let time = now();
2346 459     let grant = sign_grant(
2347 460         &inner.issuer,
2348 461         Grant {
2349 462             issuer: inner.issuer.verifying_key().to_bytes(),
2350 463             audience: holder(&guest.passkey),
2351 464             resource: RESOURCE.into(),
2352 465             actions: [Action::Read].into(),
2353 466             not_before: time,
2354 467             expires_at: time + input.ttl_seconds,
2355 468             remaining_delegations: 0,
2356 469             parent: None,
2357 470         },
2358 471     )
2359 472     .map_err(internal)?;
2360 473     let id = token_id(&grant)?;
2361 474     inner
2362 475         .db
2363 476         .execute(
2364 477             "INSERT OR IGNORE INTO grants(id,guest_id,token,revoked) VALUES(?1,?2,?3,0)",
2365 478             params![
2366 479                 id,
2367 480                 guest.id,
2368 481                 serde_json::to_string(&grant).map_err(internal)?
2369 482             ],
2370 483         )
2371 484         .map_err(internal)?;
2372 485     Ok(Json(json!({"id":id,"grant":grant,"guest":guest.name})))
2373 486 }
