scripts/run.py --- Python
 1 from pathlib import Path
 2 from datetime import datetime, timezone
 3 import json
 4 import os
 5 import signal
 6 import subprocess
 7 import sys
 8 import time
 9 
10 root = Path(__file__).resolve().parent.parent
11 name, seconds, *command = sys.argv[1:]
12 if command and command[0] == '--':
13     command = command[1:]
14 deadline = datetime.fromisoformat(json.loads((root/'docs/evidence/budget.json').read_text())['deadline_utc'])
15 remaining = (deadline - datetime.now(timezone.utc)).total_seconds()
16 timeout = min(float(seconds), 7200) if name == 'manual-dev' else min(float(seconds), remaining)
17 if timeout <= 0:
18     raise SystemExit('eight-hour spike deadline exceeded')
19 env = dict(os.environ, CARGO_BUILD_JOBS='4', CARGO_TERM_COLOR='never', RUSTC_WRAPPER='', CARGO_TARGET_DIR=str(root/'target'))
20 start = time.monotonic()
21 logfile = root/'docs/evidence'/f'{name}.log'
22 
23 def kill_tree(pid):
24     rows = subprocess.check_output(['ps', '-axo', 'pid=,ppid='], text=True, timeout=5)
25     parents = {int(p):int(parent) for p,parent in (row.split() for row in rows.splitlines())}
26     ordered = [pid]
27     for parent in ordered:
28         ordered.extend(p for p,ppid in parents.items() if ppid == parent and p not in ordered)
29     for owned in reversed(ordered):
30         try:
31             os.kill(owned, signal.SIGKILL)
32         except ProcessLookupError:
33             pass
34     return ordered
35 
36 cleanup_pids = []
37 with logfile.open('w') as log:
38     child = subprocess.Popen(command, cwd=root, env=env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
39     try:
40         code = child.wait(timeout=timeout)
41     except subprocess.TimeoutExpired:
42         try:
43             cleanup_pids = kill_tree(child.pid)
44         except subprocess.SubprocessError:
45             try:
46                 os.killpg(child.pid, signal.SIGKILL)
47             except ProcessLookupError:
48                 pass
49         child.wait()
50         code = 124
51 event = {'name':name,'command':command,'exit_code':code,'elapsed_seconds':round(time.monotonic()-start,3),'time_utc':datetime.now(timezone.utc).isoformat(),'log':str(logfile),'timeout_cleanup_pids':cleanup_pids}
52 with (root/'docs/evidence/commands.jsonl').open('a') as ledger:
53     ledger.write(json.dumps(event)+'\n')
54 print(json.dumps(event))
55 if code:
56     print('\n'.join(logfile.read_text().splitlines()[-60:]))
57 raise SystemExit(code)
