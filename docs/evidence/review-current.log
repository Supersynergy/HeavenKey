2182 295 async fn register_finish(
2183 296     State(app): State<App>,
2184 297     Json(input): Json<RegisterFinish>,
2185 298 ) -> ApiResult<Json<Value>> {
2186 299     let mut inner = app.inner.lock().map_err(internal)?;
2187 300     inner.prune();
2188 301     let pending = inner
2189 302         .registrations
2190 303         .remove(&input.request_id)
2191 304         .ok_or(forbidden("ceremony_missing"))?;
2192 305     let key = inner
2193 306         .webauthn
2194 307         .finish_passkey_registration(&input.credential, &pending.state)
2195 308         .map_err(|_| ApiError(StatusCode::UNAUTHORIZED, "registration_invalid"))?;
2196 309     let duplicate: bool = inner
2197 310         .db
2198 311         .query_row(
2199 312             "SELECT EXISTS(SELECT 1 FROM users WHERE credential_id=?1)",
2200 313             [URL_SAFE_NO_PAD.encode(key.cred_id().as_ref())],
2201 314             |r| r.get(0),
2202 315         )
2203 316         .map_err(internal)?;
2204 317     if duplicate {
2205 318         return Err(ApiError(StatusCode::CONFLICT, "credential_exists"));
2206 319     }
2207 320     let owner: bool = inner
2208 321         .db
2209 322         .query_row("SELECT COUNT(*)=0 FROM users", [], |r| r.get(0))
2210 323         .map_err(internal)?;
2211 324     inner
2212 325         .db
2213 326         .execute(
2214 327             "INSERT INTO users(id,name,owner,credential_id,passkey) VALUES(?1,?2,?3,?4,?5)",
2215 328             params![
2216 329                 pending.user_id.to_string(),
2217 330                 pending.name,
2218 331                 owner,
2219 332                 URL_SAFE_NO_PAD.encode(key.cred_id().as_ref()),
2220 333                 serde_json::to_string(&key).map_err(internal)?
2221 334             ],
2222 335         )
2223 336         .map_err(|_| ApiError(StatusCode::CONFLICT, "registration_conflict"))?;
2224 337     Ok(Json(
2225 338         json!({"name":pending.name,"owner":owner,"registered":true}),
2226 339     ))
2227 340 }
