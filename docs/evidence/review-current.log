2001 114 }
2002 115 
2003 116 struct ApiError(StatusCode, &'static str);
2004 117 type ApiResult<T> = Result<T, ApiError>;
2005 118 impl IntoResponse for ApiError {
2006 119     fn into_response(self) -> Response {
2007 120         (self.0, Json(json!({"error":self.1}))).into_response()
2008 121     }
2009 122 }
2010 123 fn internal(error: impl std::fmt::Debug) -> ApiError {
2011 124     eprintln!("UAC internal error: {error:?}");
2012 125     ApiError(StatusCode::INTERNAL_SERVER_ERROR, "internal_error")
2013 126 }
2014 127 fn forbidden(code: &'static str) -> ApiError {
2015 128     ApiError(StatusCode::FORBIDDEN, code)
2016 129 }
2017 130 fn now() -> u64 {
2018 131     SystemTime::now()
2019 132         .duration_since(UNIX_EPOCH)
2020 133         .map_or(0, |d| d.as_secs())
2021 134 }
2022 135 fn holder(key: &Passkey) -> [u8; 32] {
2023 136     Sha256::digest(key.cred_id().as_ref()).into()
2024 137 }
2025 138 fn token_id(grant: &Signed<Grant>) -> ApiResult<String> {
2026 139     grant_id(grant)
2027 140         .map(|id| URL_SAFE_NO_PAD.encode(id))
2028 141         .map_err(internal)
2029 142 }
2030 143 fn binding(invocation: &Option<Invocation>) -> ApiResult<[u8; 32]> {
2031 144     Ok(Sha256::digest(serde_json::to_vec(invocation).map_err(internal)?).into())
2032 145 }
2033 146 
2034 147 impl Inner {
2035 148     fn prune(&mut self) {
2036 149         let time = now();
2037 150         self.registrations.retain(|_, v| v.expires > time);
2038 151         self.authentications.retain(|_, v| v.expires > time);
2039 152         self.sessions.retain(|_, v| v.expires > time);
2040 153     }
2041 154     fn user(&self, field: &str, value: &str) -> ApiResult<User> {
2042 155         let query = match field {
2043 156             "id" => "SELECT id,name,owner,passkey,counter FROM users WHERE id=?1",
2044 157             _ => "SELECT id,name,owner,passkey,counter FROM users WHERE name=?1",
2045 158         };
2046 159         let row = self
2047 160             .db
2048 161             .query_row(query, [value], |row| {
2049 162                 Ok((
2050 163                     row.get::<_, String>(0)?,
2051 164                     row.get::<_, String>(1)?,
2052 165                     row.get::<_, bool>(2)?,
2053 166                     row.get::<_, String>(3)?,
2054 167                     row.get::<_, u32>(4)?,
2055 168                 ))
2056 169             })
2057 170             .optional()
2058 171             .map_err(internal)?;
2059 172         let (id, name, owner, key, counter) =
2060 173             row.ok_or(ApiError(StatusCode::NOT_FOUND, "user_not_found"))?;
2061 174         Ok(User {
2062 175             id,
2063 176             name,
2064 177             owner,
2065 178             passkey: serde_json::from_str(&key).map_err(internal)?,
2066 179             counter,
2067 180         })
2068 181     }
2069 182     fn session_user(&mut self, headers: &HeaderMap) -> ApiResult<User> {
2070 183         self.prune();
2071 184         let token = headers
2072 185             .get("authorization")
2073 186             .and_then(|h| h.to_str().ok())
2074 187             .and_then(|v| v.strip_prefix("Bearer "))
2075 188             .ok_or(ApiError(StatusCode::UNAUTHORIZED, "session_required"))?;
2076 189         let s = self
2077 190             .sessions
2078 191             .get(token)
2079 192             .ok_or(ApiError(StatusCode::UNAUTHORIZED, "session_expired"))?;
2080 193         self.user("id", &s.user_id)
2081 194     }
2082 195     fn grant_allowed(&self, user: &User, invocation: &Invocation) -> ApiResult<()> {
2083 196         if invocation.arguments.len() > 8
2084 197             || invocation
2085 198                 .arguments
2086 199                 .iter()
2087 200                 .any(|(k, v)| k.len() > 64 || v.len() > 256)
2088 201         {
2089 202             return Err(forbidden("argument_limit"));
2090 203         }
2091 204         if invocation.resource != RESOURCE {
2092 205             return Err(forbidden("resource_denied"));
2093 206         }
2094 207         let id = token_id(&invocation.grant)?;
2095 208         let revoked = self
2096 209             .db
2097 210             .query_row("SELECT revoked FROM grants WHERE id=?1", [&id], |r| {
2098 211                 r.get::<_, bool>(0)
2099 212             })
2100 213             .optional()
2101 214             .map_err(internal)?
2102 215             .ok_or(forbidden("unknown_grant"))?;
2103 216         authorize_passkey_grant(
2104 217             &invocation.grant,
2105 218             &self.issuer.verifying_key().to_bytes(),
2106 219             &holder(&user.passkey),
2107 220             RESOURCE,
2108 221             invocation.action,
2109 222             now(),
2110 223             revoked,
2111 224         )
2112 225         .map_err(|_| forbidden("grant_denied"))
2113 226     }
2114 227 }
