  1 #![forbid(unsafe_code)]
  2 
  3 use ed25519_dalek::{Signature, Signer, SigningKey, VerifyingKey};
  4 use serde::{Deserialize, Serialize};
  5 use sha2::{Digest, Sha256};
  6 use std::collections::BTreeSet;
  7 
  8 const GRANT_DOMAIN: &[u8] = b"UAC-AUDIT-GRANT-v0\0";
  9 const INVOCATION_DOMAIN: &[u8] = b"UAC-AUDIT-INVOKE-v0\0";
 10 pub const MAX_CHAIN: usize = 8;
 11 pub const MAX_GRANT_BYTES: usize = 4096;
 12 
 13 #[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]
 14 pub enum Action {
 15     Read,
 16     Write,
 17     Unlock,
 18 }
 19 
 20 #[derive(Debug, Clone, Serialize, Deserialize)]
 21 #[serde(deny_unknown_fields)]
 22 pub struct Grant {
 23     pub issuer: [u8; 32],
 24     pub audience: [u8; 32],
 25     pub resource: String,
 26     pub actions: BTreeSet<Action>,
 27     pub not_before: u64,
 28     pub expires_at: u64,
 29     pub remaining_delegations: u8,
 30     pub parent: Option<[u8; 32]>,
 31 }
 32 
 33 #[derive(Debug, Clone, Serialize, Deserialize)]
 34 #[serde(deny_unknown_fields)]
 35 pub struct Invocation {
 36     pub grant: [u8; 32],
 37     pub resource: String,
 38     pub action: Action,
 39     pub arguments_hash: [u8; 32],
 40     pub nonce: [u8; 32],
 41     pub issued_at: u64,
 42 }
 43 
 44 #[derive(Debug, Clone, Serialize, Deserialize)]
 45 #[serde(deny_unknown_fields)]
 46 pub struct Signed<T> {
 47     pub body: T,
 48     pub signature: Vec<u8>,
 49 }
 50 
 51 #[derive(Debug, PartialEq, Eq)]
 52 pub enum Error {
 53     Encoding,
 54     Limits,
 55     Signature,
 56     UntrustedRoot,
 57     Chain,
 58     Escalation,
 59     Time,
 60     ClockRollback,
 61     Revoked,
 62     Invocation,
 63     Replay,
 64 }
 65 
 66 fn message<T: Serialize>(domain: &[u8], body: &T) -> Result<Vec<u8>, Error> {
 67     let mut bytes = domain.to_vec();
 68     bytes.extend(serde_json::to_vec(body).map_err(|_| Error::Encoding)?);
 69     Ok(bytes)
 70 }
 71 
 72 pub fn sign_grant(key: &SigningKey, body: Grant) -> Result<Signed<Grant>, Error> {
 73     let signature = key.sign(&message(GRANT_DOMAIN, &body)?).to_bytes().to_vec();
 74     Ok(Signed { body, signature })
 75 }
 76 
 77 pub fn sign_invocation(key: &SigningKey, body: Invocation) -> Result<Signed<Invocation>, Error> {
 78     let signature = key
 79         .sign(&message(INVOCATION_DOMAIN, &body)?)
 80         .to_bytes()
 81         .to_vec();
 82     Ok(Signed { body, signature })
 83 }
 84 
 85 fn verify_signature<T: Serialize>(
 86     signed: &Signed<T>,
 87     public: &[u8; 32],
 88     domain: &[u8],
 89 ) -> Result<(), Error> {
 90     let key = VerifyingKey::from_bytes(public).map_err(|_| Error::Signature)?;
 91     let signature = Signature::from_slice(&signed.signature).map_err(|_| Error::Signature)?;
 92     key.verify_strict(&message(domain, &signed.body)?, &signature)
 93         .map_err(|_| Error::Signature)
 94 }
 95 
 96 pub fn grant_id(signed: &Signed<Grant>) -> Result<[u8; 32], Error> {
 97     let mut hash = Sha256::new();
 98     hash.update(GRANT_DOMAIN);
 99     hash.update(serde_json::to_vec(signed).map_err(|_| Error::Encoding)?);
100     Ok(hash.finalize().into())
101 }
102 
103 pub fn decode_grant(bytes: &[u8]) -> Result<Signed<Grant>, Error> {
104     if bytes.len() > MAX_GRANT_BYTES {
105         return Err(Error::Limits);
106     }
107     serde_json::from_slice(bytes).map_err(|_| Error::Encoding)
108 }
109 
110 pub fn authorize_passkey_grant(
111     signed: &Signed<Grant>,
112     root: &[u8; 32],
113     verified_holder: &[u8; 32],
114     resource: &str,
115     action: Action,
116     now: u64,
117     revoked: bool,
118 ) -> Result<(), Error> {
119     if serde_json::to_vec(signed)
120         .map_err(|_| Error::Encoding)?
121         .len()
122         > MAX_GRANT_BYTES
123     {
124         return Err(Error::Limits);
125     }
126     verify_signature(signed, &signed.body.issuer, GRANT_DOMAIN)?;
127     let grant = &signed.body;
128     if &grant.issuer != root || grant.parent.is_some() {
129         return Err(Error::UntrustedRoot);
130     }
131     if revoked {
132         return Err(Error::Revoked);
133     }
134     if &grant.audience != verified_holder
135         || grant.resource != resource
136         || !grant.actions.contains(&action)
137     {
138         return Err(Error::Invocation);
139     }
140     if grant.not_before >= grant.expires_at || now < grant.not_before || now >= grant.expires_at {
141         return Err(Error::Time);
142     }
143     Ok(())
144 }
145 
146 pub struct RequestContext<'a> {
147     pub now: u64,
148     pub action: Action,
149     pub arguments_hash: [u8; 32],
150     pub expected_nonce: &'a [u8; 32],
151 }
152 
153 pub struct Verifier {
154     root: [u8; 32],
155     resource: String,
156     revoked: BTreeSet<[u8; 32]>,
157     seen_nonces: BTreeSet<[u8; 32]>,
158     last_time: u64,
159 }
160 
161 impl Verifier {
162     pub fn new(root: [u8; 32], resource: String) -> Self {
163         Self {
164             root,
165             resource,
166             revoked: BTreeSet::new(),
167             seen_nonces: BTreeSet::new(),
168             last_time: 0,
169         }
170     }
171 
172     pub fn revoke(&mut self, id: [u8; 32]) {
173         self.revoked.insert(id);
174     }
175 
176     pub fn verify(
177         &mut self,
178         chain: &[Signed<Grant>],
179         invocation: &Signed<Invocation>,
180         context: RequestContext<'_>,
181     ) -> Result<(), Error> {
182         if chain.is_empty() || chain.len() > MAX_CHAIN {
183             return Err(Error::Limits);
184         }
185         if context.now < self.last_time {
186             return Err(Error::ClockRollback);
187         }
188         self.last_time = context.now;
189         let mut previous: Option<&Signed<Grant>> = None;
190         for signed in chain {
191             let grant = &signed.body;
192             if serde_json::to_vec(signed)
193                 .map_err(|_| Error::Encoding)?
194                 .len()
195                 > MAX_GRANT_BYTES
196             {
197                 return Err(Error::Limits);
198             }
199             verify_signature(signed, &grant.issuer, GRANT_DOMAIN)?;
200             if grant.actions.is_empty() || grant.resource != self.resource {
201                 return Err(Error::Escalation);
202             }
203             if grant.not_before >= grant.expires_at
204                 || context.now < grant.not_before
205                 || context.now >= grant.expires_at
206             {
207                 return Err(Error::Time);
208             }
209             if self.revoked.contains(&grant_id(signed)?) {
210                 return Err(Error::Revoked);
211             }
212             if let Some(parent) = previous {
213                 let p = &parent.body;
214                 if grant.issuer != p.audience || grant.parent != Some(grant_id(parent)?) {
215                     return Err(Error::Chain);
216                 }
217                 if !grant.actions.is_subset(&p.actions)
218                     || grant.not_before < p.not_before
219                     || grant.expires_at > p.expires_at
220                     || p.remaining_delegations == 0
221                     || grant.remaining_delegations >= p.remaining_delegations
222                 {
223                     return Err(Error::Escalation);
224                 }
225             } else if grant.issuer != self.root || grant.parent.is_some() {
226                 return Err(Error::UntrustedRoot);
227             }
228             previous = Some(signed);
229         }
230         let leaf = previous.ok_or(Error::Limits)?;
231         let request = &invocation.body;
232         verify_signature(invocation, &leaf.body.audience, INVOCATION_DOMAIN)?;
233         if request.grant != grant_id(leaf)?
234             || request.resource != self.resource
235             || request.action != context.action
236             || request.arguments_hash != context.arguments_hash
237             || request.nonce != *context.expected_nonce
238             || !leaf.body.actions.contains(&context.action)
239         {
240             return Err(Error::Invocation);
241         }
242         if context.now < request.issued_at || context.now - request.issued_at >= 30 {
243             return Err(Error::Time);
244         }
245         if !self.seen_nonces.insert(request.nonce) {
246             return Err(Error::Replay);
247         }
248         Ok(())
249     }
250 }
