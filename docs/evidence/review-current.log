  1 type Grant = { id: string; guest: string; revoked: boolean; grant: { body: { expires_at: number; resource: string }; signature: number[] } };
  2 type Ceremony = { request_id: string; options: { publicKey: Record<string, unknown> } };
  3 let session: string | undefined;
  4 let isOwner = false;
  5 const el = <T extends HTMLElement>(id: string): T => {
  6   const value = document.getElementById(id);
  7   if (!value) throw new Error(`Element fehlt: ${id}`);
  8   return value as T;
  9 };
 10 const input = (id: string) => el<HTMLInputElement>(id).value;
 11 export function decode(value: string): Uint8Array {
 12   return Uint8Array.from(atob(value.replace(/-/g, "+").replace(/_/g, "/")), c => c.charCodeAt(0));
 13 }
 14 export function encode(value: ArrayBuffer): string {
 15   return btoa(String.fromCharCode(...new Uint8Array(value))).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
 16 }
 17 async function api<T>(path: string, body?: unknown): Promise<T> {
 18   const response = await fetch(path, { method: body === undefined ? "GET" : "POST", headers: { "Content-Type": "application/json", ...(session ? { Authorization: `Bearer ${session}` } : {}) }, ...(body === undefined ? {} : { body: JSON.stringify(body) }) });
 19   const value = await response.json();
 20   if (!response.ok) throw new Error(value.error || `HTTP ${response.status}`);
 21   return value as T;
 22 }
 23 function credentialJSON(value: PublicKeyCredential): object {
 24   if ("toJSON" in value && typeof value.toJSON === "function") return value.toJSON();
 25   const response = value.response;
 26   const common = { id: value.id, rawId: encode(value.rawId), type: value.type, extensions: value.getClientExtensionResults() };
 27   if (response instanceof AuthenticatorAttestationResponse) return { ...common, response: { attestationObject: encode(response.attestationObject), clientDataJSON: encode(response.clientDataJSON), transports: response.getTransports() } };
 28   if (response instanceof AuthenticatorAssertionResponse) return { ...common, response: { authenticatorData: encode(response.authenticatorData), clientDataJSON: encode(response.clientDataJSON), signature: encode(response.signature), userHandle: response.userHandle ? encode(response.userHandle) : null } };
 29   throw new Error("Unbekannte Credential-Antwort");
 30 }
 31 async function register(): Promise<void> {
 32   const name = input("name");
 33   const start = await api<Ceremony>("/api/register/start", { name });
 34   const key = start.options.publicKey;
 35   key.challenge = decode(key.challenge as string);
 36   const user = key.user as Record<string, unknown>;
 37   user.id = decode(user.id as string);
 38   if (key.excludeCredentials) for (const c of key.excludeCredentials as Record<string, unknown>[]) c.id = decode(c.id as string);
 39   const created = await navigator.credentials.create({ publicKey: key as unknown as PublicKeyCredentialCreationOptions });
 40   if (!(created instanceof PublicKeyCredential)) throw new Error("Einschreibung abgebrochen");
 41   await api("/api/register/finish", { request_id: start.request_id, credential: credentialJSON(created) });
 42   status(`Passkey für ${name} eingeschrieben. Jetzt anmelden.`, false);
 43 }
 44 async function authenticate(invocation?: object): Promise<Record<string, unknown>> {
 45   const start = await api<Ceremony>("/api/auth/start", { name: input("name"), invocation: invocation || null });
 46   const key = start.options.publicKey;
 47   key.challenge = decode(key.challenge as string);
 48   for (const c of key.allowCredentials as Record<string, unknown>[]) c.id = decode(c.id as string);
 49   const credential = await navigator.credentials.get({ publicKey: key as unknown as PublicKeyCredentialRequestOptions });
 50   if (!(credential instanceof PublicKeyCredential)) throw new Error("Anmeldung abgebrochen");
 51   return api("/api/auth/finish", { request_id: start.request_id, credential: credentialJSON(credential), invocation: invocation || null });
 52 }
 53 async function login(): Promise<void> {
 54   const result = await authenticate();
 55   session = result.session as string;
 56   isOwner = result.owner as boolean;
 57   el("identity").textContent = `${result.name} · ${isOwner ? "Eigentümer" : "Gast"}`;
 58   el<HTMLButtonElement>("issue").disabled = !isOwner;
 59   el<HTMLButtonElement>("refresh").disabled = false;
 60   status("Passkey geprüft. Sitzung ist aktiv.", false);
 61   await refresh();
 62 }
 63 function status(text: string, error: boolean): void {
 64   el("status").textContent = text;
 65   el("status").dataset.error = String(error);
 66   el("status").dataset.success = String(!error);
 67 }
 68 async function refresh(): Promise<void> {
 69   const result = await api<{ grants: Grant[] }>("/api/grants");
 70   const area = el("grants");
 71   area.replaceChildren();
 72   if (!result.grants.length) { const p = document.createElement("p"); p.className = "empty"; p.textContent = "Noch keine zugeordneten Zugänge."; area.append(p); }
 73   for (const grant of result.grants) {
 74     const row = document.createElement("div"); row.className = "grant"; row.dataset.id = grant.id;
 75     const text = document.createElement("div");
 76     const name = document.createElement("strong"); name.textContent = grant.guest;
 77     const expired = grant.grant.body.expires_at <= Date.now() / 1000;
 78     const badge = document.createElement("span"); badge.className = `badge ${grant.revoked || expired ? "revoked" : ""}`; badge.textContent = grant.revoked ? "Widerrufen" : expired ? "Abgelaufen" : "Leserecht";
 79     const expiry = document.createElement("span"); expiry.className = "note"; expiry.textContent = `Endet ${new Date(grant.grant.body.expires_at * 1000).toLocaleTimeString("de-DE")}`;
 80     const id = document.createElement("code"); id.textContent = grant.id;
 81     text.append(name, badge, expiry, document.createElement("br"), id);
 82     const actions = document.createElement("div"); actions.className = "buttons";
 83     const button = document.createElement("button"); button.textContent = isOwner ? "Widerrufen" : "Dokument lesen"; button.disabled = grant.revoked || (!isOwner && expired);
 84     button.addEventListener("click", () => void perform(button, async () => {
 85       if (isOwner) { await api("/api/grants/revoke", { id: grant.id }); status("Widerruf am Ziel bestätigt.", false); }
 86       else { const value = await authenticate({ grant: grant.grant, resource: grant.grant.body.resource, action: "Read", arguments: { document: "overview" } }); el("result").textContent = JSON.stringify(value, null, 2); status("Aufruf autorisiert und im Verifier bestätigt.", false); }
 87       await refresh();
 88     }));
 89     actions.append(button); row.append(text, actions); area.append(row);
 90   }
 91 }
 92 async function perform(button: HTMLButtonElement, action: () => Promise<void>): Promise<void> {
 93   button.disabled = true; button.setAttribute("aria-busy", "true");
 94   try { await action(); } catch (error) { status(error instanceof Error ? error.message : String(error), true); }
 95   finally { button.removeAttribute("aria-busy"); if (button.isConnected) button.disabled = false; }
 96 }
 97 for (const [id, action] of [["register", register], ["login", login], ["refresh", refresh]] as const) {
 98   const button = el<HTMLButtonElement>(id); button.addEventListener("click", () => void perform(button, action));
 99 }
100 el<HTMLButtonElement>("issue").addEventListener("click", () => void perform(el("issue"), async () => {
101   await api("/api/grants", { guest_name: input("guest"), ttl_seconds: Number(input("ttl")) });
102   status("Zugang an den Empfänger gebunden.", false); await refresh();
103 }));
104 document.documentElement.dataset.ready = "true";
