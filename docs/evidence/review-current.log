2136 249 async fn register_start(
2137 250     State(app): State<App>,
2138 251     Json(input): Json<RegisterStart>,
2139 252 ) -> ApiResult<Json<Value>> {
2140 253     if !(3..=32).contains(&input.name.len())
2141 254         || !input
2142 255             .name
2143 256             .chars()
2144 257             .all(|c| c.is_ascii_alphanumeric() || c == '-')
2145 258     {
2146 259         return Err(ApiError(StatusCode::BAD_REQUEST, "invalid_name"));
2147 260     }
2148 261     let mut inner = app.inner.lock().map_err(internal)?;
2149 262     inner.prune();
2150 263     if inner.registrations.len() >= MAX_PENDING {
2151 264         return Err(ApiError(StatusCode::TOO_MANY_REQUESTS, "ceremony_limit"));
2152 265     }
2153 266     let exists: bool = inner
2154 267         .db
2155 268         .query_row(
2156 269             "SELECT EXISTS(SELECT 1 FROM users WHERE name=?1)",
2157 270             [&input.name],
2158 271             |r| r.get(0),
2159 272         )
2160 273         .map_err(internal)?;
2161 274     if exists {
2162 275         return Err(ApiError(StatusCode::CONFLICT, "user_exists"));
2163 276     }
2164 277     let user_id = Uuid::new_v4();
2165 278     let (options, state) = inner
2166 279         .webauthn
2167 280         .start_passkey_registration(user_id, &input.name, &input.name, None)
2168 281         .map_err(internal)?;
2169 282     let request_id = Uuid::new_v4().to_string();
2170 283     inner.registrations.insert(
2171 284         request_id.clone(),
2172 285         Registration {
2173 286             name: input.name,
2174 287             user_id,
2175 288             state,
2176 289             expires: now() + CEREMONY_TTL,
2177 290         },
2178 291     );
2179 292     Ok(Json(json!({"request_id":request_id,"options":options})))
2180 293 }
