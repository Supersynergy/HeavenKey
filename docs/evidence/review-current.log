2116 229 async fn origin_guard(State(app): State<App>, req: Request, next: Next) -> Response {
2117 230     if req.headers().get("host").and_then(|h| h.to_str().ok()) != Some(&app.host) {
2118 231         return forbidden("host_denied").into_response();
2119 232     }
2120 233     if req.method() != axum::http::Method::GET
2121 234         && req.headers().get("origin").and_then(|h| h.to_str().ok()) != Some(&app.origin)
2122 235     {
2123 236         return forbidden("origin_denied").into_response();
2124 237     }
2125 238     let mut response = next.run(req).await;
2126 239     let headers = response.headers_mut();
2127 240     headers.insert("cache-control", "no-store".parse().expect("static header"));
2128 241     headers.insert(
2129 242         "x-content-type-options",
2130 243         "nosniff".parse().expect("static header"),
2131 244     );
2132 245     headers.insert("content-security-policy", "default-src 'self'; script-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'".parse().expect("static header"));
2133 246     response
2134 247 }
