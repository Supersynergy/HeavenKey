116 struct ApiError(StatusCode, &'static str);
117 type ApiResult<T> = Result<T, ApiError>;
118 impl IntoResponse for ApiError {
119     fn into_response(self) -> Response {
120         (self.0, Json(json!({"error":self.1}))).into_response()
121     }
122 }
123 fn internal(error: impl std::fmt::Debug) -> ApiError {
124     eprintln!("UAC internal error: {error:?}");
125     ApiError(StatusCode::INTERNAL_SERVER_ERROR, "internal_error")
126 }
127 fn forbidden(code: &'static str) -> ApiError {
128     ApiError(StatusCode::FORBIDDEN, code)
129 }
130 fn now() -> u64 {
131     SystemTime::now()
132         .duration_since(UNIX_EPOCH)
133         .map_or(0, |d| d.as_secs())
134 }
135 fn holder(key: &Passkey) -> [u8; 32] {
136     Sha256::digest(key.cred_id().as_ref()).into()
137 }
138 fn token_id(grant: &Signed<Grant>) -> ApiResult<String> {
139     grant_id(grant)
140         .map(|id| URL_SAFE_NO_PAD.encode(id))
141         .map_err(internal)
142 }
143 fn binding(invocation: &Option<Invocation>) -> ApiResult<[u8; 32]> {
144     Ok(Sha256::digest(serde_json::to_vec(invocation).map_err(internal)?).into())
145 }
146 
147 impl Inner {
148     fn prune(&mut self) {
149         let time = now();
150         self.registrations.retain(|_, v| v.expires > time);
151         self.authentications.retain(|_, v| v.expires > time);
152         self.sessions.retain(|_, v| v.expires > time);
153     }
154     fn user(&self, field: &str, value: &str) -> ApiResult<User> {
155         let query = match field {
156             "id" => "SELECT id,name,owner,passkey,counter FROM users WHERE id=?1",
157             _ => "SELECT id,name,owner,passkey,counter FROM users WHERE name=?1",
158         };
159         let row = self
160             .db
161             .query_row(query, [value], |row| {
162                 Ok((
163                     row.get::<_, String>(0)?,
164                     row.get::<_, String>(1)?,
165                     row.get::<_, bool>(2)?,
166                     row.get::<_, String>(3)?,
167                     row.get::<_, u32>(4)?,
168                 ))
169             })
170             .optional()
171             .map_err(internal)?;
172         let (id, name, owner, key, counter) =
173             row.ok_or(ApiError(StatusCode::NOT_FOUND, "user_not_found"))?;
174         Ok(User {
175             id,
176             name,
177             owner,
178             passkey: serde_json::from_str(&key).map_err(internal)?,
179             counter,
180         })
181     }
182     fn session_user(&mut self, headers: &HeaderMap) -> ApiResult<User> {
183         self.prune();
184         let token = headers
185             .get("authorization")
186             .and_then(|h| h.to_str().ok())
187             .and_then(|v| v.strip_prefix("Bearer "))
188             .ok_or(ApiError(StatusCode::UNAUTHORIZED, "session_required"))?;
189         let s = self
190             .sessions
191             .get(token)
192             .ok_or(ApiError(StatusCode::UNAUTHORIZED, "session_expired"))?;
193         self.user("id", &s.user_id)
194     }
195     fn grant_allowed(&self, user: &User, invocation: &Invocation) -> ApiResult<()> {
196         if invocation.arguments.len() > 8
197             || invocation
198                 .arguments
199                 .iter()
200                 .any(|(k, v)| k.len() > 64 || v.len() > 256)
201         {
202             return Err(forbidden("argument_limit"));
203         }
204         if invocation.resource != RESOURCE {
205             return Err(forbidden("resource_denied"));
206         }
207         let id = token_id(&invocation.grant)?;
208         let revoked = self
209             .db
210             .query_row("SELECT revoked FROM grants WHERE id=?1", [&id], |r| {
211                 r.get::<_, bool>(0)
212             })
213             .optional()
214             .map_err(internal)?
215             .ok_or(forbidden("unknown_grant"))?;
216         authorize_passkey_grant(
217             &invocation.grant,
218             &self.issuer.verifying_key().to_bytes(),
219             &holder(&user.passkey),
220             RESOURCE,
221             invocation.action,
222             now(),
223             revoked,
224         )
225         .map_err(|_| forbidden("grant_denied"))
226     }
227 }
228 
229 async fn origin_guard(State(app): State<App>, req: Request, next: Next) -> Response {
230     if req.headers().get("host").and_then(|h| h.to_str().ok()) != Some(&app.host) {
231         return forbidden("host_denied").into_response();
232     }
233     if req.method() != axum::http::Method::GET
234         && req.headers().get("origin").and_then(|h| h.to_str().ok()) != Some(&app.origin)
235     {
236         return forbidden("origin_denied").into_response();
237     }
238     let mut response = next.run(req).await;
239     let headers = response.headers_mut();
240     headers.insert("cache-control", "no-store".parse().expect("static header"));
241     headers.insert(
242         "x-content-type-options",
243         "nosniff".parse().expect("static header"),
244     );
245     headers.insert("content-security-policy", "default-src 'self'; script-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'".parse().expect("static header"));
246     response
247 }
248 
249 async fn register_start(
250     State(app): State<App>,
251     Json(input): Json<RegisterStart>,
252 ) -> ApiResult<Json<Value>> {
253     if !(3..=32).contains(&input.name.len())
254         || !input
255             .name
256             .chars()
257             .all(|c| c.is_ascii_alphanumeric() || c == '-')
258     {
259         return Err(ApiError(StatusCode::BAD_REQUEST, "invalid_name"));
260     }
261     let mut inner = app.inner.lock().map_err(internal)?;
262     inner.prune();
263     if inner.registrations.len() >= MAX_PENDING {
264         return Err(ApiError(StatusCode::TOO_MANY_REQUESTS, "ceremony_limit"));
265     }
266     let exists: bool = inner
267         .db
268         .query_row(
269             "SELECT EXISTS(SELECT 1 FROM users WHERE name=?1)",
270             [&input.name],
271             |r| r.get(0),
272         )
273         .map_err(internal)?;
274     if exists {
275         return Err(ApiError(StatusCode::CONFLICT, "user_exists"));
276     }
277     let user_id = Uuid::new_v4();
278     let (options, state) = inner
279         .webauthn
280         .start_passkey_registration(user_id, &input.name, &input.name, None)
281         .map_err(internal)?;
282     let request_id = Uuid::new_v4().to_string();
283     inner.registrations.insert(
284         request_id.clone(),
285         Registration {
286             name: input.name,
287             user_id,
288             state,
289             expires: now() + CEREMONY_TTL,
290         },
291     );
292     Ok(Json(json!({"request_id":request_id,"options":options})))
293 }
294 
295 async fn register_finish(
296     State(app): State<App>,
297     Json(input): Json<RegisterFinish>,
298 ) -> ApiResult<Json<Value>> {
299     let mut inner = app.inner.lock().map_err(internal)?;
300     inner.prune();
301     let pending = inner
302         .registrations
303         .remove(&input.request_id)
304         .ok_or(forbidden("ceremony_missing"))?;
305     let key = inner
306         .webauthn
307         .finish_passkey_registration(&input.credential, &pending.state)
308         .map_err(|_| ApiError(StatusCode::UNAUTHORIZED, "registration_invalid"))?;
309     let duplicate: bool = inner
310         .db
311         .query_row(
312             "SELECT EXISTS(SELECT 1 FROM users WHERE credential_id=?1)",
313             [URL_SAFE_NO_PAD.encode(key.cred_id().as_ref())],
314             |r| r.get(0),
315         )
316         .map_err(internal)?;
317     if duplicate {
318         return Err(ApiError(StatusCode::CONFLICT, "credential_exists"));
319     }
320     let owner: bool = inner
321         .db
322         .query_row("SELECT COUNT(*)=0 FROM users", [], |r| r.get(0))
323         .map_err(internal)?;
324     inner
325         .db
326         .execute(
327             "INSERT INTO users(id,name,owner,credential_id,passkey) VALUES(?1,?2,?3,?4,?5)",
328             params![
329                 pending.user_id.to_string(),
330                 pending.name,
331                 owner,
332                 URL_SAFE_NO_PAD.encode(key.cred_id().as_ref()),
333                 serde_json::to_string(&key).map_err(internal)?
334             ],
335         )
336         .map_err(|_| ApiError(StatusCode::CONFLICT, "registration_conflict"))?;
337     Ok(Json(
338         json!({"name":pending.name,"owner":owner,"registered":true}),
339     ))
340 }
341 
342 async fn auth_start(
343     State(app): State<App>,
344     Json(input): Json<AuthStart>,
345 ) -> ApiResult<Json<Value>> {
346     let mut inner = app.inner.lock().map_err(internal)?;
347     inner.prune();
348     if inner.authentications.len() >= MAX_PENDING {
349         return Err(ApiError(StatusCode::TOO_MANY_REQUESTS, "ceremony_limit"));
350     }
351     let user = inner.user("name", &input.name)?;
352     if let Some(invocation) = &input.invocation {
353         inner.grant_allowed(&user, invocation)?;
354     }
355     let (options, state) = inner
356         .webauthn
357         .start_passkey_authentication(std::slice::from_ref(&user.passkey))
358         .map_err(internal)?;
359     let request_id = Uuid::new_v4().to_string();
360     let bound = binding(&input.invocation)?;
361     inner.authentications.insert(
362         request_id.clone(),
363         Authentication {
364             user,
365             state,
366             invocation: input.invocation,
367             expires: now() + CEREMONY_TTL,
368         },
369     );
370     Ok(Json(
371         json!({"request_id":request_id,"options":options,"invocation_binding":URL_SAFE_NO_PAD.encode(bound)}),
372     ))
373 }
374 
375 async fn auth_finish(
376     State(app): State<App>,
377     Json(input): Json<AuthFinish>,
378 ) -> ApiResult<Json<Value>> {
379     let mut inner = app.inner.lock().map_err(internal)?;
380     inner.prune();
381     let mut pending = inner
382         .authentications
383         .remove(&input.request_id)
384         .ok_or(forbidden("ceremony_missing"))?;
385     if binding(&pending.invocation)? != binding(&input.invocation)? {
386         return Err(forbidden("invocation_changed"));
387     }
388     // Reload the current counter before accepting concurrent ceremonies.
389     let current = inner.user("id", &pending.user.id)?;
390     let result = inner
391         .webauthn
392         .finish_passkey_authentication(&input.credential, &pending.state)
393         .map_err(|_| ApiError(StatusCode::UNAUTHORIZED, "authentication_invalid"))?;
394     if !result.user_verified() {
395         return Err(ApiError(
396             StatusCode::UNAUTHORIZED,
397             "user_verification_required",
398         ));
399     }
400     if (result.counter() > 0 || current.counter > 0) && result.counter() <= current.counter {
401         return Err(ApiError(StatusCode::UNAUTHORIZED, "counter_not_increasing"));
402     }
403     pending.user.passkey = current.passkey;
404     if pending.user.passkey.update_credential(&result).is_none() {
405         return Err(ApiError(StatusCode::UNAUTHORIZED, "credential_mismatch"));
406     }
407     if let Some(invocation) = &pending.invocation {
408         inner.grant_allowed(&pending.user, invocation)?;
409     }
410     let key_json = serde_json::to_string(&pending.user.passkey).map_err(internal)?;
411     let tx = inner.db.transaction().map_err(internal)?;
412     tx.execute(
413         "UPDATE users SET passkey=?1,counter=?2 WHERE id=?3",
414         params![key_json, result.counter(), pending.user.id],
415     )
416     .map_err(internal)?;
417     if let Some(invocation) = &pending.invocation {
418         let id = token_id(&invocation.grant)?;
419         let inserted=tx.execute("INSERT INTO operations(id,grant_id,holder,created) SELECT ?1,?2,?3,?4 WHERE EXISTS(SELECT 1 FROM grants WHERE id=?2 AND revoked=0)",params![input.request_id,id,pending.user.id,i64::try_from(now()).map_err(internal)?]).map_err(internal)?;
420         if inserted != 1 {
421             return Err(forbidden("grant_revoked"));
422         }
423     }
424     tx.commit().map_err(internal)?;
425     if let Some(invocation) = pending.invocation {
426         Ok(Json(
427             json!({"authorized":true,"resource":invocation.resource,"action":invocation.action,"arguments":invocation.arguments,"operation":input.request_id,"data":"UAC example document — verified access"}),
428         ))
429     } else {
430         let session = Uuid::new_v4().to_string();
431         inner.sessions.insert(
432             session.clone(),
433             Session {
434                 user_id: pending.user.id,
435                 expires: now() + 300,
436             },
437         );
438         Ok(Json(
439             json!({"session":session,"name":pending.user.name,"owner":pending.user.owner}),
440         ))
441     }
442 }
443 
444 async fn create_grant(
445     State(app): State<App>,
446     headers: HeaderMap,
447     Json(input): Json<GrantCreate>,
448 ) -> ApiResult<Json<Value>> {
449     if !(1..=3600).contains(&input.ttl_seconds) {
450         return Err(ApiError(StatusCode::BAD_REQUEST, "invalid_expiry"));
451     }
452     let mut inner = app.inner.lock().map_err(internal)?;
453     let owner = inner.session_user(&headers)?;
454     if !owner.owner {
455         return Err(forbidden("owner_required"));
456     }
457     let guest = inner.user("name", &input.guest_name)?;
458     let time = now();
459     let grant = sign_grant(
460         &inner.issuer,
461         Grant {
462             issuer: inner.issuer.verifying_key().to_bytes(),
463             audience: holder(&guest.passkey),
464             resource: RESOURCE.into(),
465             actions: [Action::Read].into(),
466             not_before: time,
467             expires_at: time + input.ttl_seconds,
468             remaining_delegations: 0,
469             parent: None,
470         },
471     )
472     .map_err(internal)?;
473     let id = token_id(&grant)?;
474     inner
475         .db
476         .execute(
477             "INSERT OR IGNORE INTO grants(id,guest_id,token,revoked) VALUES(?1,?2,?3,0)",
478             params![
479                 id,
480                 guest.id,
481                 serde_json::to_string(&grant).map_err(internal)?
482             ],
483         )
484         .map_err(internal)?;
485     Ok(Json(json!({"id":id,"grant":grant,"guest":guest.name})))
486 }
487 
488 async fn revoke_grant(
489     State(app): State<App>,
490     headers: HeaderMap,
491     Json(input): Json<GrantRevoke>,
492 ) -> ApiResult<Json<Value>> {
493     let mut inner = app.inner.lock().map_err(internal)?;
494     if !inner.session_user(&headers)?.owner {
495         return Err(forbidden("owner_required"));
496     }
497     let n = inner
498         .db
499         .execute("UPDATE grants SET revoked=1 WHERE id=?1", [&input.id])
500         .map_err(internal)?;
501     if n == 0 {
502         return Err(ApiError(StatusCode::NOT_FOUND, "grant_not_found"));
503     }
504     Ok(Json(
505         json!({"id":input.id,"revoked":true,"confirmed_at":now()}),
506     ))
507 }
508 
509 async fn grants(State(app): State<App>, headers: HeaderMap) -> ApiResult<Json<Value>> {
510     let mut inner = app.inner.lock().map_err(internal)?;
511     let user = inner.session_user(&headers)?;
512     let mut stmt=inner.db.prepare("SELECT g.id,u.name,g.token,g.revoked FROM grants g JOIN users u ON u.id=g.guest_id WHERE ?1 OR g.guest_id=?2 ORDER BY g.rowid DESC LIMIT 100").map_err(internal)?;
513     let rows = stmt
514         .query_map(params![user.owner, user.id], |r| {
515             Ok((
516                 r.get::<_, String>(0)?,
517                 r.get::<_, String>(1)?,
518                 r.get::<_, String>(2)?,
519                 r.get::<_, bool>(3)?,
520             ))
521         })
522         .map_err(internal)?;
523     let mut out = Vec::new();
524     for row in rows {
525         let (id, name, token, revoked) = row.map_err(internal)?;
526         out.push(json!({"id":id,"guest":name,"grant":serde_json::from_str::<Value>(&token).map_err(internal)?,"revoked":revoked}));
527     }
528     Ok(Json(json!({"grants":out})))
529 }
