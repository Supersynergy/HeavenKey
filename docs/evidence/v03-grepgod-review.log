    1179     #[tokio::test]
    1180     async fn revoke_is_account_scoped_invalidates_sessions_and_preserves_last_key() {
    1181         let app = app();
    1182         let (alice, alice_id, bob, bob_id, token, other_token, bob_token) = {
    1183             let mut inner = app.inner.lock().expect("inner");
    1184             let (alice, alice_id) = add_user(&mut inner, "alice", false);
    1185             let (bob, bob_id) = add_user(&mut inner, "bob", false);
    1186             add_credential(&inner, &alice, "extra");
    1187             let token = add_session(&mut inner, &alice, &alice_id);
    1188             let other_token = add_session(&mut inner, &alice, "extra");
    1189             let bob_token = add_session(&mut inner, &bob, &bob_id);
    1190             add_enrollment(&mut inner, &alice, &token, &alice_id);
    1191             add_enrollment(&mut inner, &bob, &bob_token, &bob_id);
    1192             (alice, alice_id, bob, bob_id, token, other_token, bob_token)
    1193         };
    1194         let foreign = credential_revoke(
    1195             State(app.clone()),
    1196             headers(&token),
    1197             Json(CredentialRevoke { id: bob_id.clone() }),
    1198         )
    1199         .await
    1200         .expect_err("foreign key denied");
    1201         assert_eq!(
    1202             (foreign.0, foreign.1),
    1203             (StatusCode::NOT_FOUND, "credential_not_found")
    1204         );
    1205         let Json(revoked) = credential_revoke(
    1206             State(app.clone()),
    1207             headers(&token),
    1208             Json(CredentialRevoke {
    1209                 id: alice_id.clone(),
    1210             }),
    1211         )
    1212         .await
    1213         .expect("revoke initial");
    1214         assert_eq!(revoked["reauthentication_required"], true);
    1215         let surviving_token = {
    1216             let mut inner = app.inner.lock().expect("inner");
    1217             assert!(!inner.sessions.contains_key(&token));
    1218             assert!(!inner.sessions.contains_key(&other_token));
    1219             assert!(!inner.enrollments.contains_key(&alice));
    1220             assert!(inner.enrollments.contains_key(&bob));
    1221             assert!(inner.session_user(&headers(&bob_token)).is_ok());
    1222             assert!(
    1223                 !inner
    1224                     .credential_active(&alice, &alice_id)
    1225                     .expect("inactive original")
    1226             );
    1227             assert!(
    1228                 inner
    1229                     .credential_active(&bob, &bob_id)
    1230                     .expect("other account intact")
    1231             );
    1232             add_session(&mut inner, &alice, "extra")
    1233         };
    1234         let last = credential_revoke(
    1235             State(app.clone()),
    1236             headers(&surviving_token),
    1237             Json(CredentialRevoke { id: "extra".into() }),
    1238         )
    1239         .await
    1240         .expect_err("last key denied");
    1241         assert_eq!(
    1242             (last.0, last.1),
    1243             (StatusCode::CONFLICT, "last_credential_required")
    1244         );
    1245         let Json(list) = credentials(State(app), headers(&surviving_token))
    1246             .await
    1247             .expect("surviving session");
    1248         assert_eq!(list["current_credential_id"], "extra");
    1249         assert_eq!(list["credentials"].as_array().expect("keys").len(), 2);
    1250     }
