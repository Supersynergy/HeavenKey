    1028     fn add_user(inner: &mut Inner, name: &str, owner: bool) -> (String, String) {
    1029         let user_id = Uuid::new_v4().to_string();
    1030         let id = URL_SAFE_NO_PAD.encode(format!("synthetic-{name}"));
    1031         inner
    1032             .db
    1033             .execute(
    1034                 "INSERT INTO users(id,name,owner,credential_id,passkey) VALUES(?1,?2,?3,?4,'{}')",
    1035                 params![user_id, name, owner, id],
    1036             )
    1037             .expect("synthetic legacy user");
    1038         initialize_database(&mut inner.db).expect("migrate user");
    1039         (user_id, id)
    1040     }
