    1094     #[test]
    1095     fn legacy_migration_survives_restart_without_resurrecting_revoked_keys() {
    1096         let path =
    1097             std::env::temp_dir().join(format!("heavenkey-migration-{}.sqlite", Uuid::new_v4()));
    1098         let mut db = Connection::open(&path).expect("legacy file");
    1099         db.execute_batch("CREATE TABLE users(id TEXT PRIMARY KEY,name TEXT UNIQUE NOT NULL,owner INTEGER NOT NULL,credential_id TEXT UNIQUE NOT NULL,passkey TEXT NOT NULL,counter INTEGER NOT NULL DEFAULT 0); CREATE TABLE grants(id TEXT PRIMARY KEY,guest_id TEXT REFERENCES users(id),token TEXT NOT NULL,revoked INTEGER NOT NULL DEFAULT 0); CREATE TABLE operations(id TEXT PRIMARY KEY,grant_id TEXT REFERENCES grants(id),holder TEXT REFERENCES users(id),created INTEGER NOT NULL);").expect("actual legacy schema");
    1100         db.execute(
    1101             "INSERT INTO users VALUES('user','owner',1,'bGVnYWN5','legacy-key',44)",
    1102             [],
    1103         )
    1104         .expect("legacy user");
    1105         db.execute(
    1106             "INSERT INTO grants VALUES('grant','user','legacy-grant',0)",
    1107             [],
    1108         )
    1109         .expect("legacy grant");
    1110         db.execute(
    1111             "INSERT INTO operations VALUES('operation','grant','user',1)",
    1112             [],
    1113         )
    1114         .expect("legacy operation");
    1115         initialize_database(&mut db).expect("first upgrade");
    1116         let migrated: (String, u32, String, bool, i64) = db.query_row(
    1117             "SELECT passkey,counter,label,active,created FROM credentials WHERE id='bGVnYWN5' AND user_id='user'", [],
    1118             |r| Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?,r.get(4)?)),
    1119         ).expect("migrated key");
    1120         assert_eq!(
    1121             (&migrated.0, migrated.1, migrated.2.as_str(), migrated.3),
    1122             (&"legacy-key".to_owned(), 44, "Initial passkey", true)
    1123         );
    1124         assert!(migrated.4 > 0);
    1125         db.execute("UPDATE credentials SET passkey='updated-key',counter=55,label='Retired original',active=0 WHERE id='bGVnYWN5'", []).expect("revoke original");
    1126         db.execute(
    1127             "INSERT INTO credentials VALUES('extra','user','extra-key',3,'Surviving key',1,2)",
    1128             [],
    1129         )
    1130         .expect("extra key");
    1131         drop(db);
    1132         let mut db = Connection::open(&path).expect("reopen upgraded file");
    1133         initialize_database(&mut db).expect("repeat upgrade");
    1134         initialize_database(&mut db).expect("idempotent upgrade");
    1135         let original: (String, u32, String, bool, i64) = db
    1136             .query_row(
    1137                 "SELECT passkey,counter,label,active,created FROM credentials WHERE id='bGVnYWN5'",
    1138                 [],
    1139                 |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?, r.get(3)?, r.get(4)?)),
    1140             )
    1141             .expect("original metadata");
    1142         assert_eq!(
    1143             original,
    1144             (
    1145                 "updated-key".into(),
    1146                 55,
    1147                 "Retired original".into(),
    1148                 false,
    1149                 migrated.4
    1150             )
    1151         );
    1152         assert_eq!(
    1153             db.query_row("SELECT COUNT(*) FROM credentials", [], |r| r
    1154                 .get::<_, i64>(0))
    1155                 .expect("key count"),
    1156             2
    1157         );
    1158         assert_eq!(
    1159             db.query_row("SELECT credential_id FROM users", [], |r| r
    1160                 .get::<_, String>(0))
    1161                 .expect("subject alias"),
    1162             "bGVnYWN5"
    1163         );
    1164         assert_eq!(
    1165             db.query_row("SELECT token FROM grants", [], |r| r.get::<_, String>(0))
    1166                 .expect("existing grant"),
    1167             "legacy-grant"
    1168         );
    1169         assert_eq!(
    1170             db.query_row("SELECT COUNT(*) FROM operations", [], |r| r
    1171                 .get::<_, i64>(0))
    1172                 .expect("operation count"),
    1173             1
    1174         );
    1175         drop(db);
    1176         fs::remove_file(path).expect("remove synthetic file");
    1177     }
