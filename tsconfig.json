{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "apps/web/src/**/*.ts",
    "apps/extension/**/*.ts"
  ],
  "exclude": [
    "apps/web/src/**/*.test.ts",
    "apps/extension/**/*.test.ts"
  ]
}
