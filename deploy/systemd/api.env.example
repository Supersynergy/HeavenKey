# Install as /etc/heavenkey/api.env, root:heavenkey, mode 0640.
# Replace the reserved example domain in this file and the TLS proxy together.
# Identity is persistent: changing RP-ID invalidates existing passkey scope.
HEAVENKEY_PUBLIC_ORIGIN=https://lab.example.test
HEAVENKEY_RP_ID=lab.example.test
# Private UTF-8 document, 1..65536 bytes; never place it in the web root.
HEAVENKEY_DOCUMENT=/etc/heavenkey/private-document.txt
# Exactly 32 raw bytes, owner heavenkey, mode 0600; outside /var/lib/heavenkey.
# Create once with scripts/create_protection_key.py; never replace on restart.
HEAVENKEY_KEY_FILE=/etc/heavenkey/keys/protection.key
# Separate SQLCipher database key: 32 raw bytes, same private ownership/mode.
# Preserve both files; UAC_STORE_KEY (hex override) must not be set in this unit.
UAC_STORE_KEY_FILE=/etc/heavenkey/keys/store.key
